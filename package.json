{
  "name": "xunay-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "compiler3"
  ],
  "xunay": {
    "css": [
      "tw",
      "ui"
    ],
    "devtools": false,
    "minify": true,
    "sourcemap": false,
    "target": "es2020",
    "obfuscate": true,
    "cssHash": false,
    "filenameHash": "none",
    "pwa": {
      "name": "Xunay",
      "themeColor": "#1f6feb"
    },
    "compileMode": "hybrid",
    "_compileModeNote": "compiled | runtime | hybrid；文件内 // @runtime 或 // @compiled 可覆盖"
  },
  "scripts": {
    "build": "cd core && node build.js",
    "xuyc": "node bin/xuyc.js",
    "create": "node bin/create.js",
    "dev": "bash scripts/run-backend.sh",
    "site:dev": "node web/site/mode.mjs dev  && node scripts/build-site.mjs && node web/site/serve.mjs 8081",
    "site:prod": "node web/site/mode.mjs prod && node scripts/build-site.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:serve": "node web/site/serve.mjs 8081",
    "site:mode": "node web/site/mode.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md}\"",
    "ci": "npx eslint . --max-warnings 400 && npx prettier --check \"**/*.{js,mjs,json,md}\"",
    "verify": "node bin/xuyc.js build site/app.xuy --out dist && test -f dist/index.html && test -f dist/app.js",
    "test:backends": "node test/backends.test.js",
    "check:routes": "node bin/check-routes.js",
    "fix:routes": "node bin/check-routes.js --fix",
    "test:visual": "playwright test e2e/visual.spec.js",
    "test:a11y": "playwright test e2e/a11y.spec.js",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots"
  },
  "bin": {
    "xuyc": "./bin/xuyc.js",
    "xunay": "./bin/create.js"
  },
  "types": "./core/types/index.d.ts",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "javascript-obfuscator": "^5.9.0",
    "jsdom": "^30.1.2",
    "preact": "^11.0.1",
    "prettier": "^3.9.10"
  },
  "license": "MIT",
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/loaders": "^9.29.0",
    "@babylonjs/materials": "^9.29.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@hookform/resolvers": "^5.9.1",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^8.20.5",
    "acorn": "^8.18.0",
    "antd": "^6.6.6",
    "better-sqlite3": "^13.0.3",
    "classnames": "^2.5.1",
    "codemirror": "^6.0.2",
    "css-tree": "^3.2.1",
    "framer-motion": "^14.2.0",
    "howler": "^2.2.4",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2",
    "react-window": "^1.8.10",
    "recharts": "^3.10.1",
    "ssh2": "^1.17.0",
    "tonal": "^6.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
