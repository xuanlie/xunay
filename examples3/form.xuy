// title: 表单双向绑定
import { signal, mount } from 'xunay'

const name = signal('')
const email = signal('')

mount(() => div({ style: { padding: 24, maxWidth: '400px' } },
  h1(null, '注册'),
  div({ style: { marginBottom: '12px' } },
    label(null, '姓名'),
    input({
      value: () => name(),
      on: { input: e => name(e.target.value) },
      style: { display: 'block', width: '100%', padding: '6px' }
    })
  ),
  div({ style: { marginBottom: '12px' } },
    label(null, '邮箱'),
    input({
      value: () => email(),
      on: { input: e => email(e.target.value) },
      style: { display: 'block', width: '100%', padding: '6px' }
    })
  ),
  p(null, txt`你好,${name()}(${email()})`),
  button({ on: { click: () => { name(''); email('') } } }, '清空')
), '#app')
