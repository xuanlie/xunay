// title: 计数器
import { signal, mount } from 'xunay'

const count = signal(0)

mount(() => div({ style: { padding: 24, fontFamily: 'sans-serif' } },
  h1(null, 'XuNay 计数器'),
  button({ on: { click: () => count(v => v - 1) } }, '−'),
  span({ style: { fontSize: 24, margin: '0 16px' } }, () => String(count())),
  button({ on: { click: () => count(v => v + 1) } }, '+'),
  p(null, () => count() > 0 ? '正数' : count() < 0 ? '负数' : '零')
), '#app')
