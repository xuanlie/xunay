import { div } from 'xunay'
import { Btn, Badge, Text, Row, Col } from 'xunay/kit/ui'
import { count, doubled, inc, dec, reset } from '@/store/app.xuy'

export function Counter() {
  return div({ style: 'display:flex;flex-direction:column;align-items:center;gap:14px;padding:16px 0' },
    div({ style: 'font-size:64px;font-weight:800;line-height:1;background:linear-gradient(135deg,#6366f1,#06b6d4);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent' },
      () => count()
    ),
    Row({ gap: 2, align: 'center' },
      Text({ dim: true }, '翻倍：'),
      Badge({ text: '×2', tone: 'primary' }),
      Text({ dim: true }, () => doubled())
    ),
    Row({ gap: 2 },
      Btn({ onClick: dec }, '−'),
      Btn({ type: 'primary', onClick: inc }, '+'),
      Btn({ type: 'ghost', onClick: reset }, '重置')
    )
  )
}
