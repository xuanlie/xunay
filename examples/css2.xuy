const CSS = `
  /* 这是注释 */
  .card { background: #f0f0f0; padding: 24 32; margin: 8 16 8 16 }
  .title, .subtitle { color: #333; font-size: 24 }
  .btn { background: #4CAF50; color: white; padding: 16; font-size: 18 }
  .danger { background: #ff6600 }
`

app(() => div({ style: { padding: 24 } },
  div({ class: 'card' },
    h1({ class: 'title' }, '标题'),
    h2({ class: 'subtitle' }, '副标题')
  ),
  button({ class: 'btn' }, '正常'),
  button({ class: 'btn danger' }, '危险')
), '#app')