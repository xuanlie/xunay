scene({ bg: '#1a1a2e', autoRotate: true, camera: { distance: 10, fov: 45 } })

cube({ color: '#ff6600', size: 1.2, position: [-3, 0, 0], spin: { axis: [0, 1, 0], speed: 2 } })
sphere({ color: '#00ccff', size: 1.2, position: [-1, 0, 0], bob: { amp: 0.5, speed: 0.1 } })
cylinder({ color: '#ff00ff', size: 0.8, height: 1.5, position: [1, 0, 0], spin: { axis: [0, 1, 0], speed: -3 } })
cone({ color: '#ffff00', size: 1, height: 1.5, position: [3, 0, 0], rotate: [0, 0, 30] })
torus({ color: '#00ff88', radius: 0.8, tube: 0.3, position: [-2, 0, 2], spin: { axis: [1, 0, 0], speed: 1.5 } })
pyramid({ color: '#ff3366', size: 1, height: 1.5, position: [0, 0, 2], bob: { amp: 0.3, speed: 0.15 } })
plane({ color: '#444455', size: 8, position: [0, -1.8, 0] })
