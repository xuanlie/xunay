import { div, span, mount } from 'xunay'

const CSS = `
@keyframes spin {
  from { transform: rotate(0deg) }
  to   { transform: rotate(360deg) }
}
@keyframes pulse {
  0%   { opacity: 1 }
  50%  { opacity: 0.3 }
  100% { opacity: 1 }
}
.spin  { animation: spin 2s linear infinite; width: 80px; height: 80px; background: #1f6feb; }
.pulse { animation: pulse 1.5s ease-in-out infinite; width: 100px; height: 60px; background: #e33; }
`

mount(() => div(null,
  div({ class: 'spin' }, '旋转'),
  div({ class: 'pulse' }, '闪烁')
), '#app')
