app(() => div({ style: 'padding:20px;background:#ffffff' },
  span({ style: 'display:block;width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#eeeeee;padding:10px;font-size:18px' }, 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'),
  div({ style: 'margin-top:30px;width:200px;padding:20px;background:#2563eb;color:#ffffff;word-break:break-word;font-size:18px' }, 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB'),
  div({ style: 'margin-top:30px;width:200px;padding:20px;background:#dc2626;color:#ffffff;font-size:18px' }, 'CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC')
), '#app')
