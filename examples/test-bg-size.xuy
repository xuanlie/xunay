import { div, img, app } from 'xunay'

const CSS = `
.card { display: flex; flex-direction: column; gap: 8px; padding: 16px; background: #111; }
img { width: 200px; height: 120px; }
.cover { background-size: cover; }
.contain { background-size: contain; }
.fill { background-size: 100% 100%; }
`

app(() => div({ 'class': 'card' },
  img({ src: 'https://example.com/a.png', 'class': 'cover' }),
  img({ src: 'https://example.com/b.png', 'class': 'contain' }),
  img({ src: 'https://example.com/c.png', 'class': 'fill' })
), '#app')
