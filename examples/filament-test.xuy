sphere({  color: '#22ccff', size: 1.0, position: [0, 0, 0],    metalness: 0.8, roughness: 0.15 })
torus({   color: '#ffcc00', radius: 0.5, tube: 0.18, position: [1.6, 0, 0], metalness: 0.6, roughness: 0.25 })
