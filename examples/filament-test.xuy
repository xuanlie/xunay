scene({
  bg: '#0e1116',
  camera: { distance: 7, fov: 45 },
  lights: [
    { dir: [0.5, -1.0, -0.3], color: '#ffffff', intensity: 1.2 },
    { dir: [-0.5, -0.5, 0.5], color: '#88aaff', intensity: 0.4 }
  ]
})

