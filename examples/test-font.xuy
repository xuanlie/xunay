import { div, app } from 'xunay'

const CSS = `
@font-face { font-family: 'TestFont'; src: url('examples/fonts/TestFont.ttf'); }
.title { font-family: 'TestFont'; font-size: 42px; color: #ffffff; padding: 20px; background: #111; font-weight: bold; }
.sys { font-size: 42px; color: #00ff00; padding: 20px; }
`

app(() => div(null,
  div({ 'class': 'title' }, 'ABC abc 123 Impact'),
  div({ 'class': 'sys' }, 'ABC abc 123 Default')
), '#app')
