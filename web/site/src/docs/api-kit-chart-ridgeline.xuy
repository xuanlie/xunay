// kit: 山脊图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 山脊图"),
    P("多层 KDE（分类：分布）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/ridgeline'", "js"),
    H2("实时预览"),
    ChartDemo("ridgeline", {"height": 280, "overlap": 0.6, "groups": [{"label": "1月", "values": [40, 45, 48, 50, 52, 55, 58, 60]}, {"label": "2月", "values": [45, 50, 53, 55, 58, 62, 65, 68]}, {"label": "3月", "values": [50, 55, 58, 62, 65, 68, 72, 75]}, {"label": "4月", "values": [55, 60, 65, 68, 72, 75, 78, 82]}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '山脊图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
