// 条件渲染
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("条件渲染"),
    Warn("编译模式下 div() / span() 直接生成 DOM，不经过 vnode。本页提到的 vnode 是运行时模式（手写 render() 或 // @runtime 文件）的概念。"),
    P("show(cond, renderFn) 按条件挂载/卸载一段 DOM。cond 是真值时渲染，假值时移除——跟 v-if 一个意思。"),
    H2("基础用法"),
    Code("import { show, div } from 'xunay'\n\nshow(() => n() > 0, () => div(null, '正数'))\n// n() > 0 时显示 div，否则不显示", "xuy"),
    H2("两个参数"),
    Table(["参数","类型","作用"], [["cond","() => boolean","条件函数，会自动订阅依赖"],["renderFn","() => vnode","条件为真时渲染的内容"]]),
    H2("show vs 三目表达式"),
    Code("// 方式 A：show\nshow(() => open(), () => div(null, '内容'))\n\n// 方式 B：三目\n() => open() ? div(null, '内容') : null", "xuy"),
    Table(["","show","三目"], [["切换成本","卸载/挂载 scope","重建整块"],["清理","自动 dispose","随父重建"],["内存","切换时释放","随父重建释放"],["代码","稍长","短"],["适合","复杂子树","简短内容"]]),
    P("复杂子树用 show（切换干净）；简单的单行文本用三目更短。"),
    H2("show 的生命周期"),
    P("cond 变真 → 建 scope → 挂载 → onMount 触发；cond 变假 → onUnmount 触发 → dispose scope → 移除 DOM。"),
    Code("show(() => visible(), () => {\n  // 这个 div 每次显示都会重新创建\n  onMount(() => console.log('挂载'))\n  onUnmount(() => console.log('卸载'))\n  return div(null, '内容')\n})", "xuy"),
    H2("嵌套 show"),
    Code("show(() => loggedIn(), () =>\n  div(null,\n    '已登录',\n    show(() => hasPermission(), () => button(null, '管理'))\n  )\n)", "xuy"),
    H2("show 的简写"),
    Code("// 两种写法等价：\nshow(() => open(), () => div(null, 'x'))\n\n// 但注意：不要写成\nshow(open(), () => div(null, 'x'))   // ✗ 静态条件，不会更新", "xuy"),
    H2("多条件分支"),
    P("show 只能处理\"显示/隐藏\"。三个以上分支用函数返回不同 vnode："),
    Code("() => {\n  const s = status()\n  if (s === 'loading') return div(null, '加载中...')\n  if (s === 'error') return div(null, '出错了')\n  if (s === 'empty') return div(null, '无数据')\n  return ul(null, list(items, i => i.id, i => li(null, i.title)))\n}", "xuy"),
    H2("切换动画"),
    P("show 切换没有内置过渡。需要动画时用 trans："),
    Code("import { show, trans } from 'xunay'\n\nconst fade = trans(200)\n\nshow(() => open(), () => {\n  const el = div(null, '内容')\n  // 手动处理进入/离开\n  onMount(() => fade.enter(el))\n  onUnmount(() => fade.leave(el))\n  return el\n})", "xuy"),
    P("或者用 CSS transition——给 show 内的元素加类和过渡。"),
    H2("多个 show 组合"),
    Code("div(null,\n  show(() => loading(), () => div({ class: 'spinner' })),\n  show(() => error(), () => div({ class: 'error' }, () => error())),\n  show(() => !loading() && !error(), () => ul(null, ...))\n)", "xuy"),
    H2("性能"),
    Table(["切换","成本"], [["假→真","建 scope + 渲染 + appendChild"],["真→假","dispose scope + removeChild"],["频繁切换","每次都是新 DOM，注意内存"],["静态内容","成本可忽略"],["大子树","首渲染成本 = 树大小"]]),
    H2("常见陷阱"),
    H3("陷阱 1：条件传值而非函数"),
    Code("show(open(), () => div())          // ✗ open() 立即取值，条件不变\nshow(() => open(), () => div())    // ✓", "xuy"),
    H3("陷阱 2：cond 里的函数执行有副作用"),
    Code("show(() => {\n  fetch('/api')   // ✗ 每次 cond 重跑都发请求\n  return n() > 0\n}, () => div())", "xuy"),
    P("cond 应该纯读取——不要在里面发请求、改 signal、操作 DOM。"),
    H3("陷阱 3：和 v-if 一样的\"状态重置\""),
    Code("show(() => visible(), () => {\n  const count = signal(0)   // ✗ 隐藏再显示会重新创建，值回到 0\n  return div(null, () => count())\n})", "xuy"),
    P("show 每次切换都重建子树，内部 signal 会重置。需要保留状态时把 signal 提到外面。"),
    H2("完整示例：登录模态框"),
    Code("import { div, button, input, signal, show, mount } from 'xunay'\n\nconst modalOpen = signal(false)\nconst user = signal('')\nconst pass = signal('')\nconst error = signal('')\n\nasync function login() {\n  error('')\n  try {\n    const r = await fetch('/api/login', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ user: user(), pass: pass() })\n    })\n    if (!r.ok) throw new Error('HTTP ' + r.status)\n    modalOpen(false)\n  } catch (e) {\n    error(e.message)\n  }\n}\n\nmount(() => div(null,\n  button({ on: { click: () => modalOpen(true) } }, '登录'),\n  show(() => modalOpen(), () => div({ class: 'modal' },\n    div({ class: 'modal-body' },\n      input({ placeholder: '用户名', value: () => user(), on: { input: e => user(e.target.value) } }),\n      input({ type: 'password', placeholder: '密码', value: () => pass(), on: { input: e => pass(e.target.value) } }),\n      show(() => error(), () => div({ class: 'error' }, () => error())),\n      button({ on: { click: login } }, '提交'),\n      button({ on: { click: () => modalOpen(false) } }, '取消')\n    )\n  ))\n), '#app')", "xuy"),
  )
}
