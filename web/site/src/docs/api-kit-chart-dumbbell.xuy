// kit: 哑铃图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 哑铃图"),
    P("变化量（分类：时间）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/dumbbell'", "js"),
    H2("实时预览"),
    ChartDemo("dumbbell", {"rowHeight": 30, "padding": {"top": 16, "right": 70, "bottom": 20, "left": 70}, "showDelta": true, "data": [{"label": "A", "a": 30, "b": 75}, {"label": "B", "a": 50, "b": 85}, {"label": "C", "a": 40, "b": 65}, {"label": "D", "a": 60, "b": 90}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '哑铃图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
