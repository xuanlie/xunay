// 从 Vue 迁移
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("从 Vue 迁移"),
    P("Vue 3 的 setup + Composition API 和 xunay 非常像——都是信号驱动，都精确更新。主要区别是模板语法。"),
    H2("API 对照速查"),
    Table(["Vue 3","XuNay","备注"], [["ref(0)","signal(0)","读用 () 不是 .value"],["n.value","n()","读"],["n.value = 1","n(1)","写"],["computed(fn)","computed(fn)","一样"],["watch(fn)","effect(fn)","effect 自动追踪"],["watchEffect(fn)","effect(fn)","完全一样"],["onMounted(fn)","onMount(fn)","一样"],["onUnmounted(fn)","onUnmount(fn)","一样"],["provide/inject","ctx","更简单"],["v-if","show","函数式"],["v-for","list","函数式"],["v-model","手写或 model()","函数式"],["<template>","frag","函数式"]]),
    H2("第一个例子：计数器"),
    H2("关键区别 1：没有 .value"),
    Code("// Vue 3\nconst n = ref(0)\nconsole.log(n.value)   // 读\nn.value = 1            // 写\n\n// XuNay\nconst n = signal(0)\nconsole.log(n())       // 读\nn(1)                   // 写", "xuy"),
    H2("关键区别 2：没有模板"),
    Code("<!-- Vue 3 -->\n<ul>\n  <li v-for=\"t in todos\" :key=\"t.id\" :class=\"{ done: t.done }\">\n    {{ t.title }}\n  </li>\n</ul>\n\n// ===== XuNay =====\nul(null,\n  list(todos, t => t.id, t => li({ class: () => t.done ? 'done' : '' },\n    t.title\n  ))\n)", "xuy"),
    H2("关键区别 3：没有 ref 的 value"),
    Table(["","Vue 3","XuNay"], [["定义","ref(0)","signal(0)"],["读","n.value","n()"],["写","n.value = 1","n(1)"],["模板里自动解包","✓","手动 () =>"],["computed 读","c.value","c()"]]),
    H2("响应式原理对比"),
    Table(["","Vue 3","XuNay"], [["方式","Proxy 拦截","手动追踪"],["依赖收集","编译期 + 运行时","纯运行时"],["更新粒度","组件 + 节点","节点"],["嵌套对象","自动深层","需整体替换"],["数组方法","patch 过","原生"]]),
    H2("常见 Vue 模式的 XuNay 写法"),
    H3("ref 和 reactive"),
    Code("// Vue\nconst n = ref(0)\nconst user = reactive({ name: 'x', age: 0 })\n\n// XuNay：只有 signal 一种\nconst n = signal(0)\nconst user = signal({ name: 'x', age: 0 })\n// 更新整个对象\nuser(u => ({ ...u, age: 18 }))", "xuy"),
    H3("watch"),
    Code("// Vue\nwatch(n, (val, oldVal) => {\n  console.log('n 变:', val)\n})\n\n// XuNay\neffect(() => {\n  const val = n()\n  console.log('n 变:', val)\n})", "xuy"),
    H3("watchEffect"),
    Code("// Vue\nwatchEffect(() => {\n  console.log(a.value, b.value)\n})\n\n// XuNay：完全一样\neffect(() => {\n  console.log(a(), b())\n})", "xuy"),
    H3("生命周期"),
    Code("// Vue\nonMounted(() => { ... })\nonUnmounted(() => { ... })\n\n// XuNay：一样\nonMount(() => { ... })\nonUnmount(() => { ... })", "xuy"),
    H3("v-model"),
    Code("// Vue\n<input v-model=\"name\" />\n\n// XuNay：手写\ninput({\n  value: () => name(),\n  on: { input: e => name(e.target.value) }\n})\n// 或封装\nfunction model(sig) {\n  return {\n    value: () => sig(),\n    on: { input: e => sig(e.target.value) }\n  }\n}\ninput({ ...model(name) })", "xuy"),
    H3("v-if / v-else / v-else-if"),
    Code("// Vue\n<div v-if=\"status === 'loading'\">加载中</div>\n<div v-else-if=\"status === 'error'\">出错了</div>\n<div v-else>内容</div>\n\n// XuNay\n() => {\n  const s = status()\n  if (s === 'loading') return div(null, '加载中')\n  if (s === 'error') return div(null, '出错了')\n  return div(null, '内容')\n}", "xuy"),
    H3("v-for"),
    Code("// Vue\n<li v-for=\"(t, i) in todos\" :key=\"t.id\">\n  {{ i }}. {{ t.title }}\n</li>\n\n// XuNay\nlist(todos, t => t.id, (t, i) => li(null, i + '. ' + t.title))", "xuy"),
    H3("v-show vs v-if"),
    Code("// Vue：v-show 用 display 切换，v-if 挂载卸载\n<div v-show=\"open\">内容</div>\n<div v-if=\"open\">内容</div>\n\n// XuNay：show 类似 v-if（挂载卸载）\nshow(() => open(), () => div(null, '内容'))\n// v-show 效果用 style\n// div({ style: () => ({ display: open() ? 'block' : 'none' }) }, '内容')", "xuy"),
    H3("slots"),
    Code("// Vue\n<Card>\n  <template #title>标题</template>\n  <p>正文</p>\n</Card>\n\n// XuNay：直接传 children / 函数\nCard({\n  title: () => h2(null, '标题'),\n  default: () => p(null, '正文')\n})\n// 或\nCard({}, h2(null, '标题'), p(null, '正文'))", "xuy"),
    H3("computed 的 getter/setter"),
    Code("// Vue\nconst fullName = computed({\n  get: () => first.value + ' ' + last.value,\n  set: (v) => { [first.value, last.value] = v.split(' ') }\n})\n\n// XuNay：computed 只读，写用 signal\nconst fullName = computed(() => first() + ' ' + last())\n// 需要写时手动处理\nfunction setFullName(v) {\n  const [f, l] = v.split(' ')\n  batch(() => { first(f); last(l) })\n}", "xuy"),
    H2("provide / inject 对比"),
    Code("// Vue\n// 祖先\nprovide('theme', ref('light'))\n// 后代\nconst theme = inject('theme')\n\n// XuNay\n// 定义\nconst ThemeCtx = ctx('light')\n// 祖先\nThemeCtx.provide(theme(), () => Child())\n// 后代\nconst theme = ThemeCtx.get()", "xuy"),
    H2("迁移示例：Todo"),
    Code("<!-- Vue 3 版本 -->\n<script setup>\nimport { ref, computed } from 'vue'\nconst todos = ref([])\nconst filter = ref('all')\nconst filtered = computed(() => {\n  if (filter.value === 'active') return todos.value.filter(t => !t.done)\n  return todos.value\n})\nconst add = (title) => todos.value.push({ id: Date.now(), title, done: false })\n</script>\n\n<template>\n  <ul>\n    <li v-for=\"t in filtered\" :key=\"t.id\" :class=\"{ done: t.done }\">\n      <input type=\"checkbox\" v-model=\"t.done\" />\n      {{ t.title }}\n    </li>\n  </ul>\n</template>\n\n// ===== XuNay 版本 =====\nimport { signal, computed, ul, li, input, list } from 'xunay'\n\nfunction Todo() {\n  const todos = signal([])\n  const filter = signal('all')\n  const filtered = computed(() => {\n    if (filter() === 'active') return todos().filter(t => !t.done)\n    return todos()\n  })\n  const add = (title) => todos(list => [...list, { id: Date.now(), title, done: false }])\n\n  return ul(null,\n    list(filtered, t => t.id, t => li({ class: () => t.done ? 'done' : '' },\n      input({ type: 'checkbox', checked: () => t.done, on: { change: () => toggle(t.id) } }),\n      t.title\n    ))\n  )\n}", "xuy"),
    H2("Vue 的响应式陷阱 XuNay 没有"),
    Table(["陷阱","Vue 3","XuNay"], [["ref 忘记 .value","常见","n() 也容易忘，但报错明确"],["reactive 解构丢失响应","有","不存在"],["数组索引修改不触发","有","数组整体替换"],["新增属性不触发","有","对象整体替换"],["shallowRef 性能优化","需要","默认就是浅比较"]]),
    H2("迁移清单"),
    Table(["步骤","操作"], [["1","npm install xunay"],["2","把 .value 全部删掉"],["3","把 ref(0) 换成 signal(0)"],["4","把模板改成函数调用"],["5","把 v-for 换成 list"],["6","把 v-if 换成 show"],["7","把 watchEffect 换成 effect"],["8","把 onMounted 换成 onMount"],["9","删掉 <template> / <script setup>"],["10","用 .xuy 或直接写 JS"]]),
  )
}
