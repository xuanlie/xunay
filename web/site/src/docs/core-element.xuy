// 元素
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("元素"),
    Warn("本页讲的是运行时模式。默认的编译模式（compiler3）下，.xuy 文件里的 div() / span() 会在编译期直接生成 document.createElement，不经过本页描述的 vnode。只有手写 render(vnode) 或文件头写 // @runtime 才走 vnode 路径。"),
    P("XuNay 里的\"元素\"就是一段描述 DOM 的纯数据——类似 React 的 vnode，但更简单：没有 fiber，没有 key，没有 diff 需要的额外字段。"),
    H2("元素是数据，不是 DOM"),
    P("div(null, \"hello\") 不创建真实 DOM，它返回一个对象："),
    Code("{\n  [ELEMENT]: true,\n  type: 'div',\n  props: null,\n  children: ['hello']\n}", "js"),
    P("这个对象是纯数据，可以被缓存、比较、序列化。等 render 真正跑起来，才把它变成 document.createElement。"),
    H2("五种元素类型"),
    Table(["类型","标志","例子"], [["普通元素","[ELEMENT]","div() / span() / button()"],["Fragment","[FRAGMENT]","frag(a, b, c)"],["文本","字符串/数字","span(null, \"hi\") 里的 \"hi\""],["动态","函数","span(null, () => n())"],["条件","__xunay_show","show(cond, fn)"]]),
    H2("标签工厂"),
    P("core 内置了 30 多个标签工厂。每个都是 createElement(tag) 的简写。"),
    Code("import { div, span, p, a, button, input, form, label,\n  ul, ol, li, h1, h2, h3, h4, h5, h6,\n  table, thead, tbody, tr, td, th, img, br, hr,\n  pre, code, blockquote } from 'xunay'", "xuy"),
    H2("三个参数"),
    P("每个工厂函数接受 (props, ...children)："),
    Code("div(\n  { class: 'card', id: 'main' },   // props（可选）\n  h1(null, '标题'),                   // 子节点 1\n  p(null, '正文'),                     // 子节点 2\n  () => '动态内容'                     // 子节点 3（函数）\n)", "xuy"),
    H2("props 传 null"),
    P("没有 props 时传 null 或 {} 都可以，行为一致（框架内部都会转成 props 对象）。"),
    Code("div(null, 'hello')      // ✓ 推荐\ndiv({}, 'hello')        // ✓ 但多创建一个对象\ndiv('hello')            // ✗ 第一个参数必须是 props 或 null", "xuy"),
    H2("createElement 直接调用"),
    P("不在内置列表里的标签，用 createElement："),
    Code("import { createElement } from 'xunay'\n\ncreateElement('video', { src: '/movie.mp4', controls: true })\ncreateElement('canvas', { width: 800, height: 600 })\ncreateElement('custom-tag', null, 'hello')", "xuy"),
    H2("tag 高阶函数"),
    P("需要在多处用同一个自定义标签，用 tag 生成工厂："),
    Code("import { tag } from 'xunay'\n\nconst video = tag('video')\nconst canvas = tag('canvas')\nconst myTag = tag('my-custom-element')\n\nvideo({ src: '/a.mp4' })\ncanvas({ width: 100 })", "xuy"),
    H2("子节点的四种形态"),
    Code("div(null,\n  'plain string',              // 1. 静态文本\n  42,                          // 2. 数字\n  h1(null, 'nested'),          // 3. 嵌套元素\n  () => n()                    // 4. 动态函数\n)", "xuy"),
    P("前三种在 render 时立即处理，第四种会建立 effect——只有它会在 n 变化时重跑。"),
    H2("动态子节点的判定规则"),
    P("只要是函数，就当成\"动态子节点\"。函数返回什么决定怎么渲染："),
    Table(["函数返回","处理方式"], [["字符串/数字","建文本节点，只改 textContent"],["vnode","整块重建（简单但成本高）"],["列表对象","走 list 的 keyed diff"],["show 对象","走条件渲染"],["null / false","渲染成空文本"]]),
    H2("属性值也有静态/动态"),
    Code("div({\n  class: 'card',                 // 静态：直接 setAttribute\n  id: () => 'item-' + n(),      // 动态：绑 effect\n  disabled: () => n() > 10,     // 布尔自动处理\n  style: { color: 'red' }       // 对象自动 assign\n})", "xuy"),
    H2("Fragment"),
    P("需要返回多个并列节点时用 frag。它不产生真实的 DOM 节点（内部用一个 display:contents 的 span 占位）。"),
    Code("import { frag } from 'xunay'\n\nfrag(\n  h1(null, '标题'),\n  p(null, '正文')\n)\n// 等价于返回两个并列节点，不包一层 div", "xuy"),
    H2("性能"),
    Table(["操作","耗时"], [["div(null, \"x\") 创建 vnode","量级：百 ns"],["render 成 DOM","量级：微秒（DOM 主导）"],["更新文本节点","量级：微秒"],["更新属性","量级：微秒"]]),
    P("对比：React 创建一个 element 对象约 200ns，但 diff 整个子树要 10~100µs。xunay 没有 diff，创建成本类似，更新成本低一个量级。"),
    H2("常见陷阱"),
    H3("陷阱 1：把元素当 DOM 用"),
    Code("const el = div(null, 'hi')\nel.textContent          // ✗ undefined，它是纯数据\nel.className            // ✗ 同理\nel.type                 // ✓ 'div'（vnode 的字段）", "xuy"),
    P("需要真实 DOM 时用 ref 或 onMount 拿。"),
    H3("陷阱 2：children 里写对象"),
    Code("div(null, { foo: 1 })   // ✗ 对象会渲染成 [object Object]\ndiv(null, JSON.stringify({ foo: 1 }))   // ✓ 手动字符串化", "xuy"),
    H3("陷阱 3：忘记 null"),
    Code("div({ class: 'x' }, 'text')   // ✓ 有 props\ndiv(null, 'text')            // ✓ 无 props\ndiv('text')                  // ✗ 'text' 被当成 props", "xuy"),
    H2("完整示例：构建一个卡片组件"),
    Code("import { div, h1, p, span, img, button, signal, mount } from 'xunay'\n\nfunction Card({ title, desc, cover, onClose }) {\n  return div({ class: 'card' },\n    img({ class: 'cover', src: cover, alt: title }),\n    div({ class: 'body' },\n      h1(null, title),\n      p(null, desc),\n      div({ class: 'actions' },\n        button({ on: { click: onClose } }, '关闭')\n      )\n    )\n  )\n}\n\nmount(() => div(null,\n  Card({\n    title: 'XuNay',\n    desc: '极简前端框架',\n    cover: '/logo.png',\n    onClose: () => console.log('关闭')\n  })\n), '#app')", "xuy"),
    H2("下一步"),
    P("读 props 了解属性细节，或看 children 了解子节点处理。"),
  )
}
