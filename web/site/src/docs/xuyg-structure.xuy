// 项目结构
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("Xuyg · 项目结构"),
    H2("推荐目录"),
    Code("project/\n├── app.xuy               入口\n├── package.json          \"type\": \"module\" + xunay\n├── src/\n│   ├── data.xuy          数据（dt + 导出常量）\n│   ├── store.xuy         全局状态 + 函数\n│   ├── components/       组件（cpt）\n│   └── pages/            页面（pag，自动路由）\n└── dist/                 编译产物", "txt"),
    H2("路由规则"),
    Table(["文件","路由"], [["pages/home.xuy","/home"],["pages/user/index.xuy","/user"],["pages/[id].xuy","/:id"],["pag Detail(id)","参数 id 自动注入"]]),
    H2("app.xuy 入口模板"),
    Code("// app.xuy\nimport { mount } from 'xunay'\nimport { div } from 'xunay/tags'\nimport { route } from './src/store.xuy'\nimport { Home } from './src/pages/home.xuy'\nimport { Detail } from './src/pages/detail.xuy'\n\nmount(() => div(null, () => {\n  const r = route()\n  if (r === '/' || r === '') return Home()\n  if (r.startsWith('/p/')) return Detail(r.slice(3))\n  return Home()\n}), '#app')", "js"),
    Tip("mount 外层是函数只跑一次，内层 div(null, () => {...}) 是响应式 —— route 变了自动重渲。"),
  )
}
