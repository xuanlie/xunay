// kit: 冰柱图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 冰柱图"),
    P("层级矩形（分类：层级）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/icicle'", "js"),
    H2("实时预览"),
    ChartDemo("icicle", {"height": 280, "maxDepth": 3, "data": {"children": [{"label": "src", "children": [{"label": "components", "children": [{"label": "Button", "value": 12}, {"label": "Input", "value": 8}, {"label": "Modal", "value": 15}]}, {"label": "pages", "children": [{"label": "Home", "value": 18}, {"label": "About", "value": 8}]}]}, {"label": "public", "children": [{"label": "images", "value": 60}, {"label": "fonts", "value": 18}]}]}}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '冰柱图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
