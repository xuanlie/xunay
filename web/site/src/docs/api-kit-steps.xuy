// kit: Steps
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: Steps"),
    P("kit 里的 Steps 组件。"),
    H2("引入"),
    Code("import { Steps } from 'xunay/kit/nav'", "js"),
    H2("参数"),
    Table(["参数","类型","默认","说明"], [["current","——","——","可传 signal（响应式）"],["steps","——","——",""]]),
    H2("移动端"),
    P("横向滚动。"),
    H2("基础用法"),
    Code("import { Steps } from 'xunay/kit/nav'\n\nSteps({ current: mySignal })", "js"),
    H2("响应式"),
    P("这些参数可以直接传 signal，值变化时 DOM 会自动更新："),
    Code("import { signal } from 'xunay'\nimport { Steps } from 'xunay/kit/nav'\n\nconst v = signal(false)\n\nSteps({ current: v })", "js"),
    Tip("不要写成 current: v() —— 传函数给 render.js，让它挂 effect。"),
    Tip("完整组件清单见「Kit 组件 → Kit 组件 API」。"),
  )
}
