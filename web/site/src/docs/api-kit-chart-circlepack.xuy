// kit: 圆堆积
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 圆堆积"),
    P("嵌套圆（分类：层级）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/circlepack'", "js"),
    H2("实时预览"),
    ChartDemo("circlepack", {"height": 280, "maxDepth": 2, "data": {"children": [{"label": "中文", "value": 1200}, {"label": "英语", "value": 1000}, {"label": "西语", "value": 550}, {"label": "印地语", "value": 600}, {"label": "阿语", "value": 400}, {"label": "法语", "value": 300}]}}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '圆堆积' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
