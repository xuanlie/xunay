// kit: 饼/环/玫瑰
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 饼/环/玫瑰"),
    P("扇区弹出 / 中心文字（分类：基础）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/pie'", "js"),
    H2("实时预览"),
    ChartDemo("pie", {"height": 280, "shape": "donut", "data": [{"label": "直接访问", "value": 335}, {"label": "搜索引擎", "value": 548}, {"label": "邮件", "value": 234}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '饼/环/玫瑰' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
