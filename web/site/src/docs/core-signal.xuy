// signal
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("signal"),
    P("signal 是 XuNay 的核心。它是一个\"能通知订阅者的函数\"——读它返回当前值，写它修改值并通知所有读它的人。整个框架的响应式都建立在它上面。"),
    H2("一句话理解"),
    P("signal(0) 创建一个初始值为 0 的信号。当你调用 n() 时返回 0；调用 n(1) 时把值改为 1；如果某段代码在\"读\"这个信号的时候处于 effect 里，那么这段代码就成了订阅者，未来信号一变，它就会重跑。"),
    H2("基础用法"),
    Code("import { signal } from 'xunay'\n\n// 创建\nconst n = signal(0)\n\n// 读\nn()          // → 0\n\n// 写\nn(1)         // → 1\n\n// 函数式更新（基于旧值）\nn(v => v + 1)  // → 2\nn(v => v * 10) // → 20\n\n// 对象和数组\nconst user = signal({ name: 'xuan' })\nuser({ name: 'ling' })          // 整体替换\nuser(u => ({ ...u, age: 18 }))  // 函数式展开", "xuy"),
    H2("写时不变更等于不触发"),
    P("如果新旧值相等（Object.is），signal 会直接返回，不通知订阅者。这是自动的，不需要手动判断。"),
    Code("const n = signal(0)\nn(0)   // 等于旧值，不触发任何 effect\nn(0)   // 一样\nn(1)   // 变了，触发", "xuy"),
    H2("依赖自动收集"),
    P("signal 不需要你写依赖数组。当你读它的时候，它在运行时知道\"当前正在跑哪个 effect\"，并自动把自己加进那个 effect 的依赖列表。"),
    Code("import { signal, effect } from 'xunay'\n\nconst a = signal(1)\nconst b = signal(2)\n\neffect(() => {\n  // 这个 effect 只订阅了 a，没订阅 b\n  console.log('a =', a())\n  // b 没被读，所以 b 变化不会触发这里\n})\n\na(10)   // 触发，打印 a = 10\nb(20)   // 不触发", "xuy"),
    H2("在 JSX 风格里怎么用"),
    P("xunay 没有 JSX，但用法几乎一样——所有动态值都用函数包起来。signal 的读操作必须放在函数里，才会建立订阅关系。"),
    Code("import { div, span, button, signal } from 'xunay'\n\nconst n = signal(0)\n\ndiv(null,\n  button({ on: { click: () => n(v => v - 1) } }, '-'),\n  // 用 () => n() 才能订阅\n  span(null, () => 'n = ' + n()),\n  button({ on: { click: () => n(v => v + 1) } }, '+')\n)", "xuy"),
    Warn("不要写成 span(null, n()) —— 那样会立即取值，只显示 0，后续变化不会更新。永远用 () => n()。"),
    H2("常用模式"),
    H3("计数器"),
    Code("const count = signal(0)\ncount(v => v + 1)   // +1\ncount(v => v - 1)   // -1\ncount(0)             // 重置", "xuy"),
    H3("开关"),
    Code("const open = signal(false)\nopen(!open())       // 切换\nopen(true)           // 强制开\nopen(false)          // 强制关", "xuy"),
    H3("列表追加"),
    Code("const todos = signal([])\ntodos(list => [...list, { id: Date.now(), title: '新任务' }])", "xuy"),
    H3("列表删除"),
    Code("const todos = signal([])\ntodos(list => list.filter(t => t.id !== id))", "xuy"),
    H3("对象字段更新"),
    Code("const user = signal({ name: 'x', age: 0 })\nuser(u => ({ ...u, age: 18 }))", "xuy"),
    H2("订阅者计数与写入计数"),
    P("devtools 里会看到 \"Xs Yw\"，X 是订阅者数，Y 是写入次数。这两个数字是调试利器——如果某个 signal 有 100 个订阅者，每次变都会重跑 100 个 effect，就要警惕了。"),
    H2("常见陷阱"),
    H3("陷阱 1：在 effect 里写自己订阅的 signal"),
    Code("const n = signal(0)\neffect(() => {\n  n(n() + 1)   // ✗ 无限循环！\n})", "xuy"),
    P("effect 执行时读了 n，n 变化又触发 effect，effect 又写 n——死循环。解决办法：不要在同一个 effect 里读和写同一个 signal。"),
    H3("陷阱 2：深层对象修改不触发"),
    Code("const user = signal({ profile: { name: 'x' } })\nuser().profile.name = 'y'   // ✗ 不触发！对象引用没变\nuser(u => ({ ...u, profile: { ...u.profile, name: 'y' } }))  // ✓ 整体替换", "xuy"),
    P("signal 用的是 Object.is 比较，只有顶层引用变才触发。深层修改必须手动构造新对象。"),
    H3("陷阱 3：在事件回调外面读"),
    Code("button({ on: { click: () => console.log(n()) } })  // ✗ 事件回调不是 effect，读不会订阅\nspan(null, () => n())                            // ✓ 在 effect 里读，会订阅", "xuy"),
    H2("性能"),
    P("实测环境：Node.js 22 + V8，取多次中位数。不同机器差异 ±30%。"),
    Table(["操作","耗时","说明"], [["读（无订阅）","~3 ns","函数调用 + 属性访问"],["读（在 effect 里）","~15 ns","加了一次订阅检查"],["写（无订阅者）","~17 ns","Object.is 比较 + 赋值"],["写（1 个 effect）","~27 ns","listener 快路径直接触发"],["写（1 个 subscriber，多依赖）","~50-200 ns","走完整 propagate"],["创建","~50 ns","分配一个闭包"]]),
    P("这个量级的意思是：1000 次 signal 读加起来才 0.003 毫秒。相比之下，一次 DOM 写入就要 10~100 微秒。所以 signal 本身几乎不占时间，性能瓶颈在 DOM。"),
    H2("与 React / Vue 对比"),
    Table(["操作","XuNay","React","Vue 3"], [["创建","signal(0)","useState(0)","ref(0)"],["读","n()","n","n.value"],["写","n(1)","setN(1)","n.value = 1"],["函数式","n(v => v+1)","setN(v => v+1)","n.value++"],["写时比较","自动","自动","自动"],["依赖收集","运行时","手动数组","编译期"]]),
    H2("完整示例：一个小购物车"),
    Code("import { signal, computed, div, h1, button, span, ul, li, list, mount } from 'xunay'\n\nconst items = signal([\n  { id: 1, name: '键盘', price: 299, qty: 1 },\n  { id: 2, name: '鼠标', price: 99, qty: 2 }\n])\n\nconst total = computed(() =>\n  items().reduce((sum, i) => sum + i.price * i.qty, 0)\n)\n\nconst setQty = (id, qty) => {\n  items(list => list.map(i => i.id === id ? { ...i, qty } : i))\n}\n\nconst remove = id => {\n  items(list => list.filter(i => i.id !== id))\n}\n\nmount(() => div(null,\n  h1(null, '购物车'),\n  ul(null,\n    list(items, i => i.id, i => li(null,\n      span(null, i.name + ' · ¥' + i.price + ' × '),\n      button({ on: { click: () => setQty(i.id, i.qty - 1) } }, '-'),\n      span(null, ' ' + i.qty + ' '),\n      button({ on: { click: () => setQty(i.id, i.qty + 1) } }, '+'),\n      button({ on: { click: () => remove(i.id) } }, '删除')\n    ))\n  ),\n  div(null, '总计: ¥', () => total())\n), '#app')", "xuy"),
    H2("下一步"),
    P("读 computed 了解如何派生新值，或直接看 effect 理解订阅机制。"),
  )
}
