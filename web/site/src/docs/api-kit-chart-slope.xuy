// kit: 斜率图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 斜率图"),
    P("前后对比（分类：时间）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/slope'", "js"),
    H2("实时预览"),
    ChartDemo("slope", {"height": 280, "leftLabel": "2023", "rightLabel": "2024", "showDelta": true, "padding": {"top": 30, "right": 100, "bottom": 20, "left": 100}, "data": [{"label": "A", "a": 40, "b": 85}, {"label": "B", "a": 70, "b": 50}, {"label": "C", "a": 55, "b": 70}, {"label": "D", "a": 90, "b": 75}, {"label": "E", "a": 60, "b": 65}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '斜率图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
