// kit: 旭日图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 旭日图"),
    P("多层环（分类：层级）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/sunburst'", "js"),
    H2("实时预览"),
    ChartDemo("sunburst", {"height": 280, "innerRadius": 0.28, "showCenterLabel": false, "data": {"children": [{"label": "系统", "children": [{"label": "Windows", "value": 40}, {"label": "macOS", "value": 25}, {"label": "Linux", "value": 15}]}, {"label": "移动", "children": [{"label": "Android", "value": 45}, {"label": "iOS", "value": 35}]}]}}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '旭日图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
