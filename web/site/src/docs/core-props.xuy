// 属性
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("属性"),
    P("属性是传给元素的配置对象——class、id、style、事件、自定义 data-*。xunay 的属性语法和原生 HTML 接近，但多了动态绑定。"),
    H2("基础用法"),
    Code("div({\n  class: 'card',\n  id: 'main',\n  title: '悬停提示'\n}, '内容')", "xuy"),
    P("静态属性直接写值：编译模式下编译期生成 setAttribute 代码，运行时模式下 render 时执行。"),
    H2("动态属性"),
    P("想让属性跟 signal 变化，值写成函数。框架会自动建一个 effect，只在值变化时更新那一个属性。"),
    Code("div({\n  class: () => 'card ' + (open() ? 'open' : 'closed'),\n  id: () => 'item-' + n(),\n  disabled: () => n() > 10,\n  hidden: () => !visible()\n})", "xuy"),
    H2("属性自动分派"),
    P("xunay 不是什么都 setAttribute——某些 key 走特殊处理，跟原生 DOM 行为一致。"),
    Table(["属性","处理方式"], [["class / className","dom.className = 值"],["style（对象）","Object.assign(dom.style, 值)"],["style（字符串）","setAttribute"],["value","dom.value = 值"],["checked / disabled / selected","强转 !! 后赋值"],["html","dom.innerHTML = sanitize(值)（白名单）"],["on","事件绑定（不 setAttribute）"],["ref","获取真实 DOM 引用"],["其他","setAttribute(k, v)"]]),
    Warn("html 属性会经过内置 sanitize（白名单标签 + 危险 URL 拦截）。过滤器是白名单制，不支持的标签会被剥离。"),
    H2("class 的三种写法"),
    Code("// 1. 静态字符串\ndiv({ class: 'card' })\n\n// 2. 动态字符串\ndiv({ class: () => 'card ' + variant() })\n\n// 3. 对象（key 是类名，值决定加不加）\ndiv({ class: { card: true, active: () => n() > 0 } })", "xuy"),
    H2("style 的两种写法"),
    Code("// 1. 静态对象（对象在 props 创建时求值）\ndiv({ style: { color: 'red', fontSize: '14px' } })\n\n// 2. 动态函数（每次依赖变都重新 assign）\ndiv({ style: () => ({ color: n() > 0 ? 'red' : 'blue' }) })", "xuy"),
    H2("事件绑定"),
    P("所有事件放在 on 对象里。事件名是原生事件名（click、input、keydown...）。"),
    Code("button({\n  on: {\n    click: e => console.log('点击', e),\n    mouseenter: () => hover(true),\n    mouseleave: () => hover(false)\n  }\n}, '按钮')", "xuy"),
    H2("布尔属性"),
    P("disabled、checked、selected、hidden 这类布尔属性，xunay 自动强转。"),
    Code("input({ disabled: true })          // dom.disabled = true\ninput({ disabled: false })         // dom.disabled = false\ninput({ disabled: () => !valid() }) // 响应式", "xuy"),
    H2("data-* 和 aria-*"),
    Code("div({\n  'data-id': '42',\n  'data-type': 'user',\n  'aria-label': '关闭',\n  'aria-hidden': 'true'\n})", "xuy"),
    H2("移除属性"),
    P("传 null、undefined 或 false 时移除属性："),
    Code("div({ title: null })        // 移除 title\ndiv({ title: undefined })   // 移除\ndiv({ title: false })       // 移除（除布尔属性）", "xuy"),
    H2("动态属性和 effect 的关系"),
    P("一个元素上的多个动态属性会合并成一个 effect——只会重跑一次，不会每个属性各建一个。"),
    Code("div({\n  class: () => a() ? 'x' : 'y',\n  id: () => b(),\n  title: () => c()\n})\n// a 或 b 或 c 变化 → 只跑 1 个 effect → 更新 3 个属性", "xuy"),
    H2("ref 属性"),
    P("ref 用来拿真实 DOM 引用。传一个回调，元素挂载时被调用。"),
    Code("import { ref } from 'xunay'\n\nconst inputRef = ref()\n\ninput({\n  ref: el => { inputRef(el); el.focus() },\n  placeholder: '自动聚焦'\n})\n\n// 之后\ninputRef()   // 拿到真实 input 元素", "xuy"),
    H2("性能"),
    P("静态属性只 setAttribute 一次；动态属性每个元素建一个 effect，多个属性共享。"),
    Table(["情况","成本"], [["3 个静态属性","3 次 setAttribute"],["1 个动态属性","1 个 effect，值变化时 1 次赋值"],["3 个动态属性","1 个 effect，值变化时 3 次赋值"]]),
    H2("常见陷阱"),
    H3("陷阱 1：动态属性忘记加 ()"),
    Code("div({ class: () => open() ? 'open' : '' })   // ✓\ndiv({ class: open() ? 'open' : '' })          // ✗ 静态求值，不响应", "xuy"),
    H3("陷阱 2：on 里的函数写错"),
    Code("// ✓ 传函数引用\nbutton({ on: { click: handler } })\n\n// ✓ 传箭头函数\nbutton({ on: { click: () => n(v => v + 1) } })\n\n// ✗ 立即执行了\nbutton({ on: { click: handler() } })", "xuy"),
    H3("陷阱 3：html 属性"),
    Code("div({ html: '<b>你好</b>' })                  // ✓ 白名单过滤\ndiv({ html: userInput })                   // ⚠ 白名单外标签被剥离\ndiv({ html: () => escapeHtml(userInput) })  // ✓ 想显示纯文本用这个", "xuy"),
    H2("完整示例：可搜索输入框"),
    Code("import { div, input, ul, li, span, signal, list, show, mount } from 'xunay'\n\nfunction Search() {\n  const q = signal('')\n  const focus = signal(false)\n  const items = ['苹果', '香蕉', '橙子', '葡萄']\n  const results = () => items.filter(i => i.includes(q()))\n\n  return div({ class: () => 'search ' + (focus() ? 'focus' : '') },\n    input({\n      class: 'search-input',\n      placeholder: '搜索…',\n      value: () => q(),\n      on: {\n        input: e => q(e.target.value),\n        focus: () => focus(true),\n        blur: () => setTimeout(() => focus(false), 200),\n        keydown: e => { if (e.key === 'Escape') q('') }\n      }\n    }),\n    show(() => focus() && q(), () =>\n      ul({ class: 'results' },\n        list(results(), i => i, i => li(null, i))\n      )\n    )\n  )\n}\n\nmount(() => Search(), '#app')", "xuy"),
  )
}
