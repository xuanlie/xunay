// kit: 雷达图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 雷达图"),
    P("多边形 / 圆形网格（分类：基础）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/radar'", "js"),
    H2("实时预览"),
    ChartDemo("radar", {"height": 280, "indicators": ["性能", "易用", "功能", "生态", "文档", "稳定"], "max": 100, "series": [{"name": "A", "data": [90, 70, 85, 60, 75, 88]}, {"name": "B", "data": [70, 88, 65, 80, 60, 72]}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '雷达图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
