// kit: DatePicker
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: DatePicker"),
    P("kit 里的 DatePicker 组件。"),
    H2("引入"),
    Code("import { DatePicker } from 'xunay/kit/form'", "js"),
    H2("参数"),
    Table(["参数","类型","默认","说明"], [["disabled","——","false","禁用"],["error","——","——","错误信息"],["hint","——","——","提示"],["label","——","——","标签"],["onChange","——","——","回调"],["value","——","——","可传 signal（响应式）"]]),
    H2("移动端"),
    P("原生日期选择器。"),
    H2("基础用法"),
    Code("import { DatePicker } from 'xunay/kit/form'\n\nDatePicker({ value: mySignal, label: 'example', onChange: () => {} })", "js"),
    H2("响应式"),
    P("这些参数可以直接传 signal，值变化时 DOM 会自动更新："),
    Code("import { signal } from 'xunay'\nimport { DatePicker } from 'xunay/kit/form'\n\nconst v = signal('')\n\nDatePicker({ value: v })", "js"),
    Tip("不要写成 value: v() —— 传函数给 render.js，让它挂 effect。"),
    Tip("完整组件清单见「Kit 组件 → Kit 组件 API」。"),
  )
}
