// Kit 总览
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("Kit 总览"),
    P("XuNay Kit 内置两大可视化模块：36 种零依赖 SVG 图表 + 2001 个语义化 SVG 图标。全部原生 JS，支持 tree-shaking、深色/浅色主题、响应式。"),
    H2("引入方式"),
    Code("// 图表（单独引入，tree-shaking 最优）\nimport LineChart from 'xunay/kit/charts/line'\nimport SankeyChart from 'xunay/kit/charts/sankey'\n\n// 图表（全部）\nimport { LineChart, BarChart } from 'xunay/kit/charts'\n\n// 图标（命名导入）\nimport { IconHome, IconUser } from 'xunay/kit/icons'\n\n// 图标（动态）\nimport { Icon, iconNames } from 'xunay/kit/icons'", "js"),
    Tip("图表单独引入只打包该图表代码；图标命名导入后 tree-shaking 只留用到的。"),
    H2("图表（36 种）"),
    P("全部零依赖纯 SVG，支持深色/浅色主题、悬停交互、入场动画、响应式。"),
    H3("基础（6 个）"),
    ChartDemo("line", {"height": 260, "title": "月度趋势", "series": [{"name": "收入", "data": [{"label": "1月", "value": 120}, {"label": "2月", "value": 200}, {"label": "3月", "value": 150}, {"label": "4月", "value": 180}]}, {"name": "支出", "data": [{"label": "1月", "value": 80}, {"label": "2月", "value": 110}, {"label": "3月", "value": 90}, {"label": "4月", "value": 130}]}], "mode": "smooth"}),
    Table(["图表","说明","引入"], [["LineChart","折线图 · 平滑/阶梯/面积/回归","xunay/kit/charts/line"],["BarChart","柱状图 · 分组/堆叠/水平/负值","xunay/kit/charts/bar"],["AreaChart","面积图 · 堆叠/百分比/重叠","xunay/kit/charts/area"],["PieChart","饼/环/玫瑰 · 扇区弹出","xunay/kit/charts/pie"],["ScatterChart","散点图 · 回归/气泡/四象限","xunay/kit/charts/scatter"],["RadarChart","雷达图 · 多边形/圆形网格","xunay/kit/charts/radar"]]),
    H3("分布（6 个）"),
    ChartDemo("bar", {"height": 260, "title": "分组柱状", "series": [{"name": "A 组", "data": [{"label": "1月", "value": 50}, {"label": "2月", "value": 80}, {"label": "3月", "value": 60}]}, {"name": "B 组", "data": [{"label": "1月", "value": 30}, {"label": "2月", "value": 60}, {"label": "3月", "value": 90}]}], "layout": "grouped"}),
    Table(["图表","说明","引入"], [["BoxplotChart","箱线图 · 5 数概括 + IQR 异常值","xunay/kit/charts/boxplot"],["ViolinChart","小提琴图 · KDE 核密度 + 箱线","xunay/kit/charts/violin"],["RidgelineChart","山脊图 · 多层 KDE","xunay/kit/charts/ridgeline"],["HexbinChart","六边形分箱 · 双高斯","xunay/kit/charts/hexbin"],["CalendarHeatmap","日历热力 · GitHub 风格","xunay/kit/charts/calendar"],["WordcloudChart","词云 · 螺旋布局","xunay/kit/charts/wordcloud"]]),
    H3("层级（6 个）"),
    ChartDemo("treemap", {"height": 260, "title": "项目结构", "depth": 1, "data": [{"label": "技术", "value": 300, "children": [{"label": "前端", "value": 150}, {"label": "后端", "value": 150}]}, {"label": "产品", "value": 250, "children": [{"label": "设计", "value": 120}, {"label": "需求", "value": 130}]}, {"label": "运营", "value": 180}, {"label": "行政", "value": 100}]}),
    Table(["图表","说明","引入"], [["TreemapChart","矩形树图 · squarified","xunay/kit/charts/treemap"],["SunburstChart","旭日图 · 多层环","xunay/kit/charts/sunburst"],["CirclePackingChart","圆堆积 · 嵌套","xunay/kit/charts/circlepack"],["TreeChart","树形图 · 可折叠","xunay/kit/charts/tree"],["IcicleChart","冰柱图 · 层级矩形","xunay/kit/charts/icicle"],["MarimekkoChart","马赛克图 · 宽柱堆叠","xunay/kit/charts/marimekko"]]),
    H3("流向（6 个）"),
    ChartDemo("sankey", {"height": 260, "title": "流量流向", "padding": {"top": 10, "right": 100, "bottom": 10, "left": 10}, "nodes": [{"id": "a", "name": "来源"}, {"id": "b", "name": "Web"}, {"id": "c", "name": "App"}, {"id": "d", "name": "付费"}, {"id": "e", "name": "免费"}], "links": [{"source": "a", "target": "b", "value": 60}, {"source": "a", "target": "c", "value": 40}, {"source": "b", "target": "d", "value": 20}, {"source": "b", "target": "e", "value": 40}, {"source": "c", "target": "d", "value": 28}, {"source": "c", "target": "e", "value": 12}]}),
    Table(["图表","说明","引入"], [["SankeyChart","桑基图 · 贝塞尔带","xunay/kit/charts/sankey"],["ChordChart","和弦图 · 双向流","xunay/kit/charts/chord"],["ParallelChart","平行坐标 · 轴刷选","xunay/kit/charts/parallel"],["VoronoiChart","泰森多边形 · 最近点","xunay/kit/charts/voronoi"],["NetworkChart","关系图 · 力导向 + 拖拽","xunay/kit/charts/network"],["BumpChart","凹凸图 · 排名变化","xunay/kit/charts/bump"]]),
    H3("时间（6 个）"),
    ChartDemo("area", {"height": 260, "title": "流量趋势", "layout": "stacked", "series": [{"name": "移动端", "data": [{"label": "1月", "value": 100}, {"label": "2月", "value": 150}, {"label": "3月", "value": 120}, {"label": "4月", "value": 180}]}, {"name": "桌面端", "data": [{"label": "1月", "value": 80}, {"label": "2月", "value": 100}, {"label": "3月", "value": 90}, {"label": "4月", "value": 120}]}]}),
    Table(["图表","说明","引入"], [["CandlestickChart","K 线图 · 影线 + MA 均线","xunay/kit/charts/candlestick"],["GanttChart","甘特图 · 依赖箭头 + 今天线","xunay/kit/charts/gantt"],["WaterfallChart","瀑布图 · 涨跌连接","xunay/kit/charts/waterfall"],["SlopeChart","斜率图 · 前后对比","xunay/kit/charts/slope"],["DumbbellChart","哑铃图 · 变化量","xunay/kit/charts/dumbbell"],["LollipopChart","棒棒糖图 · 从基线延伸","xunay/kit/charts/lollipop"]]),
    H3("进阶（6 个）"),
    ChartDemo("pie", {"height": 260, "title": "占比分布", "shape": "donut", "data": [{"label": "直接访问", "value": 335}, {"label": "搜索引擎", "value": 548}, {"label": "邮件营销", "value": 234}, {"label": "联盟广告", "value": 135}]}),
    Table(["图表","说明","引入"], [["WaffleChart","华夫图 · 百分比格子","xunay/kit/charts/waffle"],["BulletChart","子弹图 · KPI vs 目标","xunay/kit/charts/bullet"],["StreamChart","流图 · 主题河流","xunay/kit/charts/stream"],["FunnelChart","漏斗图 · 转化率","xunay/kit/charts/funnel"],["GaugeChart","仪表盘 · 阈值分段","xunay/kit/charts/gauge"],["HeatmapChart","热力图 · 色阶渐变","xunay/kit/charts/heatmap"]]),
    H3("通用配置"),
    Table(["选项","类型","说明"], [["width","number | null","宽度，null 撑满容器"],["height","number","高度，默认 340"],["padding","number | object","内边距 {top,right,bottom,left}"],["title","string","标题"],["subtitle","string","副标题"],["theme","light | dark","主题"],["colors","string[]","调色板"],["legend","boolean","显示图例"],["tooltip","boolean","显示提示框"],["animation","object","{ duration, easing, stagger }"],["onHover","function","悬停回调"]]),
    H3("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据，自动重绘"],["setOptions(opts)","更新配置，自动重绘"],["render({ animate })","手动重绘"],["replay()","重播入场动画"],["destroy()","销毁，解绑监听，清空容器"]]),
    H3("示例"),
    Code("import LineChart from 'xunay/kit/charts/line'\n\nconst chart = new LineChart('#app', {\n  title: '月度收入',\n  height: 300,\n  data: [\n    { label: '一月', value: 120 },\n    { label: '二月', value: 200 },\n  ],\n})\n\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("图标（2001 个）"),
    P("全部语义化命名的 SVG 图标，纯字符串定义，零运行时。预览前 60 个："),
    IconGrid(60),
    H3("图标分类"),
    Table(["分类","数量","说明"], [["手绘核心","123","导航 / 操作 / 媒体 / 文件 / 通讯等常用语义"],["手绘扩展","约 500","乐器 / 化学 / 天文 / 医疗 / 海洋 / 动物 / 食物 / 服饰 / 棋牌 / 工具 / 建筑 / 交通 / 文具 / 家居 / 科技 / 军事 / 科学仪器 / 办公 / UI / 天气"],["程序化","约 700","多边形 / 星形 / 时钟 / 徽章 / 字母 / 数字 / 方向箭头 / 进度环 / 网格 / 虚线 / 波浪 / 圆点 / 同心圆 / 射线"],["领域补足","约 680","补充各领域详细图标"]]),
    H3("命名规则"),
    Table(["图标名","组件名"], [["home","IconHome"],["arrow-right","IconArrowRight"],["file-js","IconFileJs"],["chess-king","IconChessKing"],["badge-42","IconBadge42"]]),
    H3("组件 props"),
    Table(["属性","类型","默认","说明"], [["size","number","20","宽高（px）"],["color","string","currentColor","CSS 颜色"],["stroke","number","1.8","描边宽度"],["style","string","-","额外内联样式"],["class","string","-","额外类名"]]),
    H3("示例"),
    Code("import { IconHome, IconUser } from 'xunay/kit/icons'\n\nIconHome({ size: 24, color: '#3b82f6' })\nIconUser({ size: 32, stroke: 1.5 })\n\n// 动态渲染\nimport { Icon } from 'xunay/kit/icons'\nIcon({ name: 'settings', size: 20 })\n\n// 自定义注册\nimport { registerIcon } from 'xunay/kit/icons'\nregisterIcon('my-logo', '<path d=\"...\"/>')", "js"),
    H2("合计"),
    Table(["模块","数量","引入"], [["图表","36 种","xunay/kit/charts"],["图标","2001 个","xunay/kit/icons"]]),
    Tip("完整文档见 core/src/Kit/README.md，或 AI.spec 的 [API-CHARTS] / [API-ICONS] 段。"),
  )
}
