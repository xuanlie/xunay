// XuNay → Godot UI DSL
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("XuNay → Godot UI DSL"),
    P("用 JS 函数调用写 Godot UI, 编译成 .tscn 场景文件。写法比 Godot 原生 .tscn 简洁 10 倍, 且 AI 一次生成正确率远高于手写 GDScript Control 节点。"),
    H2("为什么需要"),
    Ul("Godot 原生 .tscn 是逐属性文本, 一个 320x110 的面板要写 15+ 行","AI 写 GDScript Control 节点易错: 锚点错位 / 容器嵌套乱 / 属性名记错","XuNay DSL 就是 JS 函数调用, AI 熟悉的语法, 一次成型","DSL 编译到原生 .tscn, 不引入运行时依赖, 不增包体"),
    H2("快速上手"),
    Code("// ui.xuy — 单个 JS 文件\\nimport { G, Panel, Label, Button, ProgressBar } from 'xunay/godot-ui'\\n\\nexport default G({ name: 'HUD', full: true },\\n  Panel({ name: 'Stats', tl: [16, 16], wh: [320, 110], bg: '#14141e' },\\n    Label({ name: 'Score', tl: [16, 12], wh: [280, 32],\\n      text: 'Score: 0', fs: 24, font_color: '#66ccff' }),\\n    ProgressBar({ name: 'Health', tl: [16, 78], wh: [280, 20],\\n      value: 75, max_value: 100 }),\\n  ),\\n  Button({ name: 'Pause', tr: [-120, 16], wh: [100, 44],\\n    text: '暂停', on: { pressed: 'on_pause' } }),\\n)", "js"),
    H2("编译"),
    Code("# 单次编译\\nnode core/bin/xunay-godot.js ui.xuy\\n# → ui.tscn\\n\\n# 指定输出\\nnode core/bin/xunay-godot.js ui.xuy -o godot/hud.tscn\\n\\n# watch 模式 (存盘即编译)\\nnode core/bin/xunay-godot.js watch ui.xuy -o godot/hud.tscn", "bash"),
    H2("核心设计"),
    Table(["特性","说明"], [["无新语法","就是 JS 函数调用, 和 XuNay element API 风格一致"],["锚点简写","tl/tr/bl/br/c/top/bottom/left/right/full + 9 种 wide 变体"],["位置+大小","[x, y] 相对锚点偏移, wh: [w, h] 自动算 offset_right/bottom"],["颜色","#rgb / #rrggbb / #rrggbbaa / [r,g,b,a] / {r,g,b,a}"],["属性透传","未知属性直接作为 key 输出, 原生路径逃生舱"],["信号","on: { pressed: \"fn\" }, from 自动指向当前节点"],["自动命名","未给 name 时自动生成 Label1 / Button2 等"]]),
    H2("覆盖范围"),
    Table(["类别","数量","示例"], [["Control 派生节点","40+","Panel/Label/Button/HSlider/TabContainer"],["容器","20+","HBoxContainer/VBoxContainer/GridContainer/SplitContainer"],["弹窗","7","Popup/AcceptDialog/ConfirmationDialog/FileDialog"],["2D/非 UI","12","Node2D/Sprite2D/Camera2D/Timer/AudioStreamPlayer"],["常用属性","200+","text/font_size/color/alignment/toggle_mode"],["主题覆盖","全部","theme_override_colors/font_color 等路径直通"]]),
    H2("锚点简写对照"),
    Table(["简写","含义"], [["tl","左上角 (top-left)"],["tr / bl / br","右上 / 左下 / 右下"],["c","居中"],["top / bottom / left / right","贴边拉伸 (横向或纵向)"],["full","全屏"],["center-top / top-wide","更多变体见源码 ANCHORS"]]),
    H2("示例：完整界面"),
    Code("import { G, Panel, Label, Button, HBoxContainer, VBoxContainer,\\n         TabContainer, ItemList, RichTextLabel, GridContainer,\\n         MarginContainer, ProgressBar } from 'xunay/godot-ui'\\n\\nexport default G({ name: 'MainUI', full: true },\\n  Panel({ name: 'TopBar', top: [0, 0], wh: [0, 64], bg: '#1a1a24' },\\n    HBoxContainer({ full: true, margin: [16, 12], sep: 12 },\\n      Label({ text: 'XuNay × Godot', fs: 22, font_color: '#66ccff' }),\\n      Label({ text: '', sf: 'expand' }),  // 撑开占位\\n      Button({ text: '设置', on: { pressed: 'on_settings' } }),\\n    ),\\n  ),\\n\\n  Panel({ name: 'Center', tl: [16, 80], wh: [640, 460] },\\n    TabContainer({ full: true },\\n      VBoxContainer({ margin: 12 },\\n        Label({ text: '物品列表' }),\\n        ItemList({ wh: [0, 200] }),\\n        RichTextLabel({ wh: [0, 200], bbcode: true,\\n          text: '[color=#66ccff]系统[/color] 已启动' }),\\n      ),\\n    ),\\n  ),\\n)", "js"),
    H2("与 Godot 桥接的关系"),
    Ul("DSL 编译的 .tscn 是静态 UI 骨架 (布局 / 控件 / 信号)","Godot 桥接 (xunay/godot) 负责运行时双向数据 (signal ↔ GDScript)","两者配合: UI 用 DSL 定义一次, 数值通过 signal 动态更新"),
    Code("// HUD.tscn 里的 Label 名叫 Score\\n// 挂载脚本里:\\n@onready var score_label: Label = $Stats/Score\\n\\nfunc _ready():\\n    XunayBridge.on(\"bind:update\", _on_bind)\\n\\nfunc _on_bind(p):\\n    if p.path == \"game.score\":\\n        score_label.text = \"Score: \" + str(p.value)", "gdscript"),
    H2("StyleBox 快捷语法"),
    P("圆角、边框、阴影用 style 属性一次写完, 自动生成 StyleBoxFlat 子资源。"),
    Code("Panel({\n  style: {\n    bg: '#14141ecc',\n    radius: 12,\n    border: { width: 1, color: '#333333' },\n    padding: 16,\n    shadow: { size: 8, color: '#00000088', offset: [0, 4] }\n  }\n})", "js"),
    Table(["节点","自动 slot"], [["Panel / PanelContainer","panel"],["Button","normal"],["LineEdit","normal"],["ProgressBar","fill"],["自定义","style.slot 显式指定"]]),
    H2("资源引用"),
    P("用 font() / texture() / scene() / audio() 等辅助函数引用外部资源, 自动生成 [ext_resource] 并挂到节点属性。"),
    Code("import { Label, TextureRect, font, texture } from 'xunay/godot-ui'\n\nLabel({\n  text: '标题',\n  font: font('res://fonts/title.ttf'),\n  fs: 32,\n})\n\nTextureRect({\n  texture: texture('res://art/logo.png'),\n  tl: [16, 16], wh: [128, 128],\n})", "js"),
    Table(["辅助函数","类型"], [["font(path)","FontFile"],["texture(path) / icon(path)","Texture2D"],["scene(path)","PackedScene"],["theme(path)","Theme"],["audio(path)","AudioStream"],["shader(path)","Shader"],["script(path)","Script"]]),
    H2("动画"),
    P("AnimationPlayer 的 animations 属性接收对象, 自动生成 [sub_resource type=\"Animation\"] + [sub_resource type=\"AnimationLibrary\"] + 引用。"),
    Code("import { AnimationPlayer } from 'xunay/godot-ui'\n\nAnimationPlayer({\n  name: 'Anim',\n  autoplay: 'pulse',\n  animations: {\n    pulse: {\n      length: 1.2,\n      loop: true,\n      tracks: [\n        { path: 'ScoreCard/ScoreValue', property: 'modulate',\n          keys: [[0, '#66ccff'], [0.6, '#ffcc66'], [1.2, '#66ccff']] },\n        { path: 'ScoreCard', property: 'scale',\n          keys: [[0, [1, 1]], [0.6, [1.03, 1.03]], [1.2, [1, 1]]] },\n      ],\n    },\n  },\n})", "js"),
    Ul("keys 数组每项 [时间, 值], 值类型自动推断 (number / Color / Vector2 / bool)","颜色字符串 #rrggbb 自动转 Color","[w, h] 数组自动转 Vector2","多个动画自动打包成 AnimationLibrary"),
    H2("实战陷阱"),
    H3("陷阱 1: Control 挂在 Node2D 下 anchor 失效"),
    P("Control 的 anchor 相对最近的 Control 父节点。挂在 Node2D 下 anchor 全失效, size 变 0。解决: 用 CanvasLayer 包裹 + 显式 set_anchors_and_offsets_preset(PRESET_FULL_RECT)。"),
    Code("var layer = CanvasLayer.new()\nadd_child(layer)\nvar hud = load('res://game-hud.tscn').instantiate()\nlayer.add_child(hud)\nhud.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)", "gdscript"),
    H3("陷阱 2: modulate 与 font_color 相乘"),
    P("modulate 是乘到最终像素上, font_color 是主题色。要改文字颜色, 用 add_theme_color_override, 别用 modulate。"),
    Code("# 错误: 绿字 × 橙色 modulate = 还是偏绿\nlabel.modulate = Color(1, 0.6, 0.3)\n\n# 正确\nlabel.add_theme_color_override(\"font_color\", Color(1, 0.6, 0.3))", "gdscript"),
    H3("陷阱 3: layout_mode + anchors_preset 必须一起给"),
    P("Godot 4 里 Control 用 anchor 时必须同时给 layout_mode=1 和 anchors_preset, 否则 anchor 被忽略。DSL 自动生成这两个属性。"),
    Tip("示例见 examples/godot-ui-demo/ (ui.xuy / full.xuy / animated.xuy)。"),
    Warn("DSL 只编译静态结构。动态显示 (分数变化 / 血条动画) 走 Godot 桥接。"),
  )
}
