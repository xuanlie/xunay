// Kit 组件 API
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("Kit 组件 API"),
    P("XuNay Kit 提供 106 个组件，分 17 个分组。支持全量引入或按分组引入。"),
    H2("引入方式"),
    Code("// 全量\nimport { Btn, Input } from 'xunay/kit/ui'\n\n// 分组（推荐，体积更小）\nimport { Btn, Card } from 'xunay/kit/ui'\nimport { Input } from 'xunay/kit/ui'\nimport { BarChart } from 'xunay/kit/charts'", "js"),
    Tip("按分组引入可大幅减少打包体积：基础约 1 KB，表单 2.9 KB，图表 1.8 KB。全量 29.58 KB。"),
    H2("基础（9 个）"),
    Table(["组件","引入"], [["Btn","xunay/kit/ui"],["Row","xunay/kit/ui"],["Col","xunay/kit/ui"],["Text","xunay/kit/ui"],["Card","xunay/kit/ui"],["Divider","xunay/kit/ui"],["Space","xunay/kit/ui"],["Tag","xunay/kit/ui"],["Badge","xunay/kit/ui"]]),
    H2("表单（13 个）"),
    Table(["组件","引入"], [["Input","xunay/kit/ui"],["Textarea","xunay/kit/ui"],["Select","xunay/kit/ui"],["Checkbox","xunay/kit/ui"],["Radio","xunay/kit/ui"],["Switch","xunay/kit/ui"],["NumberInput","xunay/kit/ui"],["DatePicker","xunay/kit/ui"],["TimePicker","xunay/kit/ui"],["SearchInput","xunay/kit/ui"],["PasswordStrength","xunay/kit/ui"],["Rate","xunay/kit/ui"],["useForm","xunay/kit/ui"]]),
    H2("表单扩展（5 个）"),
    Table(["组件","引入"], [["ColorPicker","xunay/kit/ui"],["Slider","xunay/kit/ui"],["Mentions","xunay/kit/ui"],["Transfer","xunay/kit/ui"],["Cascader","xunay/kit/ui"]]),
    H2("展示（13 个）"),
    Table(["组件","引入"], [["Alert","xunay/kit/ui"],["Modal","xunay/kit/ui"],["Spinner","xunay/kit/ui"],["Empty","xunay/kit/ui"],["Progress","xunay/kit/ui"],["Avatar","xunay/kit/ui"],["Result","xunay/kit/ui"],["Skeleton","xunay/kit/ui"],["Count","xunay/kit/ui"],["Stat","xunay/kit/ui"],["Descriptions","xunay/kit/ui"],["ItemCard","xunay/kit/ui"],["QRCode","xunay/kit/ui"]]),
    H2("展示扩展（8 个）"),
    Table(["组件","引入"], [["Typography","xunay/kit/ui"],["Comment","xunay/kit/ui"],["Watermark","xunay/kit/ui"],["Ribbon","xunay/kit/ui"],["Code","xunay/kit/ui"],["Keyboard","xunay/kit/ui"],["Highlight","xunay/kit/ui"],["Ellipsis","xunay/kit/ui"]]),
    H2("导航（5 个）"),
    Table(["组件","引入"], [["Tabs","xunay/kit/ui"],["Breadcrumb","xunay/kit/ui"],["Pagination","xunay/kit/ui"],["Steps","xunay/kit/ui"],["Accordion","xunay/kit/ui"]]),
    H2("导航扩展（4 个）"),
    Table(["组件","引入"], [["Menu","xunay/kit/ui"],["Anchor","xunay/kit/ui"],["BackTop","xunay/kit/ui"],["Collapse","xunay/kit/ui"]]),
    H2("数据（7 个）"),
    Table(["组件","引入"], [["Table","xunay/kit/ui"],["List","xunay/kit/ui"],["Timeline","xunay/kit/ui"],["Tree","xunay/kit/ui"],["TreeSelect","xunay/kit/ui"],["Calendar","xunay/kit/ui"],["SplitPane","xunay/kit/ui"]]),
    H2("数据扩展（6 个）"),
    Table(["组件","引入"], [["Carousel","xunay/kit/ui"],["Image","xunay/kit/ui"],["VirtualTable","xunay/kit/ui"],["Kanban","xunay/kit/ui"],["Gantt","xunay/kit/ui"],["QRScanner","xunay/kit/ui"]]),
    H2("浮层（6 个）"),
    Table(["组件","引入"], [["Tooltip","xunay/kit/ui"],["Popover","xunay/kit/ui"],["Dropdown","xunay/kit/ui"],["Drawer","xunay/kit/ui"],["Popconfirm","xunay/kit/ui"],["Tour","xunay/kit/ui"]]),
    H2("布局（4 个）"),
    Table(["组件","引入"], [["Layout","xunay/kit/ui"],["Grid","xunay/kit/ui"],["Flex","xunay/kit/ui"],["Affix","xunay/kit/ui"]]),
    H2("上传（2 个）"),
    Table(["组件","引入"], [["DragUpload","xunay/kit/ui"],["ImageUpload","xunay/kit/ui"]]),
    H2("文件（4 个）"),
    Table(["组件","引入"], [["Upload","xunay/kit/ui"],["FileList","xunay/kit/ui"],["Dropzone","xunay/kit/ui"],["FilePreview","xunay/kit/ui"]]),
    H2("编辑器（5 个）"),
    Table(["组件","引入"], [["CodeEditor","xunay/kit/ui"],["RichText","xunay/kit/ui"],["CopyButton","xunay/kit/ui"],["useHotkey","xunay/kit/ui"],["SplitButton","xunay/kit/ui"]]),
    H2("编辑器扩展（6 个）"),
    Table(["组件","引入"], [["Markdown","xunay/kit/ui"],["JSONViewer","xunay/kit/ui"],["DiffViewer","xunay/kit/ui"],["Terminal","xunay/kit/ui"],["CommandPalette","xunay/kit/ui"],["ContextMenu","xunay/kit/ui"]]),
    H2("图表（4 个）"),
    Table(["组件","引入"], [["BarChart","xunay/kit/charts"],["LineChart","xunay/kit/charts"],["PieChart","xunay/kit/charts"],["Sparkline","xunay/kit/charts"]]),
    H2("虚拟滚动（3 个）"),
    Table(["组件","引入"], [["VirtualList","xunay/kit/ui"],["Sortable","xunay/kit/ui"],["InfiniteList","xunay/kit/ui"]]),
