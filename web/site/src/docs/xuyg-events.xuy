// 事件系统
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("Xuyg · 事件"),
    H2("事件语法"),
    Table(["写法","展开"], [["@click: fn","on: { click: fn }"],["@click.stop: fn","e.stopPropagation() 后调 fn"],["@click.prevent: fn","e.preventDefault()"],["@click.stop.prevent: fn","两个都加"],["@keydown: fn","on: { keydown: fn }"],["@focus / @blur / @input / @change","对应原生事件"],["onClick: fn","on: { click: fn }"]]),
    H2("示例"),
    Code("div({ class: 'goods', '@click.stop': () => addCart(g) }, '加入购物车')\n\ndiv({ class: 'btn', onClick: () => go('/') }, 'ShopX')", "js"),
    H2("合并 on 键"),
    P("同一对象里的多个 @xxx 会自动合并成一个 on: {...}，不会冲突。"),
    Code("input({\n  vmodel: kw,\n  '@focus': () => kwFocus(true),\n  '@blur': () => kwFocus(false)\n})\n\n// 编译成\ninput({\n  value: () => kw(),\n  on: {\n    focus: () => kwFocus(true),\n    blur: () => kwFocus(false),\n    input: (e) => kw(e.target.value)\n  }\n})", "js"),
  )
}
