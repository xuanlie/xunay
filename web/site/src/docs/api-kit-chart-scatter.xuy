// kit: 散点图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 散点图"),
    P("回归 / 气泡 / 四象限（分类：基础）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/scatter'", "js"),
    H2("实时预览"),
    ChartDemo("scatter", {"height": 280, "showRegression": true, "showR2": false, "data": [{"x": 10, "y": 25}, {"x": 22, "y": 38}, {"x": 35, "y": 42}, {"x": 48, "y": 55}, {"x": 60, "y": 48}, {"x": 72, "y": 68}, {"x": 85, "y": 72}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '散点图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
