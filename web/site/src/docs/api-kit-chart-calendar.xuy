// kit: 日历热力
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 日历热力"),
    P("GitHub 风格（分类：分布）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/calendar'", "js"),
    H2("实时预览"),
    ChartDemo("calendar", {"height": 280, "cellSize": 10, "showLegend": false, "data": [{"date": "2026-01-15", "value": 5}, {"date": "2026-02-20", "value": 12}, {"date": "2026-03-10", "value": 8}, {"date": "2026-04-05", "value": 15}, {"date": "2026-05-18", "value": 20}, {"date": "2026-06-22", "value": 3}, {"date": "2026-07-08", "value": 18}, {"date": "2026-08-14", "value": 25}, {"date": "2026-09-03", "value": 10}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '日历热力' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
