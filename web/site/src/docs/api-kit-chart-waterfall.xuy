// kit: 瀑布图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 瀑布图"),
    P("涨跌连接（分类：时间）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/waterfall'", "js"),
    H2("实时预览"),
    ChartDemo("waterfall", {"height": 280, "showValue": true, "showConnector": true, "data": [{"label": "期初", "value": 400, "type": "total"}, {"label": "营收", "value": 200, "type": "increase"}, {"label": "成本", "value": -120, "type": "decrease"}, {"label": "营销", "value": -60, "type": "decrease"}, {"label": "期末", "value": 420, "type": "total"}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '瀑布图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
