// kit: 小提琴图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 小提琴图"),
    P("KDE 核密度 + 箱线（分类：分布）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/violin'", "js"),
    H2("实时预览"),
    ChartDemo("violin", {"height": 280, "groups": [{"label": "A", "values": [60, 65, 68, 70, 72, 75, 78, 80, 82, 85, 88, 90, 92]}, {"label": "B", "values": [55, 60, 65, 70, 75, 80, 85, 88, 90, 92, 95]}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '小提琴图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
