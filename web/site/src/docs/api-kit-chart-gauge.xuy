// kit: 仪表盘
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 仪表盘"),
    P("阈值分段（分类：进阶）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/gauge'", "js"),
    H2("实时预览"),
    ChartDemo("gauge", {"height": 240, "value": 72, "min": 0, "max": 100, "unit": "%", "valueLabel": "CPU", "sweepAngle": 270, "startAngle": 135, "thresholds": [{"to": 60, "color": "#10b981"}, {"to": 80, "color": "#f59e0b"}, {"to": 100, "color": "#ef4444"}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '仪表盘' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
