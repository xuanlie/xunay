// kit: 六边形分箱
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 六边形分箱"),
    P("双高斯分布（分类：分布）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/hexbin'", "js"),
    H2("实时预览"),
    ChartDemo("hexbin", {"height": 280, "bins": 14, "data": [{"x": 10, "y": 20}, {"x": 15, "y": 25}, {"x": 20, "y": 22}, {"x": 25, "y": 30}, {"x": 30, "y": 28}, {"x": 35, "y": 35}, {"x": 40, "y": 32}, {"x": 45, "y": 40}, {"x": 50, "y": 38}, {"x": 55, "y": 45}, {"x": 60, "y": 42}, {"x": 65, "y": 50}, {"x": 70, "y": 48}, {"x": 75, "y": 55}, {"x": 80, "y": 52}, {"x": 22, "y": 38}, {"x": 32, "y": 44}, {"x": 42, "y": 48}, {"x": 52, "y": 52}, {"x": 62, "y": 58}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '六边形分箱' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
