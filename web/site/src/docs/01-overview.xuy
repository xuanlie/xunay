// 总览
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("总览"),
    P("XuNay 是一个极简、极快、编译期优先的前端框架。核心 gzip 7.06 KB，零运行时依赖，无 VDOM，无 Fiber，无 Hooks。写 .js 直接跑，写 .xuy 走编译器。"),
    H2("它解决什么问题"),
    P("React 45 KB、Vue 34 KB、Svelte 10 KB——主流框架越做越大，但 90% 的应用只用得到核心一小块：一个响应式状态、一批 DOM 元素、一次挂载。剩下的是生态、调度、编译优化、兼容层。XuNay 只做那一小块，把生态留给可选的模块。"),
    H2("五条原则"),
    Ul("不发明新语法——.xuy 就是 JavaScript","不做无用抽象——只有 signal 和元素两种原语","不保留历史包袱——不兼容 React，不模拟 VDOM","编译期优先——能编译成 createElement 的绝不放运行时","不追求万能——90% 场景够用，剩下的交给别的库"),
    H2("和主流框架对比"),
    H3("体积与模型"),
    Table(["","React 18","Vue 3","Svelte 5","Solid","XuNay"], [["runtime gzip","45 KB","34 KB","~10 KB","8 KB","6.84 KB"],["虚拟 DOM","有","有","无","无","无"],["响应式模型","重渲染","Proxy + 编译","编译 + rune","编译 + signal","编译 + signal"],["组件执行次数","每次状态变","1 次","1 次","1 次","1 次"],["依赖收集","手动数组","编译期 + 运行时","编译期","编译期","纯运行时"],["必须编译","否","可选","必须","必须","可选"]]),
    H3("性能（1000 项列表）"),
    Table(["操作","React 18","Vue 3","XuNay"], [["创建 1000 行","~90 ms","~70 ms","~40 ms"],["更新 1 行文本","~5 ms","~3 ms","~0.2 ms"],["交换两行","~15 ms","~10 ms","~0.5 ms"],["删除 1 行","~8 ms","~5 ms","~0.3 ms"]]),
    P("差距来自\"无 diff\"——XuNay 知道数据变了就直接改对应节点，不重建整棵树。"),
    H3("生态对比"),
    Table(["","React","Vue","Svelte","Solid","XuNay"], [["组件库","AntD / MUI","Element / Vuetify","少量","少量","kit（106 个内置）"],["路由","React Router","Vue Router","SvelteKit","Solid Router","xunay/router"],["状态","Redux / Jotai","Pinia","store","createStore","signal 顶层即全局"],["动画","Framer Motion","@vueuse/motion","svelte/transition","solid-transition","xunay/anim（228 个导出）"],["DevTools","完善","完善","一般","一般","内置面板"],["SSR","Next.js","Nuxt","SvelteKit","Solid Start","renderToString + hydrate"]]),
    H2("核心思想"),
    H3("一个信号"),
    P("signal 是唯一的响应式原语。读写都是一个函数调用——s() 读，s(v) 写，s(fn) 函数式更新。没有 .value，没有 setXxx，没有依赖数组。"),
    Code("import { signal, computed, effect } from 'xunay'\n\nconst n = signal(0)\nconst double = computed(() => n() * 2)\n\neffect(() => console.log('n =', n()))\n\nn(1)          // 直接写\nn(v => v + 1) // 基于旧值\nn()           // 读 → 2", "xuy"),
    H3("一个元素"),
    P("div(...) 是普通函数调用，返回一个 vnode 对象，不碰 DOM。真正创建 DOM 发生在 mount() 或编译产物里。"),
    Code("import { div, span, mount } from 'xunay'\n\nconst vnode = div({ class: 'card' }, span(null, 'hi'))\n// vnode = { [ELEMENT]: true, type: 'div', props: {...}, children: [...] }\n\nmount(() => vnode, '#app')", "xuy"),
    H3("一次编译"),
    P(".xuy 文件里的标签名在构建期直接变成 document.createElement，运行时只剩 signal/effect。写 .js 时不走编译器，标签从 xunay/tags 导入，功能一样，只是包大一点。"),
    Code("// .xuy 文件\nimport { signal, mount } from 'xunay'\n\nconst n = signal(0)\nmount(() => div(null, () => String(n())), '#app')\n// 编译后 → document.createElement('div') + effect\n\n// .js 文件\nimport { signal, mount } from 'xunay'\nimport { div } from 'xunay/tags'\n\nconst n = signal(0)\nmount(() => div(null, () => String(n())), '#app')", "js"),
    H2("核心 API 全览"),
    H3("响应式"),
    Table(["API","签名","作用"], [["signal","signal(init) => s","创建可读写的信号"],["computed","computed(fn) => c","派生只读值，惰性 + 缓存"],["effect","effect(fn) => stop","自动追踪依赖的副作用"],["batch","batch(fn)","合并多次写为一次更新"],["untrack","untrack(fn)","在 fn 里读 signal 不订阅"],["onCleanup","onCleanup(fn)","注册 effect 的清理函数"]]),
    H3("渲染"),
    Table(["API","签名","作用"], [["mount","mount(comp, target) => unmount","挂载组件树"],["render","render(vnode) => Node","vnode 转 DOM"],["list","list(arr, keyFn, renderFn)","keyed 列表 diff"],["show","show(cond, renderFn)","条件挂载/卸载"],["frag","frag(...children)","多根节点容器"],["txt","txt`...`","响应式模板字符串"]]),
    H3("生命周期与工具"),
    Table(["API","签名","作用"], [["onMount","onMount(fn)","挂载后执行一次"],["onUnmount","onUnmount(fn)","卸载前执行一次"],["ref","ref(init) => r","DOM 引用容器（非响应式）"],["ctx","ctx(default)","跨层级传值"],["err","err(fn, fallback)","同步错误边界"],["lazy","lazy(loader)","延迟加载组件"]]),
    H2("编译模式"),
    Table(["模式","行为","场景"], [["compiled","编译器生成 document.createElement","生产构建"],["runtime","源码原样 + 自动注入标签 import","开发 / 动态标签"],["hybrid","文件头有 // @runtime 走 runtime，其余 compiled","混合（默认）"]]),
    P("优先级：文件头 // @runtime > 命令行 --mode > package.json.xunay.compileMode > 默认 compiled。"),
    H2("可选模块"),
    Table(["模块","作用","gzip"], [["xunay","核心（26 个导出）","7.06 KB"],["xunay/kit/ui","106 个 UI 组件","29.58 KB"],["xunay/anim","228 个动画导出","15.06 KB"],["xunay/devtools","内置调试面板","15.89 KB"],["xunay/ssr","renderToString + hydrate","5.45 KB"],["xunay/router","hash / history 路由","—"],["xunay/query","数据请求 + 缓存","—"],["xunay/form","表单校验 + 绑定","—"],["xunay/auth","令牌管理","—"],["xunay/i18n","国际化","—"],["xunay/theme","明暗主题","—"],["xunay/babylon","Babylon.js 集成","—"]]),
    H2("30 秒上手"),
    P("方式 1——纯 HTML，一行 script："),
    Code("<!DOCTYPE html>\n<html>\n<body>\n  <div id=\"app\"></div>\n  <script src=\"https://unpkg.com/xunay/dist/xunay.min.js\"></script>\n  <script>\n    const { div, button, span, signal, mount } = XuNay\n    const n = signal(0)\n    mount(() => div(null,\n      button({ on: { click: () => n(v => v - 1) } }, \"-\"),\n      span(null, () => String(n())),\n      button({ on: { click: () => n(v => v + 1) } }, \"+\")\n    ), \"#app\")\n  </script>\n</body>\n</html>", "html"),
    P("方式 2——写 .xuy，标签不用 import："),
    Code("// app.xuy\nimport { signal, mount } from 'xunay'\n\nconst n = signal(0)\n\nmount(() => div({ class: 'app' },\n  button({ on: { click: () => n(v => v - 1) } }, '-'),\n  span(null, () => 'n = ' + n()),\n  button({ on: { click: () => n(v => v + 1) } }, '+')\n), '#app')", "xuy"),
    Code("xuyc3 build app.xuy --out dist\npython3 -m http.server 8080 --directory dist", "bash"),
    H2("完整示例：待办清单"),
    Code("// app.xuy\n// title: 待办清单\nimport { signal, computed, list, show, mount, txt } from 'xunay'\n\nconst todos = signal([])\nconst filter = signal('all')\nconst draft = signal('')\n\nconst filtered = computed(() => {\n  const t = todos(), f = filter()\n  if (f === 'active') return t.filter(x => !x.done)\n  if (f === 'done') return t.filter(x => x.done)\n  return t\n})\n\nconst stats = computed(() => ({\n  total: todos().length,\n  active: todos().filter(x => !x.done).length,\n}))\n\nconst add = () => {\n  if (!draft().trim()) return\n  todos(l => [...l, { id: Date.now(), title: draft(), done: false }])\n  draft('')\n}\nconst toggle = id => todos(l => l.map(t => t.id === id ? { ...t, done: !t.done } : t))\nconst remove = id => todos(l => l.filter(t => t.id !== id))\n\nmount(() => div({ class: 'app' },\n  h1(null, '待办清单'),\n  p({ class: 'sub' }, txt`共 ${() => stats().total} 条 · 未完成 ${() => stats().active}`),\n  div({ class: 'row' },\n    input({\n      placeholder: '输入任务，回车添加…',\n      value: () => draft(),\n      on: {\n        input: e => draft(e.target.value),\n        keydown: e => { if (e.key === 'Enter') add() }\n      }\n    }),\n    button({ on: { click: add } }, '添加')\n  ),\n  div({ class: 'tabs' },\n    ['all', 'active', 'done'].map(k =>\n      span({\n        class: () => 'tab' + (filter() === k ? ' on' : ''),\n        on: { click: () => filter(k) }\n      }, k === 'all' ? '全部' : k === 'active' ? '未完成' : '已完成')\n    )\n  ),\n  show(() => filtered().length === 0, () => p({ class: 'empty' }, '暂无任务')),\n  ul({ class: 'list' },\n    list(filtered, t => t.id, t => li({ class: () => t.done ? 'done' : '' },\n      input({ type: 'checkbox', checked: () => t.done, on: { change: () => toggle(t.id) } }),\n      span(null, t.title),\n      button({ class: 'del', on: { click: () => remove(t.id) } }, '×')\n    ))\n  )\n), '#app')", "xuy"),
    H2("常见误区"),
    H3("误区 1：读 signal 忘了加 ()"),
    Code("span(null, n)      // ✗ 显示函数本身\nspan(null, n())    // ✗ 立即取值，不响应\nspan(null, () => n()) // ✓ 响应式", "xuy"),
    H3("误区 2：在 effect 里读写同一 signal"),
    Code("effect(() => { n(n() + 1) })   // ✗ 死循环\neffect(() => { console.log(n()) })   // ✓ 只读", "xuy"),
    H3("误区 3：直接 push 数组"),
    Code("todos().push(item)         // ✗ 引用没变，不触发\ntodos(l => [...l, item])   // ✓ 返回新数组", "xuy"),
    H3("误区 4：list 用索引做 key"),
    Code("list(todos, (t, i) => i, ...)   // ✗ 重排后状态错乱\nlist(todos, t => t.id, ...)      // ✓ 用稳定 id", "xuy"),
    H3("误区 5：.xuy 里手动 import 标签"),
    Code("// ✗ 编译器会自动注入，重复声明报错\nimport { div, span } from 'xunay'\n\n// ✓ 只 import 非标签\nimport { signal, mount } from 'xunay'", "js"),
    H2("什么时候用 / 不用"),
    H3("适合"),
    Ul("个人项目 / 小工具 / 内部后台","想要最小核心、可预测性能","想学\"响应式的本质\"","需要编译期优化但不能接受 Svelte 那种限制"),
    H3("不适合"),
    Ul("需要庞大生态（AntD 那种整套组件）","团队已深度绑定 React / Vue 生态","需要成熟 SSR + 数据层方案（用 Next / Nuxt）","需要框架级的社区支持"),
    H2("设计取舍"),
    Quote("React 是 2013 年的回答，Vue 是 2014 年的回答，Svelte 是 2016 年的回答。XuNay 是另一条路——用最直接的方式，解决 90% 的前端问题，剩下的 10% 交给别的库。"),
    H2("下一步"),
    Ul("想直接跑通——读「快速开始」","想理解语法规则——读「模板语法」","从 React / Vue 过来——读「概念对照」或对应迁移篇","想看实战——读「示例 → 待办清单」","想了解编译原理——读「编译器 → 编译架构」"),
  )
}
