// kit: 凹凸图
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link, ChartDemo, IconGrid } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: 凹凸图"),
    P("排名变化（分类：流向）"),
    H2("引入"),
    Code("import Kit from 'xunay/kit/charts/bump'", "js"),
    H2("实时预览"),
    ChartDemo("bump", {"height": 280, "padding": {"top": 30, "right": 70, "bottom": 30, "left": 50}, "labels": ["1月", "2月", "3月", "4月", "5月"], "series": [{"name": "A", "data": [{"label": "1月", "value": 100}, {"label": "2月", "value": 80}, {"label": "3月", "value": 60}, {"label": "4月", "value": 90}, {"label": "5月", "value": 70}]}, {"name": "B", "data": [{"label": "1月", "value": 60}, {"label": "2月", "value": 90}, {"label": "3月", "value": 100}, {"label": "4月", "value": 70}, {"label": "5月", "value": 85}]}, {"name": "C", "data": [{"label": "1月", "value": 80}, {"label": "2月", "value": 70}, {"label": "3月", "value": 85}, {"label": "4月", "value": 100}, {"label": "5月", "value": 95}]}]}),
    H2("示例"),
    Code("const chart = new Kit('#app', { title: '凹凸图' })\nchart.setData([...])\nchart.setOptions({ theme: 'dark' })\nchart.replay()\nchart.destroy()", "js"),
    H2("通用方法"),
    Table(["方法","说明"], [["setData(data)","替换数据"],["setOptions(opts)","更新配置"],["render({animate})","手动重绘"],["replay()","重播动画"],["destroy()","销毁"]]),
    Tip("完整清单见「Kit 组件 → Kit 总览」。"),
  )
}
