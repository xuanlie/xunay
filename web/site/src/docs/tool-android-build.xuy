// Android 构建配置
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("构建配置"),
    P("Android 端的 build.gradle 是 gen.js 生成的。想改配置要改 gen.js 里的 BUILD_GRADLE 常量。"),
    H2("默认配置"),
    Code("plugins { id \"com.android.application\" version \"8.6.0\" }\\nandroid {\\n    namespace \"com.xunay.app\"\\n    compileSdk 35\\n    defaultConfig {\\n        applicationId \"com.xunay.app\"\\n        minSdk 24\\n        targetSdk 35\\n        versionCode 6\\n        versionName \"3.0\"\\n    }\\n    compileOptions {\\n        sourceCompatibility JavaVersion.VERSION_17\\n        targetCompatibility JavaVersion.VERSION_17\\n    }\\n}\\ndependencies {\\n    implementation \"androidx.appcompat:appcompat:1.6.1\"\\n    implementation \"androidx.recyclerview:recyclerview:1.3.2\"\\n    implementation \"com.github.bumptech.glide:glide:4.16.0\"\\n    implementation \"com.google.android.flexbox:flexbox:3.0.0\"\\n}", "gradle"),
    H2("改配置"),
    P("gen.js 里找 BUILD_GRADLE 常量，改完重新生成。"),
    Code("// android/src/gen.js\\nconst BUILD_GRADLE = `plugins { ... }\\nandroid {\\n    ...\\n    defaultConfig { minSdk 26 }  // 改成 26\\n    ...\\n}`", "js"),
    H2("常用配置项"),
    Table(["项","默认","说明"], [["minSdk","24","最低支持 Android 7.0"],["targetSdk","35","目标版本"],["compileSdk","35","编译用 SDK"],["versionCode","6","整数版本号"],["versionName","\"3.0\"","显示版本"]]),
    H2("依赖"),
    Table(["依赖","用途"], [["appcompat","基础 Activity 兼容"],["recyclerview","list() 用"],["glide","图片加载"],["flexbox","display:flex"]]),
    H2("签名配置"),
    P("release 签名从 gradle.properties 读。生成时那 4 个字段是空的，填上就能编 release。"),
    Code("XUNAY_KEYSTORE=/path/to/your.jks\\nXUNAY_KEYSTORE_PASSWORD=xxx\\nXUNAY_KEY_ALIAS=xxx\\nXUNAY_KEY_PASSWORD=xxx", "properties"),
    H2("Java 版本"),
    P("默认 Java 17。要降级，改 compileOptions 里的两个 JavaVersion 常量。"),
    H2("注意事项"),
    Ul("改 build.gradle 是改生成器，不是改产物（每次生成会覆盖）","想保留自定义改动，改 gen.js","多模块不支持"),
  )
}
