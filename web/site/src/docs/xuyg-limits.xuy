export function Doc() {
  return D(
    H1("Xuyg · 限制与修复记录"),
    H2("限制"),
    Ul(["不支持 JSX", "不支持 TypeScript 类型注解", "sdu 的 if 只支持一个条件", "sdu 的 @media 只支持 media query", "不支持自定义 sdu 模板声明（只能用内置 + sdu<N> 匿名）", "增量编译未实现（每次全量）", "图表需手写 ChartBox 包装（未内置到 sdu）", "xuy 只做嵌套 map，不支持条件 / 事件 / 样式", "npm 包内的 xuyg 只支持 build（--serve / --open / --minify / dev 为开发版专属）"]),
    H2("已修复的 bug"),
    Ol(["dt 字段引用（orig: price + 100 → row.price + 100）", "隐式 return 保留缩进", "sdu 结尾 ) 消费", "sdu 数据源调用（typeof goods === function ? goods(n) : goods）", "sdu if / @media 逗号表达式", "多个 @xxx 合并 on 键", "vmodel 合并已有 on", "img 404 触发清屏（e.error 过滤）"]),
    H2("实现位置"),
    Table(["文件","作用"], [["core/bin/Xuyg.js","CLI 入口（只读 xuyc.js，运行时补丁）"],["core/compiler4/index.js","编译器入口（needsCompile4 + compile4）"],["core/compiler4/cpt.js","cpt / pag / dt 转换 + 隐式 return"],["core/compiler4/xuy.js","xuy 嵌套生成器（.psc 链式）"],["core/compiler4/sdu.js","sdu 模板 + @绑定 + if + @media"],["core/compiler4/builtins.js","20 个内置模板 + BUILTIN_CSS"],["core/compiler4/event.js","@click / onClick 转换 + on 键合并"],["core/compiler4/vmodel.js","vmodel 双向绑定（合并已有 on）"]]),
  )
}
