// AI 总纲
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("AI 总纲"),
    P("给 AI 助手的一页速查——读完这篇能写正确的 xunay 代码。"),
    H2("一句话"),
    P("xunay 是极简前端框架。核心 5.71KB，无 VDOM，无 Fiber，无 Hooks。用 signal 存状态，用 effect 订阅变化，组件只执行一次。"),
    H2("唯一心智模型"),
    Quote("静态内容直接写，动态内容用函数包。"),
    Code("// 静态：永不更新\nspan(null, 'hello')\n\n// 动态：跟 n 变\nspan(null, () => n())\n\n// 这就是全部规则", "xuy"),
    H2("核心 API（24 个）"),
    Table(["API","签名","说明"], [["signal","signal(init, opts?)","响应式状态，支持 { equals }"],["computed","computed(fn)","派生值（lazy + dirty + dispose）"],["effect","effect(fn)","副作用（自动追踪依赖）"],["batch","batch(fn)","合并多次写"],["untrack","untrack(fn)","读 signal 但不订阅"],["onCleanup","onCleanup(fn)","effect 重跑前清理"],["mount","mount(comp, target)","挂载应用"],["render","render(vnode)","vnode 转 DOM"],["list","list(arr, keyFn, renderFn)","keyed 列表"],["show","show(cond, renderFn)","条件渲染"],["frag","frag(...children)","多节点容器"],["txt","txt`...`","响应式模板字符串"],["onMount / onUnmount","onMount(fn)","生命周期"],["ref","ref(init)","可变引用"],["createElement","createElement(type, props, ...children)","创建 vnode"],["createFragment","createFragment(children)","创建 Fragment"],["tag","tag(name)","动态标签工厂"],["tags","tags.div / tags.span","29 个标准标签"],["registerTags","registerTags(names)","注册自定义标签"],["createRuntime","createRuntime()","创建独立 runtime"],["setRuntime / withRuntime / resetRuntime","——","runtime 切换与重置"]]),
    H2("引入方式"),
    Code("// 核心\nimport { signal, effect, mount, list, show } from 'xunay'\n\n// 标签（推荐）\nimport { div, span, button, input } from 'xunay/tags'\n\n// UI 组件（106 个）\nimport { Btn, Input, Modal, Table } from 'xunay/kit'\n\n// 动画（228 个）\nimport { fadeIn, Entrance, inView } from 'xunay/anim'\n\n// 工具库\nimport { auth } from 'xunay/auth'\nimport { storage } from 'xunay/storage'\nimport { http } from 'xunay/http'\nimport { i18n } from 'xunay/i18n'\nimport { theme } from 'xunay/theme'\nimport { query } from 'xunay/query'\nimport { createForm, rules } from 'xunay/form'\nimport { persist } from 'xunay/persist'\nimport { createRouter } from 'xunay/router'\nimport { lockScroll, swipe, isMobile } from 'xunay/mobile'\n\n// 服务端渲染\nimport { renderToString, hydrateMount } from 'xunay/ssr'", "js"),
    H2("常用标签工厂"),
    Code("import { div, span, p, a, button, input, form, label } from 'xunay/tags'\nimport { ul, ol, li, h1, h2, h3, h4, h5, h6 } from 'xunay/tags'\nimport { table, thead, tbody, tr, td, th, img, br, hr } from 'xunay/tags'\nimport { pre, code, blockquote } from 'xunay/tags'", "js"),
    H2("常见别名"),
    Code("import { s, c, f, bat, m, l } from 'xunay/alias'\n// s = signal, c = computed, f = effect, bat = batch, m = mount, l = list", "js"),
    H2("写代码的规则"),
    H3("规则 1：动态值必须包函数"),
    Code("// 对\ndiv(null, () => n())\ninput({ value: () => name() })\nbutton({ class: () => active() ? 'on' : '' })\n\n// 错\ndiv(null, n())\ninput({ value: name() })", "xuy"),
    H3("规则 2：事件用 on 对象"),
    Code("button({ on: { click: () => n(v => v + 1) } }, '+')", "xuy"),
    H3("规则 3：列表必须用 list"),
    Code("// 对\nul(null, list(todos, t => t.id, t => li(null, t.title)))\n\n// 错（静态展开，不会更新）\nul(null, ...todos().map(t => li(null, t.title)))", "xuy"),
    H3("规则 4：条件用 show 或三目"),
    Code("// 方式 A\nshow(() => open(), () => div(null, '内容'))\n\n// 方式 B\n() => open() ? div(null, '内容') : null", "xuy"),
    H3("规则 5：组件只执行一次"),
    Code("function Counter() {\n  const n = signal(0)\n  console.log('初始化')   // 只打印一次\n  return div(null, () => n())\n}", "xuy"),
    H3("规则 6：onMount 必须在组件内"),
    Code("// 对\nfunction Home() {\n  onMount(() => console.log('挂载'))\n  return div(null, 'Home')\n}\n\n// 错（模块顶层不生效）\nonMount(() => console.log('挂载'))", "xuy"),
    H3("规则 7：signal 读写都带 ()"),
    Code("const n = signal(0)\nn()             // 读 → 0\nn(1)            // 写 → 1\nn(v => v + 1)   // 函数式 → 2", "xuy"),
    H2("高级 API"),
    Table(["API","用途"], [["untrack(fn)","effect 里读 signal 但不订阅"],["onCleanup(fn)","effect 重跑前清理定时器 / 请求"],["computed.dispose()","销毁派生值"],["signal.equals","自定义比较：signal(obj, { equals: customFn })"],["registerTags(names)","注册自定义标签 / Web Components"],["createRuntime()","创建独立运行时（SSR 并发隔离）"],["withRuntime(rt, fn)","临时切换 runtime"],["ref(init)","DOM 引用 / 普通变量"],["ctx(default)","跨层级传值（xunay/advanced）"],["err(fn, fallback)","错误边界（xunay/advanced）"],["lazy(loader)","懒加载组件（xunay/advanced）"],["trans(duration)","过渡助手（xunay/anim）"]]),
    H2("文件类型"),
    Table(["后缀","说明"], [[".xuy","标签名可当函数直接用，不用 import"],[".js","标准 JS，需要 import 标签名"]]),
    H2("最小完整应用"),
    Code("// app.xuy\n// title: 我的应用\nimport { signal, mount } from 'xunay'\nimport { div, h1, button, span } from 'xunay/tags'\n\nconst n = signal(0)\n\nmount(() => div({ class: 'app' },\n  h1(null, '计数器'),\n  button({ on: { click: () => n(v => v - 1) } }, '-'),\n  span(null, () => String(n())),\n  button({ on: { click: () => n(v => v + 1) } }, '+')\n), '#app')", "xuy"),
    H2("100% 会踩的坑"),
    Table(["坑","正确做法"], [["忘加 ()","n() 不是 n"],["静态值当动态用","用 () => n() 不用 n()"],["effect 里读写同一 signal","会死循环"],["list 用索引做 key","用稳定的 id"],["模块顶层 onMount","移到组件函数体内"],["深层对象修改","整体替换触发更新"],["标签从 xunay 导入","已移到 xunay/tags"]]),
    H2("性能（浏览器实测）"),
    Table(["操作","耗时"], [["signal 读","17 ns"],["signal 写","25 ns"],["signal 写触发 effect","239 ns"],["computed 缓存读","20 ns"],["list 首渲 100 项","27 µs"]]),
    H2("不要做的"),
    Ul("不要写 <div> 这种 JSX（用 div(...)）","不要用 key={} 属性（用 list 的 keyFn）","不要手动写依赖数组（自动收集）","不要在 effect 里读又写同一 signal","不要在组件函数体里做副作用（用 onMount 或 event）"),
  )
}
