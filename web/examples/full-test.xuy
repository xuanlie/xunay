// 用一个 root 容器
const container = document.createElement('div')
container.style.cssText = 'padding:16px;background:#111;color:#0f0;font:12px monospace'
document.getElementById('app').appendChild(container)

const ok = []
const fail = []

TESTS.forEach(([name, make]) => {
  // 每项独立容器
  const wrap = document.createElement('div')
  wrap.style.cssText = 'display:inline-block;padding:6px 10px;margin:3px;border:1px solid #333;border-radius:4px;vertical-align:top;text-align:center;min-width:70px;color:#0f0'
  wrap.textContent = name
  container.appendChild(wrap)

  const box = document.createElement('div')
  box.style.cssText = 'margin-top:4px'
  wrap.appendChild(box)

  try {
    // 每个挂到独立 div
    mount(() => {
      try { return make() } catch (e) { return div({ style: 'color:#f55' }, 'ERR:' + (e.message || e)) }
    }, box)
    ok.push(name)
  } catch (e) {
    wrap.style.borderColor = '#f55'
    wrap.style.color = '#f55'
    box.textContent = 'X ' + (e.message || e)
    fail.push([name, e.message || String(e)])
  }
})

// 汇总
const summary = document.createElement('div')
summary.style.cssText = 'margin-top:20px;padding:12px;background:#000;border:1px solid #333;font-size:13px;white-space:pre-wrap'
summary.textContent = `通过 ${ok.length} / 失败 ${fail.length}\n\n` +
  (fail.length ? '失败列表：\n' + fail.map(([n, e]) => '  ✗ ' + n + ' — ' + e).join('\n') : '✓ 全部通过')
container.appendChild(summary)
