const imgUrl = s('https://www.baidu.com/img/flexible/logo/pc/result.png')
const fileContent = s('未读取')
const lang = s('zh')

app(() => div({ style: { padding: 24 } },
  h1(null, 'A1+A2+A3 测试'),

  span({ style: { fontSize: 18 } }, '图片缓存（Glide）'),
  img({ src: 'https://www.baidu.com/img/flexible/logo/pc/result.png' }),

  span({ style: { fontSize: 18 } }, '文件读写'),
  button({ on: { click: () => writeFile('test.txt', fileContent) } }, '写文件'),
  button({ on: { click: () => readFile('test.txt', fileContent) } }, '读文件'),
  span(null, txt`内容: ${fileContent}`)
), '#app')