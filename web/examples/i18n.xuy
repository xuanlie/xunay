const LANG = {
  zh: {
    title: '多语言演示',
    greet: '你好',
    switch_en: '切换英文',
    switch_zh: '切换中文'
  },
  en: {
    title: 'i18n Demo',
    greet: 'Hello',
    switch_en: 'Switch to English',
    switch_zh: 'Switch to Chinese'
  }
}

app(() => div({ style: { padding: 24 } },
  h1(null, '多语言标题'),
  span({ style: { fontSize: 20 } }, '问候语占位'),
  button({ style: { padding: 16, background: '#4CAF50', color: '#fff' }, on: { click: () => setLang('zh') } }, '中文'),
  button({ style: { padding: 16, background: '#2196F3', color: '#fff' }, on: { click: () => setLang('en') } }, 'English')
), '#app')