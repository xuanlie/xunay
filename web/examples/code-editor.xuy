// 主题用 CSS 变量驱动
const THEMES = Object.keys(COLORS)

const baseTheme = EditorView.theme({
  '&': { backgroundColor: 'var(--xe-bg)', color: 'var(--xe-fg)', height: '100%' },
  '.cm-content': { caretColor: 'var(--xe-acc)',
    fontFamily: '"JetBrains Mono","Fira Code",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace',
    fontSize: '13.5px', lineHeight: '1.6' },
  '.cm-cursor, .cm-dropCursor': { borderLeftColor: 'var(--xe-acc)', borderLeftWidth: '2px' },
  '&.cm-focused .cm-selectionBackground, .cm-selectionBackground, .cm-content ::selection': { backgroundColor: 'var(--xe-sel)' },
  '.cm-activeLine': { backgroundColor: 'var(--xe-cur)' },
  '.cm-selectionMatch': { backgroundColor: 'var(--xe-sel)' },
  '.cm-gutters': { backgroundColor: 'var(--xe-gutter)', color: 'var(--xe-dim)', border: 'none' },
  '.cm-gutterElement': { padding: '0 8px' },
  '.cm-activeLineGutter': { backgroundColor: 'var(--xe-cur)', color: 'var(--xe-fg)' },
  '.cm-foldPlaceholder': { backgroundColor: 'var(--xe-bd)', color: 'var(--xe-fg)', border: 'none', padding: '0 6px', borderRadius: '3px' },
  '.cm-tooltip': { backgroundColor: 'var(--xe-gutter)', border: '1px solid var(--xe-bd)', color: 'var(--xe-fg)' },
  '.cm-tooltip-autocomplete > ul > li[aria-selected]': { backgroundColor: 'var(--xe-acc)', color: 'var(--xe-bg)' },
  '.cm-panels': { backgroundColor: 'var(--xe-gutter)', color: 'var(--xe-fg)' },
  '.cm-panels.cm-panels-top': { borderBottomColor: 'var(--xe-bd)' },
  '.cm-panels.cm-panels-bottom': { borderTopColor: 'var(--xe-bd)' },
  '.cm-searchMatch': { backgroundColor: 'var(--xe-hit)', outline: 'none' },
  '.cm-searchMatch.cm-searchMatch-selected': { backgroundColor: 'var(--xe-hitOn)' },
  '.cm-matchingBracket, .cm-nonmatchingBracket': {
    backgroundColor: 'var(--xe-bracket)',
    outline: '1px solid var(--xe-bracket-bd)',
  },
})

const hiStyle = HighlightStyle.define([
  { tag: t.keyword, color: 'var(--xe-k)' },
  { tag: [t.name, t.deleted, t.character, t.macroName], color: 'var(--xe-fg)' },
  { tag: [t.propertyName], color: 'var(--xe-f)' },
  { tag: [t.function(t.variableName), t.labelName], color: 'var(--xe-f)' },
  { tag: [t.color, t.constant(t.name), t.standard(t.name)], color: 'var(--xe-n)' },
  { tag: [t.definition(t.name), t.separator], color: 'var(--xe-fg)' },
  { tag: [t.typeName, t.className, t.changed, t.annotation, t.modifier, t.self, t.namespace], color: 'var(--xe-t)' },
  { tag: [t.operator, t.operatorKeyword, t.url, t.escape, t.regexp, t.link, t.special(t.string)], color: 'var(--xe-o)' },
  { tag: [t.meta, t.comment], color: 'var(--xe-c)', fontStyle: 'italic' },
  { tag: t.strong, fontWeight: 'bold' },
  { tag: t.emphasis, fontStyle: 'italic' },
  { tag: t.strikethrough, textDecoration: 'line-through' },
  { tag: t.link, color: 'var(--xe-f)', textDecoration: 'underline' },
  { tag: t.heading, fontWeight: 'bold', color: 'var(--xe-k)' },
  { tag: [t.atom, t.bool, t.special(t.variableName)], color: 'var(--xe-n)' },
  { tag: [t.processingInstruction, t.string, t.inserted], color: 'var(--xe-s)' },
  { tag: t.invalid, color: '#ff5555' },
  { tag: [t.string, t.special(t.string)], color: 'var(--xe-s)' },
  { tag: t.number, color: 'var(--xe-n)' },
  { tag: [t.variableName], color: 'var(--xe-fg)' },
  { tag: [t.bracket, t.squareBracket, t.paren, t.brace], color: 'var(--xe-m)' },
])

const themeExt = [baseTheme, syntaxHighlighting(hiStyle)]

// ============ 状态 ============
const doc      = signal(INIT)
const lang     = signal('js')
const theme    = signal('onedark')
const cursor   = signal({ line: 1, col: 1, lines: 1, chars: 0, sel: 0 })
const dirty    = signal(false)
const showLangs = signal(false)

// ============ CSS ============
if (typeof document !== 'undefined' && !document.getElementById('xe-css')) {
  const s = document.createElement('style')
  s.id = 'xe-css'
  s.textContent = `
html,body{margin:0;padding:0;height:100%;overflow:hidden}
.xe{display:flex;flex-direction:column;height:100dvh;
  font-family:"JetBrains Mono","Fira Code",ui-monospace,monospace;
  font-size:13.5px;position:relative}
.xe-top{display:flex;align-items:center;gap:4px;padding:0 10px;height:40px;flex-shrink:0;
  background:var(--xe-gutter);border-bottom:1px solid var(--xe-bd);z-index:10;
  overflow-x:auto;scrollbar-width:none}
.xe-top::-webkit-scrollbar{display:none}
.xe-logo{font-weight:700;font-size:12px;margin-right:8px;white-space:nowrap}
.xe-btn{display:inline-flex;align-items:center;padding:4px 10px;height:26px;
  background:transparent;border:1px solid transparent;border-radius:5px;
  font:inherit;font-size:12px;cursor:pointer;white-space:nowrap;flex-shrink:0;color:inherit;opacity:.75}
.xe-btn:hover{background:var(--xe-cur);opacity:1}
.xe-btn.on{background:var(--xe-cur);opacity:1;font-weight:600}
.xe-spacer{flex:1;min-width:8px}
.xe-host{flex:1;min-height:0;position:relative;overflow:hidden}
.xe-host .cm-editor{height:100%}
.xe-host .cm-scroller{overflow:auto}
.xe-foot{display:flex;align-items:center;gap:14px;padding:0 14px;height:28px;flex-shrink:0;
  background:var(--xe-gutter);border-top:1px solid var(--xe-bd);font-size:11.5px;
  color:var(--xe-dim);overflow:hidden}
.xe-foot span{white-space:nowrap}
.xe-foot .acc{color:var(--xe-acc)}
.xe-mask{position:fixed;top:40px;left:0;right:0;bottom:0;z-index:150;background:rgba(0,0,0,.3)}
.xe-menu{position:fixed;top:44px;z-index:210;background:var(--xe-gutter);
  border:1px solid var(--xe-bd);border-radius:8px;padding:6px;
  box-shadow:0 8px 32px rgba(0,0,0,.7);font-size:12.5px;min-width:200px;
  max-height:70vh;overflow-y:auto}
.xe-menu.right{right:12px}
.xe-menu.left{left:8px;right:8px}
.xe-menu .title{padding:6px 12px;color:var(--xe-dim);font-size:11px;
  text-transform:uppercase;letter-spacing:.5px}
.xe-menu button{display:block;width:100%;text-align:left;padding:9px 12px;
  background:transparent;border:0;color:inherit;font:inherit;font-size:12.5px;
  cursor:pointer;border-radius:5px}
.xe-menu button:hover{background:var(--xe-cur)}
.xe-menu button.on{color:var(--xe-acc);font-weight:600}
.xe-langs{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}
.xe-langs button{text-align:center;padding:6px 8px;font-size:11.5px}
@media (max-width:640px){
  .xe-top{height:44px;padding:0 6px;gap:2px}
  .xe-btn{padding:5px 8px;font-size:11px}
  .xe-menu.left{left:8px;right:8px}
}
`
  document.head.appendChild(s)
}

function applyCSSVars(name) {
  const c = COLORS[name] || COLORS.onedark
  const r = document.documentElement.style
  r.setProperty('--xe-bg', c.bg)
  r.setProperty('--xe-gutter', c.gutter)
  r.setProperty('--xe-bd', c.bd)
  r.setProperty('--xe-fg', c.fg)
  r.setProperty('--xe-dim', c.dim)
  r.setProperty('--xe-cur', c.cur)
  r.setProperty('--xe-acc', c.acc)
  r.setProperty('--xe-sel', c.sel)
  r.setProperty('--xe-k', c.k)
  r.setProperty('--xe-s', c.s)
  r.setProperty('--xe-c', c.c)
  r.setProperty('--xe-n', c.n)
  r.setProperty('--xe-f', c.f)
  r.setProperty('--xe-t', c.t)
  r.setProperty('--xe-m', c.m)
  r.setProperty('--xe-o', c.o)
  r.setProperty('--xe-hit', c.hit)
  r.setProperty('--xe-hitOn', c.hitOn)
  r.setProperty('--xe-bracket', 'rgba(127,127,255,.3)')
  r.setProperty('--xe-bracket-bd', 'rgba(127,127,255,.5)')
  document.body.style.background = c.bg
}

// ============ 组件 ============
function Editor() {
  let view = null
  let hostEl = null
  let applyingRemote = false
  let firstRun = true

  const langConf  = new Compartment()

  const updateCursor = () => {
    if (!view) return
    const st = view.state
    const pos = st.selection.main
    const line = st.doc.lineAt(pos.head)
    cursor({
      line: line.number,
      col: pos.head - line.from + 1,
      lines: st.doc.lines,
      chars: st.doc.length,
      sel: pos.to - pos.from,
    })
  }

  onMount(() => {
    hostEl = document.querySelector('.xe-host')
    if (!hostEl) { console.error('[cm] host not found'); return }

    applyCSSVars(theme())

    const startState = EditorState.create({
      doc: doc(),
      extensions: [
        basicSetup,
        langConf.of((LANGS[lang()] || LANGS.js).load()),
        themeExt,
        EditorView.updateListener.of(u => {
          if (u.docChanged && !applyingRemote) {
            doc(u.state.doc.toString())
            dirty(true)
          }
          if (u.docChanged || u.selectionSet) updateCursor()
        }),
      ],
    })

    view = new EditorView({ state: startState, parent: hostEl })
    updateCursor()

    effect(() => {
      const v = doc()
      if (firstRun) { firstRun = false; return }
      if (!view) return
      if (view.state.doc.toString() === v) return
      applyingRemote = true
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: v } })
      applyingRemote = false
    })

    onCleanup(() => { if (view) { view.destroy(); view = null } })
  })

  const switchLang = l => {
    if (!LANGS[l]) return
    lang(l)
    if (view) view.dispatch({ effects: langConf.reconfigure((LANGS[l]).load()) })
    showLangs(false)
  }
  const switchTheme = name => {
    if (!COLORS[name]) return
    theme(name)
    applyCSSVars(name)
  }
  const cycleTheme = () => {
    const ks = Object.keys(COLORS)
    const i = ks.indexOf(theme())
    switchTheme(ks[(i + 1) % ks.length])
  }
  const save = () => {
    try {
      localStorage.setItem('xe-doc', doc())
      localStorage.setItem('xe-lang', lang())
      localStorage.setItem('xe-theme', theme())
      dirty(false)
    } catch (e) { console.warn(e) }
  }
  const load = () => {
    try {
      const d = localStorage.getItem('xe-doc')
      const l = localStorage.getItem('xe-lang')
      const th = localStorage.getItem('xe-theme')
      if (d) doc(d)
      if (l && LANGS[l]) { lang(l); if (view) view.dispatch({ effects: langConf.reconfigure(LANGS[l].load()) }) }
      if (th && COLORS[th]) { theme(th); applyCSSVars(th) }
      dirty(false)
    } catch (e) { console.warn(e) }
  }
  const exportFile = () => {
    const ext = {
      xuy:'xuy', js:'js', ts:'ts', jsx:'jsx', tsx:'tsx',
      html:'html', css:'css', sass:'scss', stylus:'styl', vue:'vue', svelte:'svelte',
      json:'json', yaml:'yml', toml:'toml', xml:'xml', sql:'sql', proto:'proto',
      md:'md', diff:'diff',
      py:'py', go:'go', rust:'rs', java:'java', cpp:'cpp', php:'php',
      ruby:'rb', swift:'swift', lua:'lua', perl:'pl', r:'r', julia:'jl',
      haskell:'hs', clojure:'clj', erlang:'erl', pascal:'pas', coffee:'coffee', vb:'vb',
      sh:'sh', ps:'ps1', tcl:'tcl',
      docker:'Dockerfile', cmake:'cmake', nginx:'conf',
    }[lang()] || 'txt'
    const blob = new Blob([doc()], { type: 'text/plain' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = 'snippet.' + ext
    a.click()
    URL.revokeObjectURL(url)
  }
  const importFile = () => {
    const inp = document.createElement('input')
    inp.type = 'file'
    inp.accept = '.js,.ts,.jsx,.tsx,.py,.css,.html,.json,.md,.sql,.yaml,.yml,.xml,.rs,.java,.cpp,.php,.go,.sh,.txt'
    inp.onchange = e => {
      const f = e.target.files && e.target.files[0]
      if (!f) return
      const reader = new FileReader()
      reader.onload = () => {
        const text = String(reader.result || '')
        doc(text)
        // 猜语言
        const ext = f.name.split('.').pop().toLowerCase()
        const guess = {
          xuy:'xuy', js:'js', mjs:'js', cjs:'js', ts:'ts', tsx:'tsx', jsx:'jsx',
          html:'html', htm:'html', css:'css', scss:'sass', styl:'stylus', vue:'vue', svelte:'svelte',
          json:'json', yaml:'yaml', yml:'yaml', toml:'toml', xml:'xml',
          sql:'sql', proto:'proto', md:'md', markdown:'md', diff:'diff',
          py:'py', go:'go', rs:'rust', java:'java',
          cpp:'cpp', cc:'cpp', cxx:'cpp', h:'cpp', hpp:'cpp', c:'cpp',
          php:'php', rb:'ruby', swift:'swift', lua:'lua', pl:'perl', r:'r',
          jl:'julia', hs:'haskell', clj:'clojure', erl:'erlang', pas:'pascal',
          coffee:'coffee', vb:'vb', sh:'sh', bash:'sh', zsh:'sh', ps1:'ps', tcl:'tcl',
          dockerfile:'docker', cmake:'cmake', conf:'nginx',
        }[ext]
        if (guess) switchLang(guess)
      }
      reader.readAsText(f)
    }
    inp.click()
  }
  const shareURL = () => {
    try {
      const data = btoa(unescape(encodeURIComponent(JSON.stringify({ d: doc(), l: lang(), t: theme() }))))
      const url = location.origin + location.pathname + '#s=' + data
      navigator.clipboard.writeText(url).then(
        () => alert('链接已复制'),
        () => prompt('复制链接:', url)
      )
    } catch (e) { alert('生成失败') }
  }

  // 载入本地存储 + URL 分享
  onMount(() => {
    const hash = location.hash
    if (hash.startsWith('#s=')) {
      try {
        const data = JSON.parse(decodeURIComponent(escape(atob(hash.slice(3)))))
        if (data.d) doc(data.d)
        if (data.l && LANGS[data.l]) lang(data.l)
        if (data.t && COLORS[data.t]) theme(data.t)
        return
      } catch (e) {}
    }
    load()
  })

  const langKeys = Object.keys(LANGS)
  const themeKeys = Object.keys(COLORS)

  return div({ class: 'xe' },
    div({ class: 'xe-top' },
      span({ class: 'xe-logo' }, 'XUNAY · CM6'),
      button({
        class: () => 'xe-btn' + (showLangs() ? ' on' : ''),
        on: { click: e => {
          e.stopPropagation()
          _lastOpen = Date.now()
          showLangs(!showLangs())
        } }
      }, () => LANGS[lang()].label + ' ▾'),
      button({
        class: 'xe-btn',
        on: { click: e => { e.stopPropagation(); cycleTheme() } }
      }, () => '◐ ' + theme()),
      button({ class: 'xe-btn', on: { click: e => { e.stopPropagation(); save() } } }, '💾 保存'),
      button({ class: 'xe-btn', on: { click: e => { e.stopPropagation(); exportFile() } } }, '⬇ 导出'),
      button({ class: 'xe-btn', on: { click: e => { e.stopPropagation(); importFile() } } }, '⬆ 导入'),
      button({ class: 'xe-btn', on: { click: e => { e.stopPropagation(); shareURL() } } }, '🔗 分享'),
      span({ class: 'xe-spacer' })
    ),
    show(showLangs, () => frag(

      div({ class: 'xe-mask', on: { click: e => { e.stopPropagation(); showLangs(false) } } }),
      div({ class: 'xe-menu left', on: { click: e => e.stopPropagation() } },
        div({ class: 'title' }, '语言'),
        div({ class: 'xe-langs' },
          ...langKeys.map(k =>
            button({
              class: () => lang() === k ? 'on' : '',
              on: { click: () => switchLang(k) }
            }, LANGS[k].label)
          )
        )
      )
        )),
    div({ class: 'xe-host' }),
    div({ class: 'xe-foot' },
      span({ class: 'acc' }, () => LANGS[lang()].label),
      span(null, () => '行 ' + cursor().line + '，列 ' + cursor().col),
      cursor().sel > 0 ? span(null, () => '选中 ' + cursor().sel) : null,
      span({ style: 'flex:1' }),
      span(null, () => cursor().lines + ' 行'),
      span(null, () => cursor().chars + ' 字符'),
      dirty() ? span({ class: 'acc' }, '● 未保存') : span(null, '已保存')
    )
  )
}

let _lastOpen = 0
document.addEventListener('click', () => {
  if (Date.now() - _lastOpen < 200) return
  showLangs(false)
})

mount(() => Editor(), '#app')
