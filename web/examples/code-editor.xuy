import { stylus as stylusLegacy } from '@codemirror/legacy-modes/mode/stylus'
import { tcl as tclLegacy } from '@codemirror/legacy-modes/mode/tcl'
import { vb as vbLegacy } from '@codemirror/legacy-modes/mode/vb'
import { tags as t } from '@lezer/highlight'

const INIT = `// XuNay Code Editor · CodeMirror 6
//
// 全部快捷键由 CodeMirror basicSetup 提供:
//   Ctrl+F 搜索  Ctrl+H 替换  Ctrl+G 跳行
//   Ctrl+Z 撤销  Ctrl+Y 重做  Ctrl+/ 注释
//   Ctrl+D 选下一处  Alt+点击 多光标
//   Alt+↑/↓ 移动行  Shift+Alt+↓ 复制行
//   折叠 · 括号匹配 · 自动补全 · 智能缩进

import { signal, computed, mount } from 'xunay'

function App() {
  const n = signal(0)
  const double = computed(() => n() * 2)

  return div({ class: 'app' },
    h1(null, '计数器'),
    button({ on: { click: () => n(v => v - 1) } }, '-'),
    span(null, () => 'n = ' + n()),
    button({ on: { click: () => n(v => v + 1) } }, '+'),
    p(null, () => '双倍: ' + double())
  )
}

mount(() => App(), '#app')
`

