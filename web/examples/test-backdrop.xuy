import { div, app } from 'xunay'

const CSS = `
.blur { backdrop-filter: blur(10px); padding: 24px; margin: 8px; background: #ff6600; color: #fff; font-size: 24px; }
.gray-blur { backdrop-filter: grayscale(100%) blur(4px); padding: 24px; margin: 8px; background: #22ccff; color: #000; font-size: 24px; }
`

app(() => div(null,
  div({ 'class': 'blur' }, 'blur(10px)'),
  div({ 'class': 'gray-blur' }, '灰度 + blur')
), '#app')
