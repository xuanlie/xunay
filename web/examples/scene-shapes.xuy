scene({ bg: '#1a1a2e', autoRotate: true, camera: { distance: 10, fov: 45 } })

cube({ color: '#ff6600', size: 1, position: [-3, 0, 0] })
sphere({ color: '#00ccff', size: 1, position: [-1, 0, 0] })
cylinder({ color: '#ff00ff', size: 0.8, height: 1.5, position: [1, 0, 0] })
cone({ color: '#ffff00', size: 1, height: 1.5, position: [3, 0, 0] })
torus({ color: '#00ff88', radius: 0.8, tube: 0.3, position: [-2, 0, 2] })
pyramid({ color: '#ff3366', size: 1, height: 1.5, position: [0, 0, 2] })
plane({ color: '#444455', size: 6, position: [0, -1.5, 0] })
