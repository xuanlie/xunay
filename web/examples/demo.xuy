const n = s(0)
const name = s('')
const agree = s(false)
const items = s(['苹果', '香蕉', '橘子'])

app(() => div({ style: { background: '#f5f5f5', padding: 32 } },
  h1({ style: { color: '#333333', textAlign: 'center' } }, '设置'),
  img({ src: 'https://www.baidu.com/img/flexible/logo/pc/result.png', style: { padding: 8 } }),
  input({ placeholder: '输入名字', style: { fontSize: 18, padding: 12 }, on: { input: (e) => name(e) } }),
  span({ style: { color: '#0077cc', fontSize: 20 } }, txt`你好, ${name}`),
  checkbox({ style: { fontSize: 16, padding: 8 }, on: { change: (c) => agree(c) } }, '同意条款'),
  span({ style: { color: '#ff6600', fontSize: 18 } }, txt`同意: ${agree}`),
  button({ style: { background: '#4CAF50', color: '#ffffff', fontSize: 18, padding: 16 }, on: { click: () => n(v => v + 1) } }, '提交'),
  span({ style: { color: '#ff6600', fontSize: 24, textAlign: 'center' } }, txt`提交 ${n} 次`),
  list(items, (item) => span(null, item))
), '#app')