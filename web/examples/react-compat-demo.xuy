// title: React 组件跑在 XuNay 上
import { mount } from 'xunay'
import React, { useState, useEffect, useMemo, useRef, useContext, createContext, memo, Fragment } from 'xunay/compat'

const h = React.createElement

// ============ 1. 计数器 ============
function Counter() {
  const [n, setN] = useState(0)
  useEffect(() => {
    console.log('[Counter] n 变了:', n)
    return () => console.log('[Counter] cleanup n=' + n)
  }, [n])
  return h('div', { className: 'box' },
    h('div', { className: 'title' }, '1. useState + useEffect'),
    h('button', { onClick: () => setN(n - 1) }, '-'),
    h('span', { style: { margin: '0 12px' } }, String(n)),
    h('button', { onClick: () => setN(n + 1) }, '+'),
    h('div', { className: 'hint' }, '打开 Console 看 effect 日志')
  )
}

// ============ 2. useMemo ============
function MemoDemo() {
  const [a, setA] = useState(2)
  const [b, setB] = useState(3)
  const sum = useMemo(() => {
    console.log('[MemoDemo] 重算 a+b')
    return a + b
  }, [a, b])
  const product = useMemo(() => {
    console.log('[MemoDemo] 重算 a*b')
    return a * b
  }, [a, b])
  return h('div', { className: 'box' },
    h('div', { className: 'title' }, '2. useMemo'),
    h('div', null, 'a = ', a, '，b = ', b),
    h('div', null, 'a+b = ', sum, '，a*b = ', product),
    h('button', { onClick: () => setA(a + 1) }, 'a + 1'),
    h('button', { onClick: () => setB(b + 1) }, 'b + 1')
  )
}

// ============ 3. useRef ============
function RefDemo() {
  const [n, setN] = useState(0)
  const renders = useRef(0)
  renders.current += 1
  return h('div', { className: 'box' },
    h('div', { className: 'title' }, '3. useRef（不触发重渲）'),
    h('div', null, 'n = ', n),
    h('div', null, '渲染次数 = ', renders.current),
    h('button', { onClick: () => setN(n + 1) }, '+1')
  )
}

// ============ 4. useContext ============
const ThemeCtx = createContext('light')
function Themed() {
  const theme = useContext(ThemeCtx)
  return h('div', { style: {
    padding: '8px 12px',
    background: theme === 'dark' ? '#333' : '#eee',
    color: theme === 'dark' ? '#fff' : '#000',
    borderRadius: '4px'
  } }, '当前主题：' + theme)
}
function ContextDemo() {
  const [theme, setTheme] = useState('light')
  return h('div', { className: 'box' },
    h('div', { className: 'title' }, '4. createContext + useContext'),
    h(ThemeCtx.Provider, { value: theme }, h(Themed)),
    h('button', { onClick: () => setTheme(theme === 'light' ? 'dark' : 'light') }, '切换主题')
  )
}

// ============ 5. memo ============
const MemoChild = memo(function MemoChild({ label }) {
  console.log('[MemoChild] 渲染:', label)
  return h('div', null, '子组件: ' + label)
})
function MemoDemo2() {
  const [count, setCount] = useState(0)
  return h('div', { className: 'box' },
    h('div', { className: 'title' }, '5. memo'),
    h(MemoChild, { label: '固定值' }),
    h('div', null, '父组件 count = ', count),
    h('button', { onClick: () => setCount(count + 1) }, '父 +1')
  )
}

// ============ 6. 列表渲染 ============
function ListDemo() {
  const [items, setItems] = useState(['苹果', '香蕉', '橙子'])
  return h('div', { className: 'box' },
    h('div', { className: 'title' }, '6. 数组渲染'),
    h('ul', null,
      items.map((it, i) => h('li', { key: i }, it))
    ),
    h('button', { onClick: () => setItems([...items, '新水果 ' + (items.length + 1)]) }, '加一项'),
    h('button', { onClick: () => setItems(items.slice(0, -1)) }, '删一项')
  )
}

// ============ 7. Fragment ============
function FragDemo() {
  return h('div', { className: 'box' },
    h('div', { className: 'title' }, '7. Fragment'),
    h(Fragment, null,
      h('span', null, '[A] '),
      h('span', null, '[B] '),
      h('span', null, '[C]')
    )
  )
}

// ============ 根 ============
function App() {
  return h('div', { style: {
    padding: '24px',
    background: '#282c34',
    color: '#abb2bf',
    fontFamily: 'monospace',
    minHeight: '100vh',
  } },
    h('h1', { style: { color: '#61afef', margin: '0 0 20px' } }, 'React 组件跑在 XuNay 上'),
    h(Counter),
    h(MemoDemo),
    h(RefDemo),
    h(ContextDemo),
    h(MemoDemo2),
    h(ListDemo),
    h(FragDemo)
  )
}

// ============ 挂载 ============
const root = React.createRoot(document.getElementById('app'))
root.render(h(App))

// 样式
if (!document.getElementById('demo-css')) {
  const s = document.createElement('style')
  s.id = 'demo-css'
  s.textContent = `
    .box { padding: 16px; margin: 12px 0; border: 1px solid #3b4048; border-radius: 8px; background: #21252b; }
    .box .title { color: #98c379; font-weight: bold; margin-bottom: 12px; }
    .box button { padding: 4px 12px; margin: 0 4px; background: #3b4048; color: #abb2bf; border: 1px solid #5c6370; border-radius: 4px; cursor: pointer; font-family: inherit; }
    .box button:hover { background: #4a5060; }
    .hint { color: #5c6370; font-size: 12px; margin-top: 8px; }
  `
  document.head.appendChild(s)
}
