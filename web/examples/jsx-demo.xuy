// title: JSX 组件跑在 XuNay
import { mount } from 'xunay'
import React from 'xunay/compat'
import Demo from './components/Demo.jsx'

function App() {
  return React.createElement('div', {
    style: { padding: '24px', background: '#282c34', color: '#abb2bf', fontFamily: 'monospace', minHeight: '100vh' },
  },
    React.createElement('h1', { style: { color: '#61afef' } }, 'JSX 文件跑在 XuNay 上'),
    React.createElement('p', { style: { color: '#5c6370' } },
      'Demo.jsx 是纯 JSX 文件，一行未改，直接 import 就能用。'),
    React.createElement(Demo)
  )
}

React.createRoot(document.getElementById('app')).render(React.createElement(App))
