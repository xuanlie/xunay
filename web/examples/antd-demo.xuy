// title: AntD 测试
import { mount } from 'xunay'
import React from 'xunay/compat'
import { Button, Tag, Alert, Space } from 'antd'

const h = React.createElement

function App() {
  return h('div', {
    style: { padding: '24px', background: '#282c34', color: '#abb2bf', fontFamily: 'system-ui', minHeight: '100vh' },
  },
    h('h1', { style: { color: '#61afef' } }, 'AntD 跑在 XuNay 上'),
    h('div', { style: { color: '#98c379', marginBottom: '16px' } }, 'AntD 加载成功'),
    h(Space, { direction: 'vertical', size: 'middle', style: { width: '100%' } },
      h(Alert, { message: '成功', description: 'AntD Alert 跑在 XuNay 上', type: 'success', showIcon: true }),
      h(Space, null,
        h(Button, { type: 'primary' }, '主要按钮'),
        h(Button, null, '默认'),
        h(Button, { type: 'dashed' }, '虚线'),
        h(Button, { danger: true }, '危险')
      ),
      h(Space, null,
        h(Tag, { color: 'magenta' }, 'magenta'),
        h(Tag, { color: 'red' }, 'red'),
        h(Tag, { color: 'green' }, 'green'),
        h(Tag, { color: 'blue' }, 'blue'),
        h(Tag, { color: 'purple' }, 'purple')
      )
    )
  )
}

React.createRoot(document.getElementById('app')).render(h(App))
