const CSS = `
  :root {
    --primary: #4CAF50;
    --danger: #ff6600;
    --text: #333333;
    --spacing: 16;
  }
  .card { background: var(--primary); padding: var(--spacing); color: white }
  .title { color: var(--text); font-size: 28; padding: var(--spacing) }
  .danger { background: var(--danger) }
  .fallback { color: var(--undefined-color, #ff00ff) }
`

app(() => div({ style: { padding: 24 } },
  div({ class: 'card' }, '绿色卡片'),
  h1({ class: 'title' }, '深灰标题'),
  button({ class: 'card danger', style: { padding: 16 } }, '橙红按钮'),
  span({ class: 'fallback' }, '未定义变量 fallback 到紫色')
), '#app')