// title: SVG 最小测试
import { mount } from 'xunay'
import { Svg, Rect, Circle, Path, SvgText } from 'xunay/kit'

mount(() => div({ style: 'padding:24px;background:#111;color:#0f0;font:14px monospace' },
  div(null, '=== SVG 最小测试 ==='),
  div(null, '1: 蓝方块 (期望看到)'),
  Svg({ width: 200, height: 100, viewBox: '0 0 200 100' },
    Rect({ x: 20, y: 20, width: 80, height: 60, fill: '#3b82f6' }),
    Rect({ x: 110, y: 20, width: 80, height: 60, fill: '#22c55e' }),
    Circle({ cx: 50, cy: 90, r: 8, fill: '#ec4899' })
  ),
  div(null, '2: 文字在 SVG 里'),
  Svg({ width: 200, height: 60, viewBox: '0 0 200 60' },
    SvgText({ x: 20, y: 40, 'font-size': 20, fill: '#f59e0b' }, 'SVG TEXT 中文')
  ),
  div(null, '=== 测试结束 ===')
), '#app')
