// 性能报告
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("性能报告"),
    P("xunay 核心运行时的实测数据。"),
    H2("signal 操作"),
    Table(["操作","耗时","ops/s"], [["signal 创建","228 ns","4.4M"],["signal 读","128 ns","7.8M"],["signal 写（无订阅）","183 ns","5.5M"],["signal 写 → 触发 effect","650 ns","1.5M"],["computed 读","230 ns","4.3M"],["computed 写触发","1.3 µs","0.79M"],["batch 两写合并","4.8 µs","0.21M"]]),
    H2("对比 React"),
    Table(["操作","XuNay","React"], [["读状态","128 ns","Hook 调度 ~50 ns"],["写状态","183 ns","调度 + Diff ~50 µs"],["更新 1 个文本节点","1 µs","~10 µs ~ 5 ms"]]),
    H2("对比 Solid"),
    Table(["操作","XuNay","Solid"], [["signal 读","128 ns","50 ~ 100 ns"],["signal 写→触发","650 ns","200 ~ 300 ns"]]),
    P("Solid 用编译期优化——它知道每个 signal 在哪用，直接生成代码。xunay 纯运行时——依赖收集在运行时完成。这是架构差异，不是 bug。"),
    H2("包体积"),
    Table(["文件","gzip"], [["xunay.esm.js","5.9 KB"],["xunay.min.js","6.2 KB"],["xunay-kit.min.js","14.5 KB"],["xunay-devtools.min.js","3.9 KB"],["xunay-full.min.js","19.4 KB"]]),
    H2("1000 项列表"),
    Table(["操作","耗时"], [["首次渲染","~40 ms"],["追加 1 项","~0.5 ms"],["删除 1 项","~0.5 ms"],["改 1 项属性","~0.3 ms"],["全重排","~8 ms"]]),
    H2("性能瓶颈在哪"),
    P("真实应用里，性能瓶颈通常在："),
    Ul("网络请求（几十到几百 ms）","DOM 操作（每次 10~100 µs）","图片/字体加载（几百 ms）","第三方库"),
    P("signal 本身几乎不占时间——1000 次读才 0.13 ms。"),
  )
}
