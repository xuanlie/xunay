// 性能报告
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("性能报告"),
    P("xunay 核心运行时的实测数据。"),
    H2("signal 操作"),
    Table(["操作","耗时","ops/s"], [["signal 创建","440 ns","2.3M"],["signal 读","150 ns","6.8M"],["signal 写（无订阅）","180 ns","5.4M"],["signal 写 → 触发 effect","1.6 µs","0.62M"],["computed 读","210 ns","4.8M"],["computed 写触发","6.8 µs","0.15M"],["batch 两写合并","2.6 µs","0.38M"]]),
    H2("对比 React"),
    Table(["操作","XuNay","React"], [["读状态","150 ns","Hook 调度 ~50 ns"],["写状态","180 ns","调度 + Diff ~50 µs"],["更新 1 个文本节点","1 µs","~10 µs ~ 5 ms"]]),
    H2("对比 Solid"),
    Table(["操作","XuNay","Solid"], [["signal 读","150 ns","50 ~ 100 ns"],["signal 写→触发","1.6 µs","200 ~ 300 ns"]]),
    P("Solid 用编译期优化——它知道每个 signal 在哪用，直接生成代码。xunay 纯运行时——依赖收集在运行时完成。这是架构差异，不是 bug。"),
    H2("包体积"),
    Table(["文件","gzip"], [["xunay.esm.js","4.86 KB"],["xunay.min.js","5.09 KB"],["xunay-kit.min.js","14.43 KB"],["xunay-devtools.min.js","13.14 KB"],["xunay-full.min.js","18.35 KB"]]),
    H2("1000 项列表"),
    Table(["操作","耗时"], [["首次渲染","~5.6 ms"],["追加 1 项","~0.2 ms"],["删除 1 项","~0.15 ms"],["改 1 项属性","~0.27 ms"],["全重排","~2.1 ms"]]),
    H2("性能瓶颈在哪"),
    P("真实应用里，性能瓶颈通常在："),
    Ul("网络请求（几十到几百 ms）","DOM 操作（每次 10~100 µs）","图片/字体加载（几百 ms）","第三方库"),
    P("signal 本身几乎不占时间——1000 次读才 0.13 ms。"),
  )
}
