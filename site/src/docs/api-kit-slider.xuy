// kit: Slider
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: Slider"),
    P("kit 里的 Slider 组件。"),
    H2("引入"),
    Code("import { Slider } from 'xunay/kit/form'", "js"),
    H2("参数"),
    Table(["参数","类型","默认","说明"], [["disabled","——","false","禁用"],["max","——","100",""],["min","——","0",""],["onChange","——","——","回调"],["step","——","1",""],["value","——","——","可传 signal（响应式）"]]),
    H2("移动端"),
    P("原生拖动。"),
    H2("基础用法"),
    Code("import { Slider } from 'xunay/kit/form'\n\nSlider({ value: mySignal, onChange: () => {}, disabled: false })", "js"),
    H2("响应式"),
    P("这些参数可以直接传 signal，值变化时 DOM 会自动更新："),
    Code("import { signal } from 'xunay'\nimport { Slider } from 'xunay/kit/form'\n\nconst v = signal('')\n\nSlider({ value: v })", "js"),
    Tip("不要写成 value: v() —— 传函数给 render.js，让它挂 effect。"),
    Tip("完整组件清单见「Kit 组件 → Kit 组件 API」。"),
  )
}
