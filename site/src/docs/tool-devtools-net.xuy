// 网络面板
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("网络面板"),
    P("显示所有 fetch / XHR 请求，能看请求头、响应头、请求体、响应体。"),
    H2("列表"),
    Code("POST  200  /rpc/addTodo   14:32:05.123   342 B   18ms\nGET   200  /rpc/getTodos  14:32:05.100   2.4 KB  12ms\nGET   200  /rpc/token     14:32:04.988   76 B    8ms", "txt"),
    H2("列表列"),
    Table(["列","内容"], [["方法","GET / POST / PUT / PATCH / DELETE / HEAD"],["状态","HTTP 状态码（颜色区分）"],["URL","路径（紫色）"],["时间","毫秒级时间戳"],["大小","响应体字节数"],["耗时","请求到响应的时间"]]),
    H2("过滤"),
    P("顶部输入框，模糊匹配 URL / 方法 / 状态码："),
    Code("addTodo    → 只显示 URL 含 addTodo\nPOST       → 只显示 POST 请求\n200        → 只显示 200 状态\n/rpc/      → 只显示 rpc 接口", "txt"),
    H2("详情页"),
    P("点任一行进入详情页，6 个子 tab："),
    Table(["Tab","内容"], [["概览","方法、URL、状态、耗时、大小、类型、开始时间"],["请求头","所有请求头（键值对）"],["请求体","JSON 自动格式化"],["响应头","所有响应头"],["响应体","JSON 自动格式化（最多 16KB）"],["时间","等待响应 + 下载内容分解"]]),
    H2("复制功能"),
    Table(["位置","复制什么"], [["顶部大按钮","完整信息（头 + 体 + 时间）"],["每个 tab 标题","该 tab 的原始数据"]]),
    H2("主动发请求"),
    P("网络面板顶部有请求构造器——不用切 Postman："),
    Code("方法: POST\nURL:  /rpc/addTodo\n请求体: {\"title\":\"test\"}\n\n点发送 → 自动进列表", "txt"),
    H2("状态码颜色"),
    Table(["范围","颜色"], [["2xx","绿色"],["3xx","黄色"],["4xx","橙色"],["5xx","红色"],["进行中","灰色"]]),
  )
}
