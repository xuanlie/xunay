// kit: Gantt
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: Gantt"),
    P("kit 里的 Gantt 组件。"),
    H2("引入"),
    Code("import { Gantt } from 'xunay/kit/data'", "js"),
    H2("参数"),
    Table(["参数","类型","默认","说明"], [["days","——","——",""],["startDate","——","——",""],["tasks","——","——",""]]),
    H2("基础用法"),
    Code("import { Gantt } from 'xunay/kit/data'\n\nGantt({ /* see table above */ })", "js"),
    Tip("完整组件清单见「Kit 组件 → Kit 组件 API」。"),
  )
}
