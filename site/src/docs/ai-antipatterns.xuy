// 反模式
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("反模式"),
    P("最常见的错误写法 —— 及正确做法。AI 写代码时避免。"),
    H2("1. 静态求值"),
    Code("// 错\nspan(null, n())\ninput({ value: name() })\n\n// 对\nspan(null, () => n())\ninput({ value: () => name() })", "xuy"),
    H2("2. 少加 ()"),
    Code("// 错——显示函数本身\ndiv(null, () => n)\n\n// 对\ndiv(null, () => n())", "xuy"),
    H2("3. effect 里读又写"),
    Code("// 错——死循环\neffect(() => { n(n() + 1) })\n\n// 对——放事件里\nbutton({ on: { click: () => n(v => v + 1) } })", "xuy"),
    H2("4. 深层对象修改"),
    Code("// 错——引用没变，不触发\nconst u = signal({ a: { b: 1 } })\nu().a.b = 2\n\n// 对——整体替换\nu(u => ({ ...u, a: { ...u.a, b: 2 } }))", "xuy"),
    H2("5. 数组 push"),
    Code("// 错\ntodos().push({ id: 1 })\n\n// 对\ntodos(l => [...l, { id: 1 }])", "xuy"),
    H2("6. list 用索引做 key"),
    Code("// 错——重排时状态错乱\nlist(items, (i, idx) => idx, ...)\n\n// 对\nlist(items, i => i.id, ...)", "xuy"),
    H2("7. list 里做副作用"),
    Code("// 错——每次渲染都请求\nlist(items, i => i.id, i => {\n  fetch('/api/' + i.id)\n  return li(null, i.title)\n})\n\n// 对——副作用放 onMount\nlist(items, i => i.id, i => {\n  onMount(() => fetch('/api/' + i.id))\n  return li(null, i.title)\n})", "xuy"),
    H2("8. 模块顶层 onMount"),
    Code("// 错\nonMount(() => console.log('x'))\n\n// 对\nfunction App() {\n  onMount(() => console.log('x'))\n  return div(null, 'x')\n}", "xuy"),
    H2("9. 动态值里用 if 语句"),
    Code("// 错——不是表达式\ndiv(null, () => {\n  if (n() > 0) return '正'\n  return '负'\n})\n\n// 对——可以是表达式\ndiv(null, () => n() > 0 ? '正' : '负')", "xuy"),
    H2("10. show 条件传值"),
    Code("// 错\nshow(open(), () => div())\n\n// 对\nshow(() => open(), () => div())", "xuy"),
    H2("11. 属性值写成事件"),
    Code("// 错\nbutton({ onClick: handler })\n\n// 对\nbutton({ on: { click: handler } })", "xuy"),
    H2("12. 事件立即执行"),
    Code("// 错——立即执行了\nbutton({ on: { click: handler() } })\n\n// 对——传函数\nbutton({ on: { click: handler } })\n// 或\nbutton({ on: { click: () => handler() } })", "xuy"),
    H2("13. 组件里写副作用"),
    Code("// 错——每次父更新可能重跑\nfunction User({ id }) {\n  fetch('/api/user/' + id)\n  return div(null, 'x')\n}\n\n// 对——onMount\nfunction User({ id }) {\n  onMount(() => fetch('/api/user/' + id))\n  return div(null, 'x')\n}", "xuy"),
    H2("14. computed 里写 signal"),
    Code("// 错\nconst bad = computed(() => {\n  a(1)   // 副作用\n  return a()\n})\n\n// 对\nconst ok = computed(() => a() * 2)", "xuy"),
    H2("15. 忘记 onUnmount 清理"),
    Code("// 错——内存泄漏\nonMount(() => setInterval(tick, 1000))\n\n// 对\nonMount(() => {\n  const id = setInterval(tick, 1000)\n  onUnmount(() => clearInterval(id))\n})", "xuy"),
    H2("16. 用 React 的 props.key"),
    Code("// 错\nli({ key: t.id }, t.title)\n\n// 对\nlist(todos, t => t.id, t => li(null, t.title))", "xuy"),
    H2("17. 用 JSX"),
    Code("// 错\nreturn <div>hello</div>\n\n// 对\nreturn div(null, 'hello')", "xuy"),
    H2("18. 用 useEffect 依赖数组"),
    Code("// 错\neffect(() => { n() }, [n])\n\n// 对\neffect(() => { n() })", "xuy"),
    H2("19. 用 useMemo 手写依赖"),
    Code("// 错\nconst double = useMemo(() => n() * 2, [n])\n\n// 对\nconst double = computed(() => n() * 2)", "xuy"),
    H2("20. 忘记 target 的 #"),
    Code("// 错\nmount(App, 'app')\n\n// 对\nmount(App, '#app')", "xuy"),
  )
}
