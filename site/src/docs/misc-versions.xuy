// 版本
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("版本"),
    H2("当前"),
    Code("v1.0.1", "txt"),
    H2("版本规则"),
    Table(["版本","含义","示例"], [["主版本","破坏性变更","1.0.0 → 2.0.0"],["次版本","新增功能","1.0.0 → 1.1.0"],["补丁","bug 修复","1.0.0 → 1.0.1"]]),
    H2("语义化版本"),
    P("遵循 semver——主版本.次版本.补丁。"),
    H2("兼容性"),
    Ul("主版本内向后兼容","次版本不破坏旧 API","补丁不引入新功能"),
    H2("升级"),
    Code("npm install xunay@latest", "bash"),
    H2("版本历史"),
    Table(["版本","日期","说明"], [["v1.0.0","—","核心 + 全栈 + 四后端"],["v1.0.1","—","加固 + 优化 + 修复"]]),
    H2("发布渠道"),
    Table(["渠道","用途"], [["npm","正式发布"],["GitHub","源码"],["unpkg","CDN"],["jsdelivr","CDN"]]),
    H2("弃用策略"),
    P("弃用 API 会在次版本标记警告，下一个主版本移除。"),
  )
}
