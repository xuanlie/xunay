// 性能面板
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("性能面板"),
    P("显示页面加载性能——FCP / LCP / 请求分解 / 长任务。"),
    H2("核心指标"),
    Table(["指标","含义","目标"], [["FCP","首次内容绘制","< 1000ms"],["LCP","最大内容绘制","< 2500ms"],["DOM Ready","DOM 解析完成","< 1000ms"],["Load","所有资源加载完","< 2000ms"]]),
    H2("请求分解"),
    P("把页面加载请求拆成各阶段："),
    Code("┌──────────────────────────────────────┐\n│ ██ ██ ████ ██████ ███               │\n└──────────────────────────────────────┘\nDNS  2ms      下载    12ms\nTCP  1ms      DOM解析 8ms\nTTFB 15ms", "txt"),
    H2("运行时"),
    Table(["指标","说明"], [["JS 堆内存","当前用多少 / 上限"],["DOM 节点数","页面元素数量"],["资源数","加载的资源数量"],["长任务数","超过 50ms 的阻塞任务"]]),
    H2("长任务列表"),
    P("超过 50ms 的 JS 执行："),
    Code("187ms 时刻 · 187ms\n512ms 时刻 · 76ms\n843ms 时刻 · 62ms", "txt"),
    P(">200ms 标红，>100ms 标黄。"),
    H2("复制 JSON"),
    P("顶部按钮一键复制完整快照："),
    Code("{\n  \"capturedAt\": \"2026-10-02T02:45:50.085Z\",\n  \"url\": \"http://...\",\n  \"core\": { \"fcp\": 2000, \"lcp\": 2348, \"domReady\": 1965, \"load\": 1989 },\n  \"stages\": { \"dns\": 1.3, \"tcp\": 366, \"ttfb\": 379, \"download\": 4.2, \"domParse\": 36.6 },\n  \"runtime\": { \"jsHeap\": 11200000, \"domNodes\": 124, \"resources\": 2 },\n  \"longTasks\": [{ \"start\": 6536, \"duration\": 57 }],\n  \"requests\": [...],\n  \"signals\": [...]\n}", "json"),
    H2("注意"),
    Warn("FCP / LCP 是页面加载时采集的。打开 devtools 后要刷新一次才能看到完整数据。"),
    H2("实战"),
    H3("页面慢"),
    P("看 FCP / LCP 具体多少。"),
    H3("卡顿"),
    P("看长任务列表——哪段时间卡了。"),
    H3("内存泄漏"),
    P("反复操作，看 JS 堆是否持续涨。"),
  )
}
