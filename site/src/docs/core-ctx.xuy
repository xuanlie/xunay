// ctx
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("ctx"),
    P("ctx 是\"上下文\"——把值从祖先传给后代，避免层层传 props（prop drilling）。类似 React 的 Context，但更轻。"),
    H2("为什么需要它"),
    P("假设 User 数据在最顶层，深层子组件要用——一层层传 props 太啰嗦。ctx 让后代直接从上下文取。"),
    Code("// 不用 ctx\nfunction App() { return User() }\nfunction User() { return Layout({ user: userData }) }\nfunction Layout({ user }) { return Card({ user }) }\nfunction Card({ user }) { return div(null, user.name) }\n\n// 用 ctx\nconst UserCtx = ctx()\nfunction App() {\n  return UserCtx.provide(userData, () => User())\n}\nfunction Card() {\n  const user = UserCtx.get()\n  return div(null, user.name)\n}", "xuy"),
    H2("创建上下文"),
    Code("import { ctx } from 'xunay'\n\n// 创建时给一个默认值\nconst ThemeCtx = ctx('light')\nconst UserCtx = ctx(null)\nconst LocaleCtx = ctx('zh-CN')", "xuy"),
    H2("提供值"),
    P(".provide(value, fn) 在 fn 执行期间把 value 压入栈，fn 执行完自动弹出。"),
    Code("const ThemeCtx = ctx('light')\n\nThemeCtx.provide('dark', () => {\n  // 这里所有后代读 ThemeCtx.get() 都拿到 'dark'\n})\n// 出了 fn 之外，又是 'light'（默认）", "xuy"),
    H2("读取值"),
    P(".get() 从栈顶往下找最近一次 provide 的值。找不到用默认值。"),
    Code("const ThemeCtx = ctx('light')\n\nconsole.log(ThemeCtx.get())   // 'light'\n\nThemeCtx.provide('dark', () => {\n  console.log(ThemeCtx.get())   // 'dark'\n})\n\nconsole.log(ThemeCtx.get())   // 'light'", "xuy"),
    H2("完整例子：主题切换"),
    Code("import { ctx, div, button, signal, mount } from 'xunay'\n\nconst ThemeCtx = ctx('light')\n\nfunction Button() {\n  const theme = ThemeCtx.get()\n  return div({\n    class: 'btn',\n    style: {\n      background: theme === 'dark' ? '#333' : '#eee',\n      color: theme === 'dark' ? '#fff' : '#000'\n    }\n  }, '按钮 (' + theme + ')')\n}\n\nfunction Card() {\n  const theme = ThemeCtx.get()\n  return div({\n    style: { padding: '20px', background: theme === 'dark' ? '#222' : '#f5f5f5' }\n  },\n    '卡片',\n    Button(),\n    Button()\n  )\n}\n\nmount(() => {\n  const theme = signal('light')\n  return div(null,\n    button({ on: { click: () => theme(theme() === 'dark' ? 'light' : 'dark') } }, '切换主题'),\n    // 每次 theme 变，都重新 provide——后代读到新值\n    () => ThemeCtx.provide(theme(), () => Card())\n  )\n}, '#app')", "xuy"),
    H2("嵌套 provide"),
    P("可以嵌套——内层覆盖外层。"),
    Code("const Ctx = ctx('root')\n\nCtx.provide('outer', () => {\n  console.log(Ctx.get())   // 'outer'\n  Ctx.provide('inner', () => {\n    console.log(Ctx.get())   // 'inner'\n  })\n  console.log(Ctx.get())   // 'outer'\n})", "xuy"),
    H2("和 signal 组合"),
    P("ctx 传递的可以是 signal 本身，后代读 signal 就能响应式。"),
    Code("const UserCtx = ctx(null)\n\n// 祖先\nconst user = signal({ name: 'x' })\nUserCtx.provide(user, () => Card())\n\n// 后代\nfunction Card() {\n  const user = UserCtx.get()\n  return div(null, () => user().name)   // ✓ 响应式\n}", "xuy"),
    H2("ctx 的实现原理"),
    P("ctx 内部是一个全局栈。provide 时 push，fn 执行后 pop。get 从栈顶往下找。"),
    Code("// 伪代码\nconst stack = []\nfunction ctx(defaultValue) {\n  const id = Symbol()\n  return {\n    get() {\n      for (let i = stack.length - 1; i >= 0; i--)\n        if (stack[i].id === id) return stack[i].value\n      return defaultValue\n    },\n    provide(value, fn) {\n      stack.push({ id, value })\n      try { return fn() } finally { stack.pop() }\n    }\n  }\n}", "js"),
    H2("和 React Context 对比"),
    Table(["","xunay ctx","React Context"], [["创建","ctx(default)","createContext(default)"],["提供",".provide(v, fn)","<Provider value={v}>"],["读取",".get()","useContext(Ctx)"],["嵌套","自动","自动"],["响应式","传 signal 即可","value 变化触发重渲染"],["作用域","同步执行期","组件树"]]),
    H2("常见陷阱"),
    H3("陷阱 1：异步里读不到"),
    Code("Ctx.provide('x', async () => {\n  console.log(Ctx.get())   // 'x'\n  await sleep(100)\n  console.log(Ctx.get())   // ✗ 已经退出 provide，读不到 'x'\n})", "xuy"),
    P("ctx 是同步栈。await 之后栈已恢复，读不到当初的值。异步场景用闭包捕获或参数传递。"),
    H3("陷阱 2：忘记用返回值"),
    Code("// ✗ 丢掉了返回\n() => { Ctx.provide('dark', () => Card()) }\n\n// ✓ 返回 provide 的结果\n() => Ctx.provide('dark', () => Card())", "xuy"),
    P("在动态节点里，provide 的返回值（渲染结果）必须被返回，否则节点不挂载。"),
    H3("陷阱 3：模块顶层 provide"),
    Code("Ctx.provide('x', () => {})   // ✗ 立即执行然后立即返回\n// 什么也没发生", "xuy"),
    H2("完整示例：i18n"),
    Code("import { ctx, div, span, button, signal, mount } from 'xunay'\n\nconst dict = {\n  'zh-CN': { hello: '你好', bye: '再见' },\n  'en-US': { hello: 'Hello', bye: 'Bye' }\n}\n\nconst I18nCtx = ctx('zh-CN')\n\nfunction t(key) {\n  const locale = I18nCtx.get()\n  return dict[locale][key] || key\n}\n\nfunction Greeting() {\n  return div(null,\n    span(null, t('hello')),\n    button(null, t('bye'))\n  )\n}\n\nmount(() => {\n  const locale = signal('zh-CN')\n  return div(null,\n    button({ on: { click: () => locale('zh-CN') } }, '中文'),\n    button({ on: { click: () => locale('en-US') } }, 'English'),\n    () => I18nCtx.provide(locale(), () => Greeting())\n  )\n}, '#app')", "xuy"),
  )
}
