// 常见问题
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("常见问题"),
    P("第一次接触 xunay 会遇到的问题，一次说清。"),
    H2("为什么读 signal 要加 ()？"),
    P("signal 是一个函数。n() 是\"调用它读值\"，n(1) 是\"调用它写值\"。加 () 让读和写统一成一种语法——都是函数调用。"),
    Code("const n = signal(0)\nn()     // 读 → 0\nn(1)    // 写 → 1", "xuy"),
    P("配合\"动态值用函数包\"的规则，模板里写成 () => n()——第一个 () 是框架的约定，第二个是 signal 的调用。"),
    H2("为什么组件只执行一次？"),
    P("因为不需要重复执行。React 每次更新都要重跑组件函数、重建整棵 vnode 树、再 diff。xunay 把\"数据变化时做什么\"直接交给 effect——组件只负责构建一次 DOM 结构。"),
    Code("function Counter() {\n  const n = signal(0)\n  console.log('初始化')   // 只打印一次\n  return div(null, () => n())   // 这个函数每次都跑\n}", "xuy"),
    H2("不用 VDOM 怎么做更新？"),
    P("用 effect 精确追踪。当你在 effect 里读 n() 时，n 记录了\"谁在读我\"。n 变化时，通知那个 effect 重跑——而那个 effect 只改对应节点的 textContent。"),
    Code("// 组件里\nspan(null, () => n())\n\n// 框架内部（伪代码）\neffect(() => {\n  textNode.textContent = String(n())\n})\n// n 变 → effect 重跑 → 只改 textContent", "js"),
    H2("为什么不兼容 React？"),
    P("不是\"做不到\"，是\"不想做\"。兼容 React 意味着保留 VDOM、Hooks 依赖数组、组件重渲染等一堆历史包袱，最终变成另一个 React。xunay 选择从零设计。"),
    H2("依赖数组去哪了？"),
    P("xunay 用运行时依赖收集——effect 执行时读到哪些 signal，就自动订阅哪些。不用手写，也不会漏。"),
    Code("// React：必须手写依赖\nuseEffect(() => {\n  console.log(a, b)\n}, [a, b])   // 忘了写就是 bug\n\n// XuNay：自动\neffect(() => {\n  console.log(a(), b())\n})", "xuy"),
    H2("能在 .xuy 里用普通 JS 吗？"),
    P("能。.xuy 就是 JS——所有 JS 语法都能用。唯一区别：标签名（div、span、button）可以当函数直接调用，不用 import。"),
    Code("// app.xuy —— 可以直接写 div(...)\nconst n = signal(0)\nmount(() => div(null, button(null, () => String(n()))), '#app')", "xuy"),
    H2("怎么调试？"),
    P("用内置 devtools。它会显示所有 signal、effect、请求、日志。"),
    Code("import 'xunay/devtools'\n// 右下角出现悬浮按钮", "xuy"),
    H2("性能真有那么快？"),
    P("核心更新的量级："),
    Table(["操作","耗时"], [["signal 读","~150ns"],["signal 写（无订阅）","~180ns"],["触发 1 个 effect","~1.6 µs"],["更新 1 个文本节点","~1µs"],["React 更新组件","~50µs ~ 5ms"]]),
    P("真实应用里，瓶颈通常在 DOM 和网络，不在 signal。"),
    H2("和 Solid / Svelte 有什么区别？"),
    Table(["","Solid","Svelte","XuNay"], [["语法","JSX","模板","JS"],["编译","必须","必须","可选"],["运行时","~7KB","~2KB","~4.86KB"],["依赖收集","编译期","编译期","纯运行时"],["学习成本","中","中","低"]]),
    P("xunay 的核心差异：不依赖编译，纯运行时。可以直接当 JS 库用，也可以选 .xuy。"),
    H2("怎么发请求？"),
    P("用原生 fetch + signal。xunay 不发明自己的网络层。"),
    Code("const data = signal(null)\nconst loading = signal(true)\n\nonMount(async () => {\n  try {\n    data(await (await fetch('/api/todos')).json())\n  } finally {\n    loading(false)\n  }\n})", "xuy"),
    H2("怎么管理全局状态？"),
    P("signal 提到模块顶层就是全局状态。不用 Redux / Pinia。"),
    Code("// store.js\nexport const user = signal(null)\nexport const todos = signal([])\n\n// 组件里\nimport { user } from './store.js'\ndiv(null, () => user() ? user().name : '未登录')", "xuy"),
    H2("支持 TypeScript 吗？"),
    P("提供类型声明（types/xunay.d.ts）。但 xunay 本身不写 TS——设计哲学里明确\"不写 TS\"。类型对使用方是可选的。"),
    H2("和 jQuery / 原生 DOM 混用？"),
    P("可以。xunay 只是包装 DOM 操作，不霸占 document。可以用 ref 拿真实 DOM，交给 jQuery 或原生 API 处理。"),
    Code("const el = ref()\ndiv({ ref: e => el(e) })\n\nonMount(() => {\n  // 交给别的库\n  new SomeLibrary(el())\n})", "xuy"),
    H2("生产环境可以用吗？"),
    P("代码层面能跑，但生态还在早期。建议："),
    Ul("个人项目 / 内部工具：可以直接用","创业公司 MVP：可以用，配合 Vue 做复杂图表","大型团队 / 关键业务：观望，或用 React / Vue"),
    H2("为什么不发布到 npm？"),
    P("还没发布。目前是源码引用——把 core/dist 拷贝到项目里，或从 npm 装（等发布）。"),
    H2("怎么参与贡献？"),
    P("看「贡献指南」。"),
  )
}
