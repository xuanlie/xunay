// Babylon.js 集成
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("Babylon.js 集成"),
    P("XuNay × Babylon.js 全量集成。用声明式 JS 写 3D 场景, 属性值可直接放 signal, 自动订阅。打包后 bundle 12 KB (Babylon 从 CDN 加载)。"),
    H2("为什么选 Babylon.js"),
    Table(["对比","Godot Web","Babylon.js"], [["加载体积","8 MB gzip","CDN 1.4 MB + 自己 12 KB"],["首屏","5-15 秒","1-3 秒"],["开发","需 Godot 编辑器 + 导出","纯 JS, 改完即刷"],["调试","打包产物难调","源码直读"],["生态","GDScript 专用","TypeScript 全量 + Web 生态"]]),
    H2("快速上手"),
    Code("import { signal, effect } from 'xunay'\nimport { createScene, Box, Ground, adaptiveScaling, fpsMonitor } from 'xunay/babylon'\n\nconst x = signal(0)\nconst fps = signal(0)\n\nconst { engine, scene, onFrame } = createScene({\n  canvas: document.getElementById('cv'),\n  clearColor: [0.02, 0.02, 0.04, 1],\n  camera: { type: 'arc', radius: 10 },\n  light: false,\n})\n\n// 加光\ncreateLight({ type: 'hemi', intensity: 0.5 })\ncreateLight({ type: 'directional', direction: [-1,-2,-1], intensity: 1.2, shadows: true })\n\n// 加物体 (position 里直接放 signal)\nconst box = Box({\n  size: 1.2,\n  position: [x, 0, 0],\n  color: '#66ccff',\n  metallic: 0.7, roughness: 0.3,\n  castShadow: true,\n})\n\n// 每帧更新\nonFrame((dt) => x(x() + dt * 2))\n\n// 性能\nfpsMonitor(engine, fps, 500)\nadaptiveScaling(engine, { targetFps: 55 })", "js"),
    H2("加载 Babylon (CDN)"),
    P("不需要 npm 安装。在 HTML 里加 script 标签:"),
    Code("<link rel=\"preconnect\" href=\"https://cdn.babylonjs.com\" crossorigin>\n<link rel=\"preload\" href=\"https://cdn.babylonjs.com/babylon.js\" as=\"script\" crossorigin>\n<script src=\"https://cdn.babylonjs.com/babylon.js\"></script>\n<script src=\"https://cdn.babylonjs.com/materialsLibrary/babylonjs.materials.min.js\"></script>", "html"),
    H2("场景 createScene(opts)"),
    Table(["opt","默认","说明"], [["canvas","自动创建","DOM canvas"],["mount","document.body","canvas 挂载点"],["clearColor","[0.02,0.02,0.04,1]","背景色, 支持 hex/数组"],["camera","{type:\"arc\"}","见相机章节"],["light","true","默认半球光"],["fog","无","{color, density}"],["antialias","true","抗锯齿"],["adaptToDeviceRatio","true","Retina 适配"]]),
    P("返回 { canvas, engine, scene, camera, B, onFrame, beforeRender, afterRender, resize, dispose }。"),
    H2("相机 createCamera(opts)"),
    Table(["type","说明"], [["arc","弧形环绕 (默认), 支持拖拽旋转 / 滚轮缩放"],["free","自由飞行"],["universal","通用"],["follow","跟随目标"],["target","目标朝向"]]),
    H2("光 createLight(opts)"),
    Table(["type","说明"], [["hemi","半球光 (默认)"],["directional","平行光, 支持阴影"],["point","点光源"],["spot","聚光"]]),
    P("阴影: 传 shadows: { shadowMapSize, shadowBlurKernel }。"),
    H2("Mesh 工厂 (24 种)"),
    Table(["类型","说明"], [["Box / Sphere / Cylinder / Torus / TorusKnot","基础几何"],["Ground / GroundFromHeightMap","地面 / 高度图"],["Plane / Disc / Polygon / TiledPlane","平面类"],["IcoSphere / Capsule / Polyhedron","多面体"],["Lathe / Tube / Ribbon / ExtrudeShape","曲面"],["Lines / DashedLines","线"],["Text3D","3D 文字 (需 earcut)"],["Mesh(type, opts)","任意 MeshBuilder 类型"]]),
    H2("通用属性"),
    P("所有 Mesh 工厂支持:"),
    Table(["属性","类型"], [["name","string"],["position / rotation / scaling","[x,y,z] 或 signal"],["color / albedoColor / emissiveColor","hex / [r,g,b] 或 signal"],["metallic / roughness","number 或 signal"],["alpha","number 或 signal"],["size / diameter / width / height","number 或 signal"],["material","\"pbr\" / \"standard\" / 自定义"],["parent","另一个 mesh 或 { mesh }"],["castShadow / receiveShadow","boolean"],["billboardMode","true / BABYLON.Mesh.BILLBOARDMODE_ALL"],["onPointer","{ click, enter, leave, down, up }"]]),
    H2("材质"),
    Code("import { PBRMaterial, StandardMaterial, GridMaterial } from 'xunay/babylon'\n\nconst gm = GridMaterial({\n  majorUnitFrequency: 5,\n  mainColor: [0.1, 0.15, 0.25],\n  lineColor: [0.3, 0.5, 0.9],\n  opacity: 0.55,\n})\nmesh.mesh.material = gm", "js"),
    H2("动画 animate(opts)"),
    Code("animate({\n  target: mesh.mesh,\n  property: 'position',\n  from: [0, 0, 0],\n  to: [5, 0, 0],\n  duration: 1.5,\n  loop: false,\n  easing: 'SineEase',\n  onEnd: () => console.log('done'),\n})", "js"),
    H2("粒子 Particles(opts)"),
    Code("Particles({\n  capacity: 500,\n  emitter: sphere.mesh,\n  color1: [0.4, 0.8, 1.0, 1.0],\n  color2: [1.0, 0.4, 0.8, 1.0],\n  minSize: 0.05, maxSize: 0.2,\n  emitRate: 100,\n  gravity: [0, -9.8, 0],\n  direction1: [-1, 1, -1], direction2: [1, 1, 1],\n})", "js"),
    H2("交互 onPointer(opts)"),
    Code("onPointer({\n  mesh: box.mesh,\n  click: () => score(score() + 10),\n  enter: () => box.mesh.scaling = new BABYLON.Vector3(1.2, 1.2, 1.2),\n  leave: () => box.mesh.scaling = new BABYLON.Vector3(1, 1, 1),\n})", "js"),
    H2("资源加载 importMesh"),
    Code("const { meshes, animationGroups } = await importMesh('res/model.glb', {\n  onProgress: (e) => console.log(e.loaded / e.total),\n})\nmeshes.forEach(m => m.receiveShadows = true)", "js"),
    H2("性能"),
    Ul("fpsMonitor(engine, fpsSignal) — FPS 写入 signal","adaptiveScaling(engine, { targetFps: 55 }) — 帧率低时自动降分辨率","onFrame(fn) — 每帧回调 (dt 秒)","beforeRender / afterRender — 渲染前后","引擎会随页面隐藏自动暂停"),
    H2("响应式绑定 (低层)"),
    Code("import { bind, bindSet, bindTwoWay, bindColor } from 'xunay/babylon'\n\nbind(xSig, mesh.mesh.position, 'x')\nbindColor(colorSig, mat, 'albedoColor', BABYLON.Color3)\nbindTwoWay(angleSig, mesh.mesh, 'rotation')", "js"),
    H2("打包"),
    Code("npx esbuild main.js --bundle --minify --format=esm --target=es2022 \\\n  --outfile=dist/bundle.js --external:@babylonjs/*", "bash"),
    H2("Babylon 移动端适配"),
    P("集成内置移动端触摸手势 + 性能预设, 一行启用。"),
    Code("import { setupTouchGestures, isMobile, mobilePreset } from 'xunay/babylon'\n\nconst { engine, scene } = createScene({ canvas, ... })\n\nif (isMobile()) {\n  mobilePreset(engine, { scale: 2 })  // 半分辨率, 省电省热\n}\n\nsetupTouchGestures(canvas, null, {\n  speed: 1.2,\n  minRadius: 4, maxRadius: 35,\n})", "js"),
    H3("手势支持"),
    Table(["手势","动作"], [["单指拖拽","旋转相机 (alpha/beta)"],["双指捏合","缩放相机 (radius)"],["双指旋转","绕 Y 轴转 (alpha)"]]),
    H3("移动端预设"),
    Table(["功能","说明"], [["isMobile()","检测 UA + touch + 屏幕宽"],["mobilePreset(engine)","半分辨率渲染, 省电"],["setupTouchGestures()","接管 canvas 触摸, 自动禁用相机内置控制"],["damping","给移动惯性 (可选)"]]),
    H3("CSS 适配清单"),
    P("移动端必须处理的 CSS:"),
    Code("html, body {\n  height: 100dvh;              /* iOS 顶栏兼容 */\n  touch-action: none;          /* 禁双击缩放 */\n  overscroll-behavior: none;   /* 禁边缘回弹 */\n  -webkit-touch-callout: none; /* 禁长按菜单 */\n  user-select: none;           /* 禁文字选择 */\n  -webkit-tap-highlight-color: transparent;\n}\n\n#hud {\n  padding: 16px;\n  padding-top: calc(16px + env(safe-area-inset-top, 0px));\n  padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));\n}", "css"),
    H3("虚拟摇杆"),
    P("移动端用 DOM 层实现摇杆, 输出归一化向量 [-1, 1], 直接喂给玩家移动:"),
    Code("const joy = signal([0, 0])\n\n// 在游戏循环里读\nonFrame((dt) => {\n  const [jx, jz] = joy()\n  player.mesh.position.x += jx * SPEED * dt\n  player.mesh.position.z += jz * SPEED * dt\n})", "js"),
    H3("触摸目标尺寸"),
    Ul("按钮最小 44x44 px (iOS HIG 标准)","滑杆触摸区域 ≥ 32 px 高","摇杆 140x140 px, 内圆点 60x60 px","禁用 hover 效果 (@media (hover: none))"),
    H3("性能优化"),
    Ul("mobilePreset 降分辨率到 50%: FPS 提升 2-3 倍","关阴影 / 关抗锯齿: 移动端 GPU 弱","fpsMonitor 目标 45 fps (省电)","页面隐藏时自动暂停渲染"),
    Tip("Babylon 走 CDN, 不打包进 bundle。自带代码 12 KB (gzip 3 KB)。"),
    Warn("需要 HTTPS 或 localhost。getUserMedia / WebXR 等 API 才需要 Secure Context, 普通 3D 渲染 HTTP 也可以用。"),
  )
}
