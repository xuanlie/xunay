// 设计哲学
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("设计哲学"),
    P("xunay 的核心不是\"技术领先\"，是\"有意识地做减法\"。"),
    H2("五条原则"),
    Ul("不发明新语法——.xuy 就是 JS","不做无用抽象——只有 signal 和元素","不保留历史包袱——不兼容 React","不用编译期魔法——纯运行时依赖收集","不追求万能——90% 场景够用就好"),
    H2("为什么要\"不做\""),
    P("React 47KB / Vue 34KB——每个功能都是负担。用户每次看文档、每次调试 bug，都在为这些功能付出成本。"),
    Quote("每去掉一层抽象，就少一份认知负担，少一次性能损耗，少一类边界 bug。"),
    H2("和主流框架的取舍"),
    Table(["框架","核心","代价"], [["React","组件重渲染 + VDOM","概念多、性能一般"],["Vue","编译 + 响应式","需要编译、生态绑定"],["Solid","编译期响应式","必须编译、调试难"],["Svelte","编译 + 无运行时","编译复杂、限制多"],["XuNay","纯运行时响应式","无生态、无编译优化"]]),
    H2("三条\"不做\""),
    H3("不做 SSR 框架"),
    P("SSR 是工具，不是框架级功能。给 renderToString 和 hydrate，让用户自己决定怎么用。"),
    H3("不做状态管理"),
    P("signal 提到模块顶层就是全局状态。不需要 Redux / Pinia。"),
    H3("不做路由"),
    P("20 行代码能写出来的东西不做框架内置。"),
    H2("什么时候不用 xunay"),
    Ul("需要庞大生态（Ant Design 那种）","需要 SSR + 复杂数据层","团队已经熟悉 React / Vue","需要面试时\"用了什么\""),
    H2("什么时候用"),
    Ul("个人项目 / 小工具","内部后台 / 仪表盘","想学\"响应式的本质\"","想要最小心智模型"),
  )
}
