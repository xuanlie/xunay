// 从 React 迁移
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("从 React 迁移"),
    P("如果你熟悉 React，这份文档帮你 30 分钟切换到 xunay。核心概念基本一一对应，但有几个关键区别。"),
    H2("API 对照速查"),
    Table(["React","XuNay","备注"], [["useState(0)","signal(0)","读用 n() 不是 n"],["setN(1)","n(1)","没有 set 前缀"],["setN(v => v+1)","n(v => v+1)","一样"],["useMemo(fn, deps)","computed(fn)","无依赖数组"],["useEffect(fn, deps)","effect(fn)","无依赖数组"],["useEffect(fn, [])","onMount(fn)","只挂载时跑"],["useEffect(() => fn, [])","onUnmount(fn)","只卸载时跑"],["useRef()","ref()","一样"],["useContext","ctx()","更简单"],["React.memo","不需要","自动精确更新"],["useCallback","不需要","组件只跑一次"],["createRoot().render()","mount()","更简单"],["React.lazy","lazy()","一样"],["<Suspense>","show(loading, ...)","手动控制"]]),
    H2("第一个例子：计数器"),
    Code("// ===== React =====\nfunction Counter() {\n  const [n, setN] = useState(0)\n  return (\n    <div>\n      <button onClick={() => setN(n - 1)}>-</button>\n      <span>{n}</span>\n      <button onClick={() => setN(n + 1)}>+</button>\n    </div>\n  )\n}\n\n// ===== XuNay =====\nfunction Counter() {\n  const n = signal(0)\n  return div(null,\n    button({ on: { click: () => n(v => v - 1) } }, '-'),\n    span(null, () => n()),\n    button({ on: { click: () => n(v => v + 1) } }, '+')\n  )\n}", "xuy"),
    H2("关键区别 1：读 signal 加 ()"),
    Code("// React\n<span>{n}</span>\n\n// XuNay\nspan(null, () => n())\n//             ↑ 加 ()\n//      ↑ 加函数包", "xuy"),
    H2("关键区别 2：没有依赖数组"),
    Code("// React：必须手动写依赖\nuseEffect(() => {\n  console.log(a, b)\n}, [a, b])   // 忘了写就是 bug\n\n// XuNay：自动收集\nеffect(() => {\n  console.log(a(), b())\n})   // 自动订阅 a、b", "xuy"),
    H2("关键区别 3：组件只执行一次"),
    Code("// React：每次 count 变，整个组件重跑\nfunction List() {\n  const [items, setItems] = useState([])\n  console.log('渲染')   // 每次 items 变都打印\n  const total = items.reduce((s, i) => s + i.price, 0)   // 每次重算\n  return <div>{total}</div>\n}\n\n// XuNay：只跑一次\nfunction List() {\n  const items = signal([])\n  console.log('初始化')   // 只打印一次\n  const total = computed(() => items().reduce((s, i) => s + i.price, 0))\n  return div(null, () => total())\n}", "xuy"),
    H2("关键区别 4：不需要 useCallback / useMemo"),
    Code("// React：怕重复创建，需要 memo\nconst handleClick = useCallback(() => {\n  setN(n => n + 1)\n}, [])\nconst total = useMemo(() => items.reduce(...), [items])\n\n// XuNay：想怎么建就怎么建\nconst handleClick = () => n(v => v + 1)\nconst total = computed(() => items().reduce(...))", "xuy"),
    H2("关键区别 5：没有 key"),
    Code("// React\n{items.map(i => <li key={i.id}>{i.title}</li>)}\n\n// XuNay\nlist(items, i => i.id, i => li(null, i.title))\n//        ↑ key 函数", "xuy"),
    H2("useEffect 三种场景的替换"),
    H3("挂载时执行一次"),
    Code("// React\nuseEffect(() => {\n  fetchData()\n}, [])\n\n// XuNay\nonMount(() => {\n  fetchData()\n})", "xuy"),
    H3("依赖变化时执行"),
    Code("// React\nuseEffect(() => {\n  console.log(a, b)\n}, [a, b])\n\n// XuNay\neffect(() => {\n  console.log(a(), b())\n})", "xuy"),
    H3("挂载/卸载各执行一次"),
    Code("// React\nuseEffect(() => {\n  const id = setInterval(tick, 1000)\n  return () => clearInterval(id)\n}, [])\n\n// XuNay\neffect(() => {\n  const id = setInterval(tick, 1000)\n  return () => clearInterval(id)\n})", "xuy"),
    H2("Context 对比"),
    Code("// React\nconst ThemeCtx = createContext('light')\n\n<ThemeCtx.Provider value=\"dark\">\n  <Card />\n</ThemeCtx.Provider>\n\nfunction Card() {\n  const theme = useContext(ThemeCtx)\n}\n\n// XuNay\nconst ThemeCtx = ctx('light')\n\nThemeCtx.provide('dark', () => Card())\n\nfunction Card() {\n  const theme = ThemeCtx.get()\n}", "xuy"),
    H2("常见 React 模式的 XuNay 写法"),
    H3("受控输入"),
    Code("// React\nconst [value, setValue] = useState('')\n<input value={value} onChange={e => setValue(e.target.value)} />\n\n// XuNay\nconst value = signal('')\ninput({ value: () => value(), on: { input: e => value(e.target.value) } })", "xuy"),
    H3("列表渲染"),
    Code("// React\n<ul>\n  {todos.map(t => (\n    <li key={t.id} className={t.done ? 'done' : ''}>\n      <input type=\"checkbox\" checked={t.done} onChange={() => toggle(t.id)} />\n      {t.title}\n    </li>\n  ))}\n</ul>\n\n// XuNay\nul(null,\n  list(todos, t => t.id, t => li({ class: () => t.done ? 'done' : '' },\n    input({ type: 'checkbox', checked: () => t.done, on: { change: () => toggle(t.id) } }),\n    t.title\n  ))\n)", "xuy"),
    H3("条件渲染"),
    Code("// React\n{loading ? <Spinner /> : <Content data={data} />}\n\n// XuNay\nshow(() => loading(), () => Spinner({}), () => Content({ data: data() }))\n// 或\n() => loading() ? Spinner({}) : Content({ data: data() })", "xuy"),
    H3("错误边界"),
    Code("// React\nclass ErrorBoundary extends React.Component { ... }\n\n// XuNay\nerr(() => risky(), () => div(null, '出错了'))", "xuy"),
    H2("不需要的东西"),
    Ul("useCallback / useMemo（组件只跑一次）","React.memo（自动精确更新）","useReducer（signal + 手写 reducer）","Hooks 顺序规则（没有 hooks）","依赖数组（自动收集）","StrictMode（无双重渲染）","Portals（直接操作 DOM）","Fragments 的 <></> 语法（用 frag）"),
    H2("迁移清单"),
    Table(["步骤","操作"], [["1","npm install xunay"],["2","把 useState 换成 signal"],["3","把 setN(x) 换成 n(x)"],["4","把读值改成 n()"],["5","把 useEffect 换成 effect / onMount"],["6","把 useMemo 换成 computed"],["7","把 .map 换成 list"],["8","把 && / 三目换成 show"],["9","删掉 useCallback / memo / useRef 包装"],["10","把 <div>...</div> 换成 div(null, ...)"]]),
    H2("迁移示例：Todo"),
    Code("// ===== React 版本 =====\nfunction Todo() {\n  const [todos, setTodos] = useState([])\n  const [draft, setDraft] = useState('')\n  const add = () => {\n    setTodos([...todos, { id: Date.now(), title: draft }])\n    setDraft('')\n  }\n  const toggle = id => setTodos(todos.map(t => t.id === id ? { ...t, done: !t.done } : t))\n\n  return (\n    <div>\n      <input value={draft} onChange={e => setDraft(e.target.value)} />\n      <button onClick={add}>添加</button>\n      <ul>\n        {todos.map(t => (\n          <li key={t.id}>\n            <input type=\"checkbox\" checked={t.done} onChange={() => toggle(t.id)} />\n            {t.title}\n          </li>\n        ))}\n      </ul>\n    </div>\n  )\n}\n\n// ===== XuNay 版本 =====\nfunction Todo() {\n  const todos = signal([])\n  const draft = signal('')\n  const add = () => {\n    todos(list => [...list, { id: Date.now(), title: draft() }])\n    draft('')\n  }\n  const toggle = id => todos(list => list.map(t => t.id === id ? { ...t, done: !t.done } : t))\n\n  return div(null,\n    input({ value: () => draft(), on: { input: e => draft(e.target.value) } }),\n    button({ on: { click: add } }, '添加'),\n    ul(null,\n      list(todos, t => t.id, t => li(null,\n        input({ type: 'checkbox', checked: () => t.done, on: { change: () => toggle(t.id) } }),\n        t.title\n      ))\n    )\n  )\n}", "xuy"),
    H2("适应期常见错误"),
    H3("错误 1：忘了 ()"),
    Code("// 错误：忘加 ()\ndiv(null, () => n)\n\n// 正确\ndiv(null, () => n())", "xuy"),
    H3("错误 2：直接传值而不是函数"),
    Code("// 错误：立即求值\ndiv(null, n())\n\n// 正确\ndiv(null, () => n())", "xuy"),
    H3("错误 3：在 effect 里读又写"),
    Code("// 错误：死循环\neffect(() => {\n  n(n() + 1)\n})\n\n// 正确：放事件回调\nbutton({ on: { click: () => n(v => v + 1) } })", "xuy"),
  )
}
