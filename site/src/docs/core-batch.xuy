// batch
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("batch"),
    P("batch 把多次 signal 写合并成一次更新。括号里的代码执行完，订阅者只收到一次通知——即使中间改了好几次。"),
    H2("为什么需要它"),
    P("假设一个按钮同时改 3 个 signal，不 batch 的话，每个 signal 变都会触发一次 effect 重跑——3 次渲染。用 batch 包起来，只渲染 1 次。"),
    Code("import { signal, effect, batch } from 'xunay'\n\nconst a = signal(0)\nconst b = signal(0)\nconst c = signal(0)\n\neffect(() => {\n  console.log('重跑:', a(), b(), c())\n})\n// 立即打印: 0 0 0\n\n// 不加 batch：跑 3 次\na(1)   // 重跑 → 1 0 0\nb(2)   // 重跑 → 1 2 0\nc(3)   // 重跑 → 1 2 3\n\n// 加 batch：跑 1 次\nbatch(() => {\n  a(10)\n  b(20)\n  c(30)\n})\n// 只重跑一次 → 10 20 30", "xuy"),
    H2("基础用法"),
    Code("import { batch } from 'xunay'\n\nbatch(() => {\n  n(1)\n  m(2)\n  k(3)\n})\n// 三个 signal 都改完，才通知订阅者一次", "xuy"),
    H2("什么时候用"),
    Table(["场景","要不要 batch"], [["一个事件里改多个 signal","✓ 强烈建议"],["只改一个 signal","不需要（本来就 1 次）"],["批量导入数据","✓"],["初始化状态","✓ 但通常只在 setup 里跑一次"],["循环里改 signal","✓ 否则循环 1000 次就重跑 1000 次"]]),
    H2("经典场景：批量初始化"),
    Code("// 不好：7 次更新\nuser(user => ({ ...user, name: 'x' }))\ntodos([...list, item1])\ntodos([...list, item2])\n// ... 每个都触发一次 effect\n\n// 好：1 次更新\nbatch(() => {\n  user(u => ({ ...u, name: 'x' }))\n  todos([...list, item1])\n  todos([...list, item2])\n  // ...\n})", "xuy"),
    H2("嵌套 batch"),
    P("batch 可以嵌套。内层 batch 结束时不会触发更新，只有最外层结束时才真正 flush。"),
    Code("batch(() => {\n  a(1)\n  batch(() => {\n    b(2)\n    c(3)\n  })\n  d(4)\n})\n// 全部改完才更新一次", "xuy"),
    P("实现上是一个深度计数器 runtime.batchDepth——进 batch 加 1，出 batch 减 1，减到 0 才真正跑 effect。"),
    H2("与 requestAnimationFrame 的关系"),
    P("batch 只解决\"同一 tick 内的合并\"。如果你希望把跨 tick 的多次更新合并到一帧里跑，用 requestAnimationFrame 配合 batch："),
    Code("let pending = false\nconst queue = []\n\nfunction scheduleUpdate() {\n  if (pending) return\n  pending = true\n  requestAnimationFrame(() => {\n    batch(() => {\n      for (const fn of queue) fn()\n      queue.length = 0\n    })\n    pending = false\n  })\n}", "xuy"),
    H2("性能实测"),
    Table(["场景","不 batch","加 batch"], [["改 3 个 signal（3 个订阅者）","3 次 effect","1 次 effect"],["循环 1000 次改同一 signal","1000 次","1 次"],["导入 100 条数据","100 次","1 次"]]),
    P("实测：单次 batch 调用的开销约 3~5 微秒。如果不加 batch 要跑 100 次 effect，那就省了 100 倍。"),
    H2("常见陷阱"),
    H3("陷阱 1：在 batch 里 await"),
    Code("batch(async () => {\n  a(1)\n  await something()\n  b(2)   // ✗ await 之后 batch 已经退出了\n})", "xuy"),
    P("batch 只在同步执行期生效。await 会让执行权交出去，batch 深度已经归零，后续改动会立即触发。"),
    H3("陷阱 2：以为 batch 会合并\"值\""),
    Code("batch(() => {\n  a(1)\n  a(2)\n  a(3)\n})\n// a 的最终值是 3，中间值 1 和 2 不会被 effect 看到\n// 但如果有其他代码读了中间值，那个读取不会被回滚", "xuy"),
    P("batch 只合并\"触发\"，不合并\"值的历史\"。effect 重跑时读到的是最新值，不是中间值。"),
    H3("陷阱 3：在 batch 里读 signal 的旧值"),
    Code("const n = signal(0)\nbatch(() => {\n  n(1)\n  console.log(n())   // 已经读到 1，不是 0\n  n(2)\n  console.log(n())   // 读到 2\n})", "xuy"),
    P("batch 只延迟 effect 的重跑，不延迟 signal 本身的写。你写进去立刻能读到。"),
    H2("在 effect 里自动 batch"),
    P("effect 重跑期间，任何 signal 的写都会自动进 pendingEffects 队列——等 effect 跑完才处理。所以不用手动 batch。"),
    Code("effect(() => {\n  a()\n  b(10)   // 写 b，但 b 的订阅者会排到队列里\n  c(20)   // 同上\n})\n// effect 退出后，队列里所有 effect 一起跑", "xuy"),
    H2("完整示例：表单批量提交"),
    Code("import { signal, batch, div, button, input, span, mount } from 'xunay'\n\nfunction Form() {\n  const name = signal('')\n  const email = signal('')\n  const agree = signal(false)\n  const submitting = signal(false)\n  const msg = signal('')\n\n  async function submit() {\n    // 提交前先重置所有 UI 状态——用 batch 一次到位\n    batch(() => {\n      submitting(true)\n      msg('')\n    })\n\n    try {\n      const r = await fetch('/api/signup', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ name: name(), email: email(), agree: agree() })\n      })\n      if (!r.ok) throw new Error('HTTP ' + r.status)\n      batch(() => {\n        submitting(false)\n        msg('提交成功')\n        name('')\n        email('')\n        agree(false)\n      })\n    } catch (e) {\n      batch(() => {\n        submitting(false)\n        msg('失败: ' + e.message)\n      })\n    }\n  }\n\n  return div(null,\n    input({ value: () => name(), on: { input: e => name(e.target.value) }, placeholder: '姓名' }),\n    input({ value: () => email(), on: { input: e => email(e.target.value) }, placeholder: '邮箱' }),\n    button({ on: { click: submit }, disabled: () => submitting() }, '提交'),\n    span(null, () => msg())\n  )\n}\n\nmount(() => Form(), '#app')", "xuy"),
    H2("下一步"),
    P("读 element 了解 vnode 和标签工厂，或看 list 学习列表渲染。"),
  )
}
