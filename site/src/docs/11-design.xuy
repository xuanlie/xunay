// 设计理念
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("设计理念"),
    P("xunay 的核心是\"做减法\"——每去掉一层抽象，就少一份认知负担、一次性能损耗、一类边界 bug。"),
    H2("五个原则"),
    Ul("不发明新语法（.xuy 就是 JS）","不做无用的抽象（只有 signal 和元素）","不保留历史包袱（不兼容 React）","不用编译期魔法（纯运行时依赖收集）","不追求万能（90% 场景够用就好）"),
    H2("不做清单"),
    Table(["不做","原因"], [["不兼容 React","保留 VDOM 就没法做精确更新"],["不用 TS","类型在框架内部是负担"],["不用 Hooks 链表","Scope 树更简单更可靠"],["不用 Fiber","同步渲染够快，不需要调度"],["不用 diff","精确更新能省掉整个算法"],["不搞分层","一层解决，不堆中间件"],["不做大而全","核心小，功能可选"]]),
    H2("为什么是\"信号\"不是\"状态\""),
    P("\"状态\"是值，\"信号\"是\"会通知的值\"。区别在于：状态需要框架去比较（diff），信号自己知道什么时候变、谁在听。"),
    Code("// 状态：框架需要遍历对比\nconst state = { n: 0 }\n// ...\n// <div>n = {state.n}</div>   → diff 对比\n\n// 信号：值自己通知\neffect(() => {\n  textNode.textContent = 'n = ' + n()\n})\n// n 变 → 直接调用这个 effect", "xuy"),
    H2("为什么\"组件只执行一次\""),
    P("React 的模型是\"状态变 → 重跑组件 → 重建 vnode → diff → 更新 DOM\"。这条链上有两次遍历（重建 + diff）都可以省掉。"),
    Code("// React：3 次遍历\n// 1. 组件函数重跑\n// 2. 生成 vnode 树\n// 3. diff 新旧树\n\n// XuNay：0 次遍历\n// 状态变 → effect 直接改 DOM", "xuy"),
    H2("为什么\"纯运行时\""),
    P("编译期优化需要\"静态分析代码\"——分析不了的情况（动态属性、条件依赖、运行时计算）就退化成运行时。xunay 直接放弃编译期，用最简单的运行时模型。"),
    P("好处："),
    Ul("代码就是代码，没有编译魔法","调试时看到的就是执行的","可以直接在浏览器 Console 里跑","不需要构建工具"),
    H2("为什么核心这么小"),
    P("核心只做一件事：把\"数据变\"映射到\"DOM 变\"。UI 组件、动画、表单、SSR 都是可选的，不塞进核心。"),
    Table(["模块","gzip"], [["核心","4.7 KB"],["kit（UI 组件）","14.5 KB"],["devtools","10 KB"],["anim","1.3 KB"]]),
    P("核心 4.7 KB——比 Preact 略大，比 Solid 小。"),
    H2("为什么和别家都不一样"),
    Table(["框架","核心思想","代价"], [["React","组件重渲染 + VDOM","概念多、性能一般"],["Vue","编译 + 响应式","需要编译、生态绑定"],["Solid","编译期响应式","必须编译、调试难"],["Svelte","编译 + 无运行时","编译复杂、限制多"],["XuNay","纯运行时响应式","无生态、无编译优化"]]),
    H2("有意识的取舍"),
    P("xunay 不是\"更好的 React\"，是\"另一条路\"。"),
    H3("要什么"),
    Ul("极简的心智模型","可预测的性能","零编译依赖","可调式的运行时"),
    H3("放弃什么"),
    Ul("生态（没有第三方组件库）","编译期优化（无 Svelte 那种特化）","调试工具链（Chrome 扩展等）","大规模验证（没人用它做百万用户应用）"),
    H2("一句话总结"),
    Quote("React 是 2013 年的回答，Vue 是 2014 年的回答，Svelte 是 2016 年的回答。xunay 是现在的回答——用最直接的方式，解决 90% 的前端问题。"),
  )
}
