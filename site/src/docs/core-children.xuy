// 子节点
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("子节点"),
    Warn("本页讲的是运行时模式。默认的编译模式（compiler3）下，.xuy 文件里的 div() / span() 会在编译期直接生成 document.createElement，不经过本页描述的 vnode。只有手写 render(vnode) 或文件头写 // @runtime 才走 vnode 路径。"),
    P("子节点是元素的\"内容\"。可以是文本、数字、嵌套元素、动态函数、列表、条件——xunay 自动判断类型并做对应处理。"),
    H2("六种子节点类型"),
    Table(["类型","例子","处理方式"], [["字符串","\"hello\"","创建文本节点，永不更新"],["数字","42","转字符串建文本节点"],["vnode","h1(null, \"标题\")","递归渲染成 DOM"],["函数","() => n()","建 effect，值变化时更新"],["列表","list(arr, key, fn)","keyed diff"],["条件","show(cond, fn)","挂载/卸载切换"]]),
    H2("静态子节点"),
    Code("div(null,\n  '文本',\n  42,\n  true ? h1(null, 'yes') : h1(null, 'no'),\n  h1(null, '嵌套')\n)", "xuy"),
    P("这些都只 render 一次，后续永不更新。"),
    H2("动态子节点"),
    Code("const n = signal(0)\n\ndiv(null,\n  () => n(),                  // 动态文本\n  () => 'n = ' + n(),          // 动态字符串\n  () => n() > 0 ? '正' : '负',  // 动态条件（短字符串）\n  () => n() > 0 ? h1(null, '正') : h1(null, '负')  // 动态元素\n)", "xuy"),
    H2("函数返回不同类型的行为"),
    P("函数返回什么是关键——渲染器会按类型分派。"),
    Table(["返回","行为"], [["字符串/数字","建文本节点，只改 textContent"],["vnode","整块重建（每次依赖变都重建 DOM）"],["null / false","建空文本节点"],["列表对象","走 applyList"],["show 对象","走 renderShow"]]),
    Warn("函数返回 vnode 每次都会重建整块。大子树别放函数里——用 show 或 list 替代。"),
    H2("fragment 多节点"),
    Code("import { frag } from 'xunay'\n\nfrag(\n  h1(null, '标题'),\n  p(null, '正文'),\n  button(null, '按钮')\n)", "xuy"),
    P("frag 不产生真实 DOM 节点（内部用 display:contents 的 span 做占位）。"),
    H2("children 的排序"),
    Code("div(null, 'a', 'b', 'c')\n// 输出三个子节点：a、b、c\n\ndiv(null, () => n(), '常量')\n// 第一个是动态，第二个是静态", "xuy"),
    H2("空子节点"),
    Code("div(null)                  // 无子节点\ndiv(null, null)             // 忽略 null\ndiv(null, false)            // 忽略 false\ndiv(null, undefined)        // 忽略\ndiv(null, '')               // 空字符串也是文本节点", "xuy"),
    H2("子节点里的函数执行时机"),
    P("框架构建元素时，遇到函数会先执行一次，判断返回类型。这次执行被\"隔离\"了——它读的 signal 不会污染父 effect（这是之前修过的 bug）。"),
    Code("const n = signal(0)\ndiv(null,\n  () => n()   // 探针执行时读 n，但不订阅父级\n)\nn(1)   // 只会重跑这个函数节点，父 div 不动", "xuy"),
    H2("children 与 key"),
    P("xunay 没有 React 那种 key 属性。列表用 list(arr, keyFn, fn)，key 由 keyFn 显式提供。"),
    Code("list(items, i => i.id, i => li(null, i.title))\n//         ↑ key 函数", "xuy"),
    H2("嵌套结构"),
    Code("div({ class: 'card' },\n  div({ class: 'header' },\n    h1(null, '标题'),\n    span(null, '副标题')\n  ),\n  div({ class: 'body' },\n    p(null, '正文内容'),\n    ul(null,\n      li(null, '第一项'),\n      li(null, '第二项')\n    )\n  )\n)", "xuy"),
    H2("常见的 children 模式"),
    H3("条件内容"),
    Code("show(() => user(), () => div(null, '你好，' + user().name))\n// 或\n() => user() ? div(null, '你好') : null", "xuy"),
    P("两者都可。show 更省内存（切换时 scope 干净），三目更短。"),
    H3("列表 + 空态"),
    Code("div(null,\n  show(() => items().length === 0, () => p(null, '暂无数据')),\n  ul(null, list(items, i => i.id, i => li(null, i.title)))\n)", "xuy"),
    H3("动态子节点数量"),
    Code("div(null,\n  ...items.map(i => li(null, i.title))   // 静态展开，items 变了不会更新\n)\n// 想要响应，用 list", "xuy"),
    Warn("...items.map 展开是静态的。items 后来变了不会重新展开——每次都要用 list。"),
    H2("性能"),
    Table(["子节点","每次父更新成本"], [["静态文本","0"],["静态 vnode","0"],["动态文本函数","1 次 textContent 赋值"],["动态 vnode 函数","整块 DOM 重建"],["list","keyed diff，只动变化项"]]),
    H2("完整示例：多层评论树"),
    Code("import { div, span, p, button, signal, list, show, mount } from 'xunay'\n\nconst comments = signal([\n  { id: 1, user: '小明', text: '真不错', replies: [\n    { id: 11, user: '小红', text: '同意' }\n  ]}\n])\n\nfunction Comment({ c }) {\n  return div({ class: 'comment' },\n    div({ class: 'head' }, span(null, c.user)),\n    p(null, c.text),\n    show(() => c.replies && c.replies.length, () =>\n      div({ class: 'replies' },\n        list(c.replies, r => r.id, r => Comment({ c: r }))\n      )\n    )\n  )\n}\n\nmount(() => div(null,\n  list(comments, c => c.id, c => Comment({ c }))\n), '#app')", "xuy"),
  )
}
