// 动画
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("动画"),
    P("XuNay 提供 228 个动画相关导出：151 个预设 + 40 个缓动函数 + 9 个核心函数 + 15 个触发工具 + 5 个文本动画 + 10 个 SVG / 技术动画 + 4 个物理动画 + 15 个工具 + 20 个组件。"),
    Tip("全部基于 Web Animations API（el.animate），零依赖，浏览器原生性能。gzip 后 13.42 KB。"),
    H2("引入"),
    Code("import {\n  // 核心函数\n  anim, timeline, spring, sequence, parallel, stagger, wait, cancelAll, trans,\n  // 缓动函数\n  easings, ease,\n  // 预设（151 个）\n  fadeIn, fadeInUp, slideInUp, zoomIn, shake, bounce, pulse, flipInX,\n  // 触发工具\n  inView, onScroll, onHover, onInterval, onVisible, throttle, debounce, onDrag, onSwipe,\n  // 文本动画\n  typewriter, countUp, splitText, highlightWords,\n  // SVG / 技术\n  drawPath, followPath, maskReveal, gradientFlow, flip, tiltCard,\n  // 物理\n  springChain, inertia, particles, trail,\n  // 工具\n  queue, interruptable, prefersReducedMotion, safeAnim, scrollProgress, parallax, followMouse,\n  // 组件\n  Entrance, Transition, AnimatedList, AnimatedValue, AnimatedNumber,\n  Marquee, Typewriter, Reveal, Ripple, FlipCard, Counter, ProgressRing,\n} from 'xunay/anim'", "js"),
    H2("9 个核心函数"),
    Table(["函数","签名","说明"], [["anim","anim(el, keyframes, opts)","底层 WAAPI 封装，支持 onStart / onFinish / onCancel"],["timeline","timeline()","链式动画：.add(fn, delay).wait(ms).play()"],["spring","spring(el, opts)","弹簧物理动画（stiffness / damping / mass）"],["sequence","sequence(items)","按顺序播多个动画"],["parallel","parallel(fns)","并行动画，返回 Promise"],["stagger","stagger(els, fn, delay)","批量错开播放"],["wait","wait(ms)","Promise 延时"],["cancelAll","cancelAll(el)","取消元素所有动画"],["trans","trans(duration)","返回 enter / leave 过渡助手"]]),
    H2("40 个缓动函数"),
    P("全部在 easings 里（别名 ease）。"),
    Code("import { easings } from 'xunay/anim'\n\n// 用作 easing 参数\nfadeIn(el, { easing: easings.easeOutBack })\n\n// 全部\n// linear, ease, easeIn, easeOut, easeInOut,\n// easeInSine / easeOutSine / easeInOutSine,\n// easeInQuad / easeOutQuad / easeInOutQuad,\n// easeInCubic / easeOutCubic / easeInOutCubic,\n// easeInQuart / easeOutQuart / easeInOutQuart,\n// easeInQuint / easeOutQuint / easeInOutQuint,\n// easeInExpo / easeOutExpo / easeInOutExpo,\n// easeInCirc / easeOutCirc / easeInOutCirc,\n// easeInBack / easeOutBack / easeInOutBack,\n// easeInElastic / easeOutElastic,\n// easeInBounce / easeOutBounce / easeInOutBounce", "js"),
    H2("151 个预设动画"),
    P("全部注册在 presets 里。分组："),
    H3("淡入淡出（18 个）"),
    Code("fadeIn, fadeOut, fadeInUp, fadeInDown, fadeInLeft, fadeInRight,\nfadeOutUp, fadeOutDown, fadeOutLeft, fadeOutRight,\nfadeInTopLeft, fadeInTopRight, fadeInBottomLeft, fadeInBottomRight,\nfadeInTop, fadeInBottom, fadeInFar, fadeOutFar", "txt"),
    H3("滑动（8 个）"),
    Code("slideInUp, slideInDown, slideInLeft, slideInRight,\nslideOutUp, slideOutDown, slideOutLeft, slideOutRight", "txt"),
    H3("缩放 / 变焦（17 个）"),
    Code("scale, scaleUp, scaleDown, scaleIn, scaleOut,\nzoomIn, zoomOut, zoomInUp, zoomInDown, zoomInLeft, zoomInRight,\nzoomOutUp, zoomOutDown, zoomOutLeft, zoomOutRight,\nzoomInTop, zoomInBottom", "txt"),
    H3("旋转（22 个）"),
    Code("rotate, rotateIn, rotateOut, rotate90, rotate180,\nrotateInDownLeft, rotateInDownRight, rotateInUpLeft, rotateInUpRight,\nrotateOutDownLeft, rotateOutDownRight, rotateOutUpLeft, rotateOutUpRight,\nrotateInDown, rotateInUp,\nspin, spinSlow, spinFast, rotate3d, flip3d, cubeRotate", "txt"),
    H3("翻转（7 个）"),
    Code("flip, flipX, flipY, flipInX, flipInY, flipOutX, flipOutY", "txt"),
    H3("弹跳 / 回弹（20 个）"),
    Code("bounce, bounceIn, bounceOut, bounce2,\nbounceInUp, bounceInDown, bounceInLeft, bounceInRight,\nbounceOutUp, bounceOutDown, bounceOutLeft, bounceOutRight,\nbackInUp, backInDown, backInLeft, backInRight,\nbackOutUp, backOutDown, backOutLeft, backOutRight,\nslideBounceIn, slideInBounce", "txt"),
    H3("强调 / 注意（20 个）"),
    Code("pulse, heartbeat, ping,\nshake, shakeX, shakeY, headShake, swing, tada, wobble, jello,\nrubberBand, flash, glow, glowPulse, shimmer, shimmerText, breathe, drift,\nwiggle, float, wave, bobble, blink, fadeInfinite, rainbow, jelly, elastic", "txt"),
    H3("模糊 / 过渡（8 个）"),
    Code("blur, blurIn, blurOut, sharpen,\nmoveUp, moveDown, moveLeft, moveRight", "txt"),
    H3("3D / 特殊（16 个）"),
    Code("perspectiveIn, perspectiveOut, rotate3d, flip3d, cubeRotate,\nskewIn, skewOut, dropIn, dropOut, swingIn, popIn, popOut,\njackInTheBox, hinge,\nlightSpeedIn, lightSpeedOut, rollIn, rollOut,\nstretchIn, stretchOut, compressIn, compressOut, unfold, fold", "txt"),
    H2("15 个触发工具"),
    Table(["工具","说明"], [["inView","IntersectionObserver 封装，进入视口触发"],["onScroll","滚动触发，带节流"],["onHover","鼠标悬停触发"],["onInterval","定时循环触发"],["onVisible","页面可见性变化"],["once","只执行一次"],["throttle","节流包装"],["debounce","防抖包装"],["onMouseMove","鼠标位置触发"],["onKey","键盘按键触发"],["onResize","元素大小变化"],["onAnimationEnd","动画结束触发"],["onSwipe","触摸滑动方向"],["onDrag","拖拽"],["observeOnce","观察元素出现一次"]]),
    H2("5 个文本动画"),
    Table(["函数","说明"], [["typewriter","打字机（含光标）"],["typewriterIn / typewriterOut","逐字淡入 / 淡出"],["countUp","数字滚动"],["splitText","拆分文本（char / word / line）"],["highlightWords","逐词高亮"]]),
    H2("10 个 SVG / 技术动画"),
    Table(["函数","说明"], [["drawPath","SVG 描边绘制"],["followPath","元素沿路径移动"],["morph","形状变形"],["maskReveal / maskHide","遮罩揭示 / 隐藏"],["gradientFlow","渐变流动"],["flip","FLIP 布局动画"],["sharedElement","共享元素过渡"],["parallaxSVG","SVG 视差"],["ringProgress","圆形进度环"],["tiltCard","3D 卡片透视跟随鼠标"]]),
    H2("4 个物理动画"),
    Table(["函数","说明"], [["springChain","弹簧链"],["inertia","惯性拖拽"],["particles","粒子爆发"],["trail","拖尾"]]),
    H2("15 个工具"),
    Table(["函数","说明"], [["queue","动画队列（串行）"],["interruptable","打断管理"],["cachedAnim","关键帧缓存"],["prefersReducedMotion","检测用户偏好"],["safeAnim","兼容 reduced-motion 的动画"],["withWillChange","will-change 管理"],["compose","组合多个动画"],["once","播放一次"],["delayed","延时播放"],["retry","重试"],["scrollProgress","滚动进度映射"],["parallax","视差滚动"],["followMouse","鼠标跟随"]]),
    H2("20 个组件"),
    Table(["组件","用途"], [["Entrance","进入时播放指定动画"],["Transition","条件切换入场"],["AnimatedList","列表错开入场"],["AnimatedValue","值变化时脉冲"],["AnimatedNumber","数字滚动过渡"],["Marquee","跑马灯"],["Typewriter","打字机"],["Reveal","滚动到视口才播"],["Ripple","涟漪点击"],["FlipCard","卡片翻转"],["TypewriterText","打字机组件"],["Counter","计数滚动"],["SplitTextIn","逐字进入"],["GradientText","渐变文字"],["NeonText","发光文字"],["OutlineText","描边文字"],["Marker","高亮标记"],["LazyImage","图片懒加载淡入"],["ProgressRing","进度环"]]),
    H2("完整示例"),
    Code("// app.xuy\nimport { div, button, signal, mount } from 'xunay'\nimport {\n  Entrance, AnimatedList, Reveal, Counter,\n  Ripple, ProgressRing,\n  fadeInUp, shake,\n  inView, onScroll, parallax\n} from 'xunay/anim'\n\nconst items = signal(['A', 'B', 'C'])\nconst n = signal(42)\n\nmount(() => div(null,\n  Entrance({ type: 'fadeInUp' },\n    div(null, '淡入上滑')\n  ),\n\n  Reveal({ type: 'zoomIn' },\n    div(null, '滚动到视口才播')\n  ),\n\n  Counter({ value: () => n(), duration: 800 }),\n\n  Ripple(null,\n    button({ on: { click: () => shake(button) } }, '点我抖动')\n  ),\n\n  AnimatedList({\n    items: items(),\n    keyFn: i => i,\n    render: i => div(null, i),\n  }),\n\n  ProgressRing({ value: 75, size: 100 })\n), '#app')", "xuy"),
    Tip("所有动画都支持 prefersReducedMotion——用户系统开了「减少动画」会自动降级。"),
  )
}
