// kit: Table
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("kit: Table"),
    P("kit 里的 Table 组件。"),
    H2("引入"),
    Code("import { Table } from 'xunay/kit/data'", "js"),
    H2("参数"),
    Table(["参数","类型","默认","说明"], [["columns","——","——",""],["data","——","——",""],["empty","——","——",""],["keyFn","——","——",""],["wrap","——","——",""]]),
    H2("移动端"),
    P("横向滚动容器。"),
    H2("基础用法"),
    Code("import { Table } from 'xunay/kit/data'\n\nTable({ /* see table above */ })", "js"),
    Tip("完整组件清单见「Kit 组件 → Kit 组件 API」。"),
  )
}
