// effect
import { D, H1, H2, H3, P, Code, Ul, Ol, Quote, Tip, Warn, Danger, Table, Link } from '../docs-kit.xuy'

export function Doc() {
  return D(
    H1("effect"),
    P("effect 是\"会自动重跑的副作用\"——它执行时读到的 signal 都会成为依赖，那些 signal 变化时，effect 自动重跑。"),
    H2("和 signal 的关系"),
    P("signal 负责\"变\"，effect 负责\"跑\"。当你在 effect 里读一个 signal，就等于订阅了它。它变了，effect 就重跑。"),
    Code("import { signal, effect } from 'xunay'\n\nconst n = signal(0)\n\neffect(() => {\n  console.log('n =', n())   // 读了 n，订阅它\n})\n// 立即执行一次 → 打印 n = 0\n\nn(1)\n// n 变 → effect 重跑 → 打印 n = 1", "xuy"),
    H2("自动依赖收集"),
    P("不需要写依赖数组。effect 执行时哪个 signal 被读了，就自动订阅哪个。下次重跑时依赖会重新收集——旧的依赖会被清掉，新的加上。"),
    Code("const useA = signal(true)\nconst a = signal(1)\nconst b = signal(2)\n\neffect(() => {\n  if (useA()) console.log('a =', a())\n  else console.log('b =', b())\n})\n// 执行一次，依赖 = [useA, a]\n\nb(10)      // 不触发，因为 b 没被读\nuseA(false)\n// 重跑，依赖变成 [useA, b]\na(5)       // 不触发，因为 a 不再被读\nb(20)      // 触发", "xuy"),
    H2("清理副作用"),
    P("effect 里用 onCleanup(fn) 注册清理——它会在下次重跑前、或 effect dispose 时执行。适合清理定时器、事件监听、订阅。"),
    Tip("注意：effect 不接收返回的清理函数，必须用 onCleanup。"),
    Code("import { signal, effect, onCleanup } from 'xunay'\n\nconst interval = signal(1000)\n\neffect(() => {\n  const id = setInterval(() => console.log('tick'), interval())\n  onCleanup(() => clearInterval(id))   // 下次重跑前清理旧的\n})\n\ninterval(500)\n// 旧定时器被清理，新定时器 500ms\n\n// dispose 时也会清理\nconst stop = effect(() => { ... })\nstop()   // 触发清理", "xuy"),
    H2("与组件生命周期"),
    P("每个 effect 属于某个 scope（作用域）。DOM 节点挂载时创建 scope，卸载时自动 dispose 所有子 effect。所以大部分情况下不用手动清理。"),
    Code("import { div, effect, onUnmount } from 'xunay'\n\nfunction Timer() {\n  const n = signal(0)\n  // effect 属于这个组件的 scope\n  effect(() => {\n    const id = setInterval(() => n(v => v + 1), 1000)\n    onCleanup(() => clearInterval(id))\n  })\n  return div(null, () => '秒数: ' + n())\n  // 组件卸载时，effect 自动清理\n}", "xuy"),
    H2("什么时候用 effect"),
    Table(["场景","该用什么"], [["计算派生值","computed，不是 effect"],["同步到 localStorage","effect"],["订阅外部事件","effect"],["启动定时器","effect"],["打日志","effect"],["发请求","onMount 或 async 回调"]]),
    H2("effect vs React useEffect"),
    Table(["","XuNay effect","React useEffect"], [["依赖数组","无，自动","必须有"],["空依赖","不写就行","[]"],["首次执行","默认执行","默认执行"],["清理","onCleanup(fn)","return 函数"],["清理时机","重跑前 + dispose","重跑前 + 卸载"]]),
    H2("常见陷阱"),
    H3("陷阱 1：在 effect 里读又写同一个 signal"),
    Code("const n = signal(0)\neffect(() => {\n  console.log(n())\n  n(n() + 1)   // ✗ 死循环\n})", "xuy"),
    P("写操作触发重跑，重跑又写——永远停不下来。如果确实需要更新，用 setTimeout 或放在事件回调里。"),
    H3("陷阱 2：忘记读就以为订阅了"),
    Code("const n = signal(0)\neffect(() => {\n  // 没有读 n，不订阅\n  setTimeout(() => console.log(n()), 100)\n})\nn(1)   // 不会触发 effect", "xuy"),
    P("只有 effect 的同步执行阶段读的 signal 才订阅。异步回调里读不算（因为 effect 已经执行完了）。"),
    H3("陷阱 3：在 effect 里访问 DOM 但 DOM 还没挂载"),
    P("effect 在 mount 之前就跑了，此时 DOM 不在文档里。要访问 DOM 用 onMount。"),
    Code("effect(() => {\n  document.querySelector('.x')   // ✗ 可能 null\n})\nonMount(() => {\n  document.querySelector('.x')   // ✓ 挂载完再跑\n})", "xuy"),
    H2("性能"),
    P("effect 的重跑有成本——每次都要清理旧依赖、收集新依赖、执行函数体。如果依赖很多，成本线性增加。"),
    P("一条经验：一个 effect 里读的 signal 不要超过 10 个。超过就要考虑拆分——大 effect 拆成几个小 effect，各自只管一件事。"),
    H2("手动停止"),
    Code("const stop = effect(() => {\n  console.log('running')\n})\n\n// 停止\nstop()\n// 之后的 signal 变化不再触发", "xuy"),
    P("组件 scope 会自动 dispose 内部的 effect。只有顶层 effect（不在组件里）需要手动 stop。"),
    H2("完整示例：自动保存草稿"),
    Code("import { signal, effect, onCleanup, div, textarea, span, mount } from 'xunay'\n\nfunction Editor() {\n  // 从 localStorage 恢复\n  const draft = signal(localStorage.getItem('draft') || '')\n  const saved = signal('')\n\n  // 每次 draft 变，延迟 500ms 保存\n  effect(() => {\n    const text = draft()\n    const id = setTimeout(() => {\n      localStorage.setItem('draft', text)\n      saved(new Date().toLocaleTimeString())\n    }, 500)\n    onCleanup(() => clearTimeout(id))\n  })\n\n  return div(null,\n    textarea({\n      value: () => draft(),\n      on: { input: e => draft(e.target.value) }\n    }),\n    span(null, () => saved() ? '已保存于 ' + saved() : '未保存')\n  )\n}\n\nmount(() => Editor(), '#app')", "xuy"),
    H2("下一步"),
    P("读 batch 了解如何把多次 signal 写合并成一次更新。"),
  )
}
