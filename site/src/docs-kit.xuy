// docs-kit: 文档构建块
import { div, span, button, h1, h2, h3, p, ul, ol, li, pre, code, blockquote, table, thead, tbody, tr, th, td, a, signal } from 'xunay'
import { highlight } from '../../core/src/hl.js'

export function D(...children) {
  return div({ class: 'doc' }, ...children)
}
export function H1(text) { return h1(null, text) }
export function H2(text) { return h2(null, text) }
export function H3(text) { return h3(null, text) }
export function P(text) { return p(null, text) }

export function Code(text, lang) {
  const L = lang || 'js'
  const copied = signal(false)
  const copy = () => {
    const doCopy = t => {
      if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(t)
      return new Promise((res, rej) => {
        const ta = document.createElement('textarea')
        ta.value = t; ta.style.position = 'fixed'; ta.style.left = '-9999px'
        document.body.appendChild(ta); ta.select()
        document.execCommand('copy') ? res() : rej()
        document.body.removeChild(ta)
      })
    }
    doCopy(text).then(() => { copied(true); setTimeout(() => copied(false), 1500) }).catch(() => {})
  }
  return div({ class: 'code-block' },
    div({ class: 'code-head' },
      span({ class: 'code-lang' }, L.toUpperCase()),
      button({ class: () => 'code-copy' + (copied() ? ' on' : ''), on: { click: copy } },
        () => copied() ? '已复制' : '复制')
    ),
    pre({ class: 'code-pre' }, code({ html: highlight(text, L) }))
  )
}

export function Ul(...items) { return ul(null, ...items.map(i => li(null, i))) }
export function Ol(...items) { return ol(null, ...items.map(i => li(null, i))) }
export function Quote(text) { return blockquote({ class: 'callout note' }, text) }
export function Tip(text) { return blockquote({ class: 'callout tip' }, text) }
export function Warn(text) { return blockquote({ class: 'callout warn' }, text) }
export function Danger(text) { return blockquote({ class: 'callout danger' }, text) }
export function Table(headers, rows) {
  return table({ class: 'doc-table' },
    thead(null, tr(null, ...headers.map(h => th(null, h)))),
    tbody(null, ...rows.map(r => tr(null, ...r.map(c => td(null, c)))))
  )
}
export function Link(href, text) { return a({ href, class: 'doc-link' }, text) }


// ===== 新增组件 =====

export function Badge(text, kind) {
  return span({ class: 'doc-badge doc-badge-' + (kind || 'default') }, text)
}

export function Kbd(text) {
  return span({ class: 'doc-kbd' }, text)
}

export function Card(href, title, desc) {
  return a({ href, class: 'doc-card' },
    div({ class: 'doc-card-title' }, title),
    desc ? div({ class: 'doc-card-desc' }, desc) : null
  )
}

export function Grid(cols, ...children) {
  return div({ class: 'doc-grid', style: () => 'grid-template-columns: repeat(' + (cols || 2) + ', 1fr)' }, ...children)
}

export function Steps(...items) {
  return div({ class: 'doc-steps' },
    ...items.map((it, i) =>
      div({ class: 'doc-step' },
        div({ class: 'doc-step-num' }, String(i + 1)),
        div({ class: 'doc-step-body' }, it)
      )
    )
  )
}

export function FileTree(text) {
  return pre({ class: 'doc-filetree' }, text)
}

export function Props(rows) {
  return Table(['属性', '类型', '默认', '说明'], rows)
}

export function Note(text) { return blockquote({ class: 'callout note' }, text) }
export function Success(text) { return blockquote({ class: 'callout success' }, text) }

export function HR() { return hr({ class: 'doc-hr' }) }

export function Anchor(id, ...children) {
  return div({ id, class: 'doc-anchor' }, ...children)
}

export function Tabs(items) {
  const active = signal(0)
  return div({ class: 'doc-tabs' },
    div({ class: 'doc-tabs-head' },
      ...items.map((it, i) =>
        button({
          class: () => 'doc-tab' + (active() === i ? ' on' : ''),
          on: { click: () => active(i) }
        }, it.label)
      )
    ),
    div({ class: 'doc-tabs-body' },
      () => items[active()].content
    )
  )
}

export function Collapse(title, ...children) {
  const open = signal(false)
  return div({ class: 'doc-collapse' },
    div({
      class: () => 'doc-collapse-head' + (open() ? ' on' : ''),
      on: { click: () => open(!open()) }
    }, span({ class: 'doc-collapse-arrow' }, () => open() ? '\u25be' : '\u25b8'), ' ', title),
    () => open() ? div({ class: 'doc-collapse-body' }, ...children) : null
  )
}

export function Img(src, alt) {
  return div({ class: 'doc-img-wrap' },
    img({ src, alt: alt || '' }),
    alt ? span({ class: 'doc-img-cap' }, alt) : null
  )
}

export function Demo(code, lang) {
  return div({ class: 'doc-demo' },
    div({ class: 'doc-demo-head' }, 'DEMO'),
    Code(code, lang)
  )
}

